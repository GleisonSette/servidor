[Unit]
Description=Coleta de saúde do PostgreSQL exclusivo do SaferWPP
After=postgresql@18-saferwpp_lab.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/saferwpp/postgres/pgbackrest.env
ExecStart=/usr/local/sbin/saferwpp-postgres-metrics
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/prometheus/node-exporter /run/lock
UMask=0027
