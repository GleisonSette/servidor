Defaults!/usr/local/sbin/secondary-slotctl env_reset
Cmnd_Alias SECONDARY_SLOT_READ = /usr/local/sbin/secondary-slotctl status, /usr/local/sbin/secondary-slotctl verify, /usr/local/sbin/secondary-slotctl metrics
Cmnd_Alias SECONDARY_SLOT_INITIALIZE = /usr/local/sbin/secondary-slotctl initialize-apiwpp-active * secondary-slot-initialize-apiwpp-active
Cmnd_Alias SECONDARY_SLOT_SUSPEND = /usr/local/sbin/secondary-slotctl begin-suspend apiwpp * secondary-slot-begin-suspend, /usr/local/sbin/secondary-slotctl complete-suspend apiwpp * secondary-slot-complete-suspend, /usr/local/sbin/secondary-slotctl begin-suspend saferwpp * secondary-slot-begin-suspend, /usr/local/sbin/secondary-slotctl complete-suspend saferwpp * secondary-slot-complete-suspend
Cmnd_Alias SECONDARY_SLOT_ACTIVATE = /usr/local/sbin/secondary-slotctl reserve apiwpp * secondary-slot-reserve, /usr/local/sbin/secondary-slotctl complete-activation apiwpp * secondary-slot-complete-activation, /usr/local/sbin/secondary-slotctl reserve saferwpp * secondary-slot-reserve, /usr/local/sbin/secondary-slotctl complete-activation saferwpp * secondary-slot-complete-activation
Cmnd_Alias SECONDARY_SLOT_RECOVERY = /usr/local/sbin/secondary-slotctl abort-transition apiwpp * secondary-slot-abort-transition, /usr/local/sbin/secondary-slotctl abort-transition saferwpp * secondary-slot-abort-transition, /usr/local/sbin/secondary-slotctl reconcile * secondary-slot-reconcile
apiadmin ALL=(root) NOPASSWD: SECONDARY_SLOT_READ, SECONDARY_SLOT_INITIALIZE, SECONDARY_SLOT_SUSPEND, SECONDARY_SLOT_ACTIVATE, SECONDARY_SLOT_RECOVERY
