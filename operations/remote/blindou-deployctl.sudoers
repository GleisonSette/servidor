Defaults!/usr/local/sbin/blindou-deployctl env_reset
Defaults!/usr/local/sbin/blindou-release-emergencyctl env_reset
Cmnd_Alias BLINDOU_DEPLOY_READ = /usr/local/sbin/blindou-deployctl status, /usr/local/sbin/blindou-deployctl verify-foundation, /usr/local/sbin/blindou-deployctl verify-edge-connector, /usr/local/sbin/blindou-deployctl verify-cloudflare-saas-token, /usr/local/sbin/blindou-deployctl verify-ghcr-pull-credential, /usr/local/sbin/blindou-deployctl verify-r2-runtime-credential, /usr/local/sbin/blindou-deployctl verify-ghcr-candidate-pull *, /usr/local/sbin/blindou-deployctl verify-data, /usr/local/sbin/blindou-deployctl verify-backup, /usr/local/sbin/blindou-deployctl export-latest-backup
Cmnd_Alias BLINDOU_DEPLOY_FOUNDATION = /usr/local/sbin/blindou-deployctl apply-foundation blindou-platform-foundation, /usr/local/sbin/blindou-deployctl provision-edge-connector blindou-edge-connector, /usr/local/sbin/blindou-deployctl provision-cloudflare-saas-token blindou-cloudflare-saas-token, /usr/local/sbin/blindou-deployctl provision-ghcr-pull-credential blindou-ghcr-pull-credential, /usr/local/sbin/blindou-deployctl provision-r2-runtime-credential blindou-r2-runtime-credential, /usr/local/sbin/blindou-deployctl provision-data blindou-data-foundation, /usr/local/sbin/blindou-deployctl backup-database blindou-database-backup, /usr/local/sbin/blindou-deployctl provision-runtime-secrets blindou-runtime-secrets, /usr/local/sbin/blindou-deployctl provision-ui-review-runtime blindou-ui-review-runtime, /usr/local/sbin/blindou-deployctl confirm-alert-delivery blindou-alert-delivered, /usr/local/sbin/blindou-deployctl confirm-offsite-backup * * blindou-offsite-backup
Cmnd_Alias BLINDOU_DEPLOY_DESTRUCTIVE = /usr/local/sbin/blindou-deployctl rollback-edge-connector blindou-edge-connector, /usr/local/sbin/blindou-deployctl rollback-cloudflare-saas-token blindou-cloudflare-saas-token, /usr/local/sbin/blindou-deployctl rollback-ghcr-pull-credential blindou-ghcr-pull-credential
Cmnd_Alias BLINDOU_SIGNED_RELEASE = /usr/local/sbin/blindou-deployctl validate-release *, /usr/local/sbin/blindou-deployctl activate-release-gates * blindou-release-gates, /usr/local/sbin/blindou-deployctl apply *, /usr/local/sbin/blindou-deployctl bootstrap-superadmin * blindou-bootstrap-superadmin
apiadmin ALL=(root) NOPASSWD: BLINDOU_DEPLOY_READ, BLINDOU_DEPLOY_FOUNDATION, BLINDOU_SIGNED_RELEASE
apiadmin ALL=(root) NOPASSWD: /usr/local/sbin/blindou-release-emergencyctl contain-stuck-first-release * blindou-stuck-first-release
apiadmin ALL=(root) BLINDOU_DEPLOY_DESTRUCTIVE
