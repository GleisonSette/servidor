  grep -Fxq 'schema=1' "$MARKETPLACES_RUNTIME_RECEIPT" \
    && grep -Fxq 'feature=shopee-open-api' "$MARKETPLACES_RUNTIME_RECEIPT" \
    && grep -Fxq 'state=ready-for-tenant-credentials' "$MARKETPLACES_RUNTIME_RECEIPT" \
    && grep -Eq '^release_id=[0-9a-f]{40}$' "$MARKETPLACES_RUNTIME_RECEIPT" \
    && grep -Eq '^activated_at_utc=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
      "$MARKETPLACES_RUNTIME_RECEIPT"
}

verify_pagarme_credential() {
  require_platform_preconditions
  pagarme_credential_files_are_secure \
    || fail 'credencial Pagar.me ausente, insegura ou fora do formato live esperado'
  local secret_key
  IFS= read -r secret_key <"$PAGARME_SECRET_KEY_FILE" \
    || fail 'chave Pagar.me não pôde ser lida do cofre'
  if ! pagarme_live_probe "$secret_key"; then
    unset secret_key
    fail 'Pagar.me recusou a validação autenticada da chave live'
  fi
  unset secret_key
  record_pagarme_verification
  pass 'credencial Pagar.me live validada e preservada no cofre root-only'
}

provision_pagarme_credential() {
  [[ "${1:-}" == "$PAGARME_CREDENTIAL_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${PAGARME_CREDENTIAL_CONFIRMATION}"
  [[ ! -t 0 ]] || fail 'credenciais Pagar.me devem chegar por stdin não interativo'
  require_platform_preconditions
  [[ -f "$CURRENT_RELEASE" && ! -L "$CURRENT_RELEASE" \
      && "$(stat -c '%U:%G:%a' "$CURRENT_RELEASE")" == 'root:root:600' \
      && "$(<"$CURRENT_RELEASE")" =~ $RELEASE_PATTERN ]] \
    || fail 'release corrente segura é obrigatória antes do cofre Pagar.me'
  [[ "$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' \
      && "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' ]] \
    || fail 'credencial Pagar.me só pode ser provisionada com aplicação e EDGE em passed'
  grep -Fxq 'INITIAL_UI_REVIEW_MODE=true' "$RUNTIME_CONFIG_FILE" \
    || fail 'provisionamento inicial Pagar.me exige o runtime ainda em revisão fechada'
  grep -Fxq 'UAZAPI_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
    || fail 'UAZAPI deve permanecer desabilitada durante o provisionamento Pagar.me'
  grep -Fxq 'EMAIL_PROVIDER=disabled' "$RUNTIME_CONFIG_FILE" \
    || fail 'Resend deve permanecer desabilitado durante o provisionamento Pagar.me'
  local core_keys
  core_keys="$(kube -n "$APP_NAMESPACE" get secret blindou-core-secrets \
    -o go-template='{{range $key, $value := .data}}{{printf "%s\n" $key}}{{end}}')"
  for forbidden_key in PAGARME_SECRET_KEY PAGARME_WEBHOOK_SECRET; do
    ! grep -Fxq "$forbidden_key" <<<"$core_keys" \
      || fail "${forbidden_key} já apareceu no Kubernetes antes da ativação compatível"
  done

  local schema secret_key_b64 webhook_secret_b64 secret_key webhook_secret
  local existing_secret_key existing_webhook_secret
  local temporary_secret_dir
  IFS= read -r schema || fail 'payload Pagar.me ausente'
  IFS= read -r secret_key_b64 || fail 'PAGARME_SECRET_KEY ausente'
  IFS= read -r webhook_secret_b64 || fail 'PAGARME_WEBHOOK_SECRET ausente'
  [[ "$schema" == 'schema=1' ]] || fail 'schema do payload Pagar.me inválido'
  [[ "$secret_key_b64" =~ ^[A-Za-z0-9+/=]{32,1024}$ \
      && "$webhook_secret_b64" =~ ^[A-Za-z0-9+/=]{60,512}$ ]] \
    || fail 'payload base64 Pagar.me inválido'
  secret_key="$(printf '%s' "$secret_key_b64" | base64 -d)" \
    || fail 'PAGARME_SECRET_KEY inválida'
  webhook_secret="$(printf '%s' "$webhook_secret_b64" | base64 -d)" \
    || { unset secret_key; fail 'PAGARME_WEBHOOK_SECRET inválido'; }
  unset secret_key_b64 webhook_secret_b64
  pagarme_secret_key_format_is_valid "$secret_key" \
    || { unset secret_key webhook_secret; fail 'PAGARME_SECRET_KEY não é uma chave live válida'; }
  pagarme_webhook_secret_format_is_valid "$webhook_secret" \
    || { unset secret_key webhook_secret; fail 'PAGARME_WEBHOOK_SECRET deve ser URL-safe e ter ao menos 43 caracteres'; }
  pagarme_live_probe "$secret_key" \
    || { unset secret_key webhook_secret; fail 'Pagar.me recusou a chave live informada'; }

  if [[ -e "$PAGARME_SECRET_KEY_FILE" || -L "$PAGARME_SECRET_KEY_FILE" \
      || -e "$PAGARME_WEBHOOK_SECRET_FILE" || -L "$PAGARME_WEBHOOK_SECRET_FILE" ]]; then
    pagarme_credential_files_are_secure \
      || { unset secret_key webhook_secret; fail 'credencial Pagar.me existente está incompleta ou insegura'; }
    IFS= read -r existing_secret_key <"$PAGARME_SECRET_KEY_FILE"
    IFS= read -r existing_webhook_secret <"$PAGARME_WEBHOOK_SECRET_FILE"
    [[ "$existing_secret_key" == "$secret_key" \
        && "$existing_webhook_secret" == "$webhook_secret" ]] \
      || { unset secret_key webhook_secret existing_secret_key existing_webhook_secret; fail 'uma credencial Pagar.me diferente já está provisionada'; }
    unset secret_key webhook_secret existing_secret_key existing_webhook_secret
    record_pagarme_verification
    pass 'credencial Pagar.me já estava provisionada e foi revalidada'
    return
  fi

  temporary_secret_dir="$(mktemp -d "${PAGARME_SECRET_DIR}.tmp.XXXXXX")"
  cleanup_paths+=("$temporary_secret_dir")
  install -d -o root -g root -m 0700 "$temporary_secret_dir"
  printf '%s\n' "$secret_key" >"${temporary_secret_dir}/secret-key"
  printf '%s\n' "$webhook_secret" >"${temporary_secret_dir}/webhook-secret"
  chown root:root "${temporary_secret_dir}/secret-key" \
    "${temporary_secret_dir}/webhook-secret"
  chmod 0600 "${temporary_secret_dir}/secret-key" \
    "${temporary_secret_dir}/webhook-secret"
  unset secret_key webhook_secret
  mv -- "$temporary_secret_dir" "$PAGARME_SECRET_DIR"
  record_pagarme_verification
  pass 'credencial Pagar.me validada e guardada fora do Kubernetes; runtime não foi alterado'
}

rotate_pagarme_webhook_secret() {
  [[ "${1:-}" == "$PAGARME_WEBHOOK_ROTATION_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${PAGARME_WEBHOOK_ROTATION_CONFIRMATION}"
  [[ ! -t 0 ]] || fail 'novo segredo do webhook Pagar.me deve chegar por stdin não interativo'
  require_platform_preconditions
  pagarme_credential_files_are_secure \
    || fail 'credencial Pagar.me existente está ausente ou insegura'
  [[ ! -f "$PAGARME_RUNTIME_RECEIPT" ]] \
    || fail 'rotação pré-ativação recusada porque o runtime Pagar.me já foi ativado'
  grep -Fxq 'INITIAL_UI_REVIEW_MODE=true' "$RUNTIME_CONFIG_FILE" \
    || fail 'rotação pré-ativação exige o runtime ainda em revisão fechada'
  local core_keys
  core_keys="$(kube -n "$APP_NAMESPACE" get secret blindou-core-secrets \
    -o go-template='{{range $key, $value := .data}}{{printf "%s\n" $key}}{{end}}')"
  for forbidden_key in PAGARME_SECRET_KEY PAGARME_WEBHOOK_SECRET; do
    ! grep -Fxq "$forbidden_key" <<<"$core_keys" \
      || fail "${forbidden_key} apareceu no Kubernetes antes da rotação pré-ativação"
  done

  local schema webhook_secret_b64 webhook_secret existing_webhook_secret secret_key
  local temporary_webhook_file
  IFS= read -r schema || fail 'payload da rotação Pagar.me ausente'
  IFS= read -r webhook_secret_b64 || fail 'novo PAGARME_WEBHOOK_SECRET ausente'
  [[ "$schema" == 'schema=1' \
      && "$webhook_secret_b64" =~ ^[A-Za-z0-9+/=]{60,512}$ ]] \
    || fail 'payload base64 da rotação Pagar.me inválido'
  webhook_secret="$(printf '%s' "$webhook_secret_b64" | base64 -d)" \
    || fail 'novo PAGARME_WEBHOOK_SECRET inválido'
  unset webhook_secret_b64
  pagarme_webhook_secret_format_is_valid "$webhook_secret" \
    || { unset webhook_secret; fail 'novo PAGARME_WEBHOOK_SECRET deve ser URL-safe e ter ao menos 43 caracteres'; }
  IFS= read -r existing_webhook_secret <"$PAGARME_WEBHOOK_SECRET_FILE"
  [[ "$webhook_secret" != "$existing_webhook_secret" ]] \
    || { unset webhook_secret existing_webhook_secret; fail 'rotação recebeu o segredo Pagar.me já vigente'; }
  unset existing_webhook_secret
  IFS= read -r secret_key <"$PAGARME_SECRET_KEY_FILE"
  if ! pagarme_live_probe "$secret_key"; then
    unset secret_key webhook_secret
    fail 'Pagar.me recusou a secret key já guardada durante a rotação do webhook'
  fi
  unset secret_key

  temporary_webhook_file="$(mktemp "${PAGARME_WEBHOOK_SECRET_FILE}.tmp.XXXXXX")"
  cleanup_paths+=("$temporary_webhook_file")
  printf '%s\n' "$webhook_secret" >"$temporary_webhook_file"
  unset webhook_secret
  chown root:root "$temporary_webhook_file"
  chmod 0600 "$temporary_webhook_file"
  mv -- "$temporary_webhook_file" "$PAGARME_WEBHOOK_SECRET_FILE"
  record_pagarme_verification
  pass 'segredo do webhook Pagar.me rotacionado no cofre; secret key e runtime não foram alterados'
}

pagarme_plan_provisioner_is_secure() {
  [[ -f "$PAGARME_PLAN_PROVISIONER" \
      && ! -L "$PAGARME_PLAN_PROVISIONER" \
      && "$(stat -c '%U:%G:%a' "$PAGARME_PLAN_PROVISIONER" 2>/dev/null)" == 'root:root:755' ]]
