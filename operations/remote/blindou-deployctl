  {
    printf 'MIGRATION_DATABASE_URL=postgresql://blindou_migration_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_MIGRATION_PASSWORD" "$query_suffix"
    printf 'DATABASE_URL=postgresql://blindou_runtime_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_RUNTIME_PASSWORD" "$query_suffix"
    printf 'REDIRECTOR_DATABASE_URL=postgresql://blindou_redirect_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_REDIRECT_PASSWORD" "$query_suffix"
    printf 'ML_CONNECTOR_DATABASE_URL=postgresql://blindou_ml_login:%s@192.168.100.59:5432/blindou?%s\n' \
