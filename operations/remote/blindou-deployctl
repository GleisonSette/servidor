}

kube() {
  k3s kubectl "$@"
}

postgres_query() {
  runuser -u postgres -- psql -X --no-psqlrc --set=ON_ERROR_STOP=1 "$@"
}

require_root_and_host() {
  [[ "${EUID}" -eq 0 ]] || fail 'execute pelo sudo restrito do controlador'
  [[ "$(hostname)" == "$EXPECTED_HOSTNAME" ]] || fail 'hostname inesperado'
  systemctl is-active --quiet k3s.service || fail 'K3s não está ativo'
  systemctl is-active --quiet postgresql@18-main.service \
    || fail 'PostgreSQL 18/main não está ativo'
}

require_platform_preconditions() {
  require_root_and_host
  /usr/local/sbin/blindou-hostctl verify >/dev/null \
    || fail 'contenção temporária do host não passou'
  /usr/local/sbin/apiwpp-deployctl verify >/dev/null \
    || fail 'apiwpp não passou no gate de preservação'
  [[ -d "$FOUNDATION_DIR" && ! -L "$FOUNDATION_DIR" ]] \
    || fail 'bundle root-owned da fundação está ausente'
}

namespace_exists() {
  kube get namespace "$1" >/dev/null 2>&1
}

namespace_label() {
  kube get namespace "$1" -o "jsonpath={.metadata.labels.$2}"
}

namespace_object_count() {
  local namespace="$1"
  kube -n "$namespace" get \
    deployment,statefulset,daemonset,job,cronjob,pod,service,secret,pvc \
    -o json | jq '[.items[]] | length'
}

assert_namespace_labels() {
  local namespace="$1" role="$2" expected_gate="$3"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/managed')" == 'true' ]] \
    || fail "namespace ${namespace} não é gerenciado pela plataforma"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/project')" == 'blindou' ]] \
    || fail "namespace ${namespace} pertence a projeto inesperado"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/environment')" == 'production' ]] \
    || fail "namespace ${namespace} não está marcado como produção"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/role')" == "$role" ]] \
    || fail "papel do namespace ${namespace} diverge"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/deployment-gate')" == "$expected_gate" ]] \
    || fail "gate do namespace ${namespace} diverge de ${expected_gate}"
  [[ "$(namespace_label "$namespace" 'pod-security\.kubernetes\.io/enforce')" == 'restricted' ]] \
    || fail "Pod Security não está restricted em ${namespace}"
  [[ "$(namespace_label "$namespace" 'pod-security\.kubernetes\.io/enforce-version')" == 'v1.36' ]] \
    || fail "versão de Pod Security diverge em ${namespace}"
}

assert_quarantine_namespace() {
  local namespace="$1"
  [[ "$(namespace_object_count "$namespace")" == '0' ]] \
    || fail "namespace ${namespace} contém workload, Service, Secret ou PVC"
  [[ "$(kube -n "$namespace" get serviceaccount default \
    -o jsonpath='{.automountServiceAccountToken}')" == 'false' ]] \
    || fail "ServiceAccount default permite token em ${namespace}"
  [[ "$(kube -n "$namespace" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.pods}')" == '0' ]] \
    || fail "quota de quarentena não bloqueia Pods em ${namespace}"
  [[ "$(kube -n "$namespace" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.services}')" == '0' ]] \
    || fail "quota de quarentena não bloqueia Services em ${namespace}"
  [[ "$(kube -n "$namespace" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.secrets}')" == '0' ]] \
    || fail "quota de quarentena não bloqueia Secrets em ${namespace}"
  kube -n "$namespace" get limitrange platform-quarantine-defaults >/dev/null \
    || fail "LimitRange ausente em ${namespace}"
  kube -n "$namespace" get networkpolicy platform-default-deny >/dev/null \
    || fail "default deny ausente em ${namespace}"
  kube -n "$namespace" get networkpolicy platform-allow-cluster-dns >/dev/null \
    || fail "política DNS ausente em ${namespace}"
}

assert_edge_connector() {
  [[ "$(kube -n "$EDGE_NAMESPACE" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.pods}')" == '1' ]] \
    || fail 'edge quota must limit Pods to one'
  [[ "$(kube -n "$EDGE_NAMESPACE" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.services}')" == '0' ]] \
    || fail 'edge quota must keep Services blocked'
  [[ "$(kube -n "$EDGE_NAMESPACE" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.secrets}')" == '1' ]] \
    || fail 'edge quota must limit Secrets to one'
  [[ "$(kube -n "$EDGE_NAMESPACE" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.persistentvolumeclaims}')" == '0' ]] \
    || fail 'edge quota must keep PVCs blocked'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment -o json | jq \
    '[.items[].metadata.name] | sort == ["blindou-cloudflared"]')" == 'true' ]] \
    || fail 'unexpected Deployment in edge namespace'
  [[ "$(kube -n "$EDGE_NAMESPACE" get statefulset,daemonset,job,cronjob,service,pvc \
    -o json | jq '[.items[]] | length')" == '0' ]] \
    || fail 'forbidden object in edge namespace'
  [[ "$(kube -n "$EDGE_NAMESPACE" get pod \
    -l app.kubernetes.io/name=blindou-cloudflared -o json | jq '[.items[]] | length')" == '1' ]] \
    || fail 'cloudflared Pod count must be one'
  [[ "$(kube -n "$EDGE_NAMESPACE" get secret -o json | jq \
    '[.items[].metadata.name] | sort == ["blindou-cloudflare-tunnel"]')" == 'true' ]] \
    || fail 'unexpected Secret in edge namespace'
  secret_has_keys "$EDGE_NAMESPACE" blindou-cloudflare-tunnel token
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment blindou-cloudflared \
    -o jsonpath='{.spec.template.spec.containers[0].image}')" == "$EDGE_CONNECTOR_IMAGE" ]] \
    || fail 'immutable cloudflared image diverges'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment blindou-cloudflared \
    -o jsonpath='{.spec.template.spec.automountServiceAccountToken}')" == 'false' ]] \
    || fail 'cloudflared ServiceAccount token is enabled'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment blindou-cloudflared \
    -o jsonpath='{.status.availableReplicas}')" == '1' ]] \
    || fail 'cloudflared has no available replica'
  kube -n "$EDGE_NAMESPACE" get networkpolicy allow-cloudflared-edge >/dev/null \
    || fail 'cloudflared NetworkPolicy is absent'
}

negative_admission_tests() {
  local app_gate
  app_gate="$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')"
  if [[ "$app_gate" != passed ]] && cat <<EOF | kube apply --dry-run=server -f - >/dev/null 2>&1
apiVersion: v1
kind: Pod
metadata:
  name: blindou-negative-pod
  namespace: ${APP_NAMESPACE}
spec:
  automountServiceAccountToken: false
  containers:
    - name: negative
      image: docker.io/library/busybox:latest
      command: ["sh", "-c", "exit 0"]
      resources:
        requests: {cpu: 1m, memory: 1Mi}
        limits: {cpu: 1m, memory: 1Mi}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: ["ALL"]}
EOF
  then
    fail 'admissão aceitou Pod enquanto o gate está bloqueado'
  fi
  if cat <<EOF | kube apply --dry-run=server -f - >/dev/null 2>&1
apiVersion: v1
kind: Service
metadata:
  name: blindou-negative-nodeport
  namespace: ${APP_NAMESPACE}
spec:
  type: NodePort
  selector: {app: negative}
  ports:
    - port: 8080
      targetPort: 8080
EOF
  then
    fail 'admissão aceitou Service NodePort no Blindou'
  fi
}

verify_foundation() {
  require_platform_preconditions
  local app_gate edge_gate
  namespace_exists "$APP_NAMESPACE" || fail "namespace ${APP_NAMESPACE} ausente"
  namespace_exists "$EDGE_NAMESPACE" || fail "namespace ${EDGE_NAMESPACE} ausente"
  app_gate="$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')"
  case "$app_gate" in
    blocked)
      assert_namespace_labels "$APP_NAMESPACE" application blocked
      assert_quarantine_namespace "$APP_NAMESPACE"
      ;;
    secrets-only)
      assert_namespace_labels "$APP_NAMESPACE" application secrets-only
      ! kube -n "$APP_NAMESPACE" get resourcequota platform-quarantine >/dev/null 2>&1 \
        || fail 'quota de quarentena ainda existe durante secrets-only'
      [[ "$(kube -n "$APP_NAMESPACE" get deployment,statefulset,daemonset,job,cronjob,pod,service \
        -o json | jq '[.items[]] | length')" == '0' ]] \
        || fail 'workload ou Service apareceu durante secrets-only'
      verify_runtime_material
      ;;
    passed)
      assert_namespace_labels "$APP_NAMESPACE" application passed
      ! kube -n "$APP_NAMESPACE" get resourcequota platform-quarantine >/dev/null 2>&1 \
        || fail 'quota de quarentena ainda existe na aplicação'
      verify_runtime_material
      ;;
    *) fail "unexpected gate in namespace ${APP_NAMESPACE}" ;;
  esac
  edge_gate="$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')"
  case "$edge_gate" in
    blocked)
      assert_namespace_labels "$EDGE_NAMESPACE" edge blocked
      assert_quarantine_namespace "$EDGE_NAMESPACE"
      ;;
    connector-only)
      assert_namespace_labels "$EDGE_NAMESPACE" edge connector-only
      assert_edge_connector
      ;;
    passed)
      assert_namespace_labels "$EDGE_NAMESPACE" edge passed
      ! kube -n "$EDGE_NAMESPACE" get resourcequota platform-quarantine >/dev/null 2>&1 \
        || fail 'quota de quarentena ainda existe na EDGE'
      [[ "$(kube -n "$EDGE_NAMESPACE" get deployment -o json | jq \
        '[.items[].metadata.name] | sort == ["blindou-cloudflared"]')" == 'true' ]] \
        || fail 'Deployment inesperado na EDGE'
      [[ "$(kube -n "$EDGE_NAMESPACE" get statefulset,daemonset,job,cronjob,service,pvc \
        -o json | jq '[.items[]] | length')" == '0' ]] \
        || fail 'objeto proibido na EDGE'
      secret_has_keys "$EDGE_NAMESPACE" blindou-cloudflare-tunnel token
      secret_has_keys "$EDGE_NAMESPACE" "$GHCR_PULL_SECRET" .dockerconfigjson
      [[ "$(kube -n "$EDGE_NAMESPACE" get deployment blindou-cloudflared \
        -o jsonpath='{.spec.template.spec.imagePullSecrets[0].name}')" == "$GHCR_PULL_SECRET" ]] \
        || fail 'cloudflared não referencia a credencial GHCR somente leitura'
      ;;
    *) fail "unexpected gate in namespace ${EDGE_NAMESPACE}" ;;
  esac
  kube get validatingadmissionpolicy managed-production-workload-baseline >/dev/null \
    || fail 'ValidatingAdmissionPolicy de produção ausente'
  kube get validatingadmissionpolicybinding managed-production-workload-baseline >/dev/null \
    || fail 'binding da admissão de produção ausente'
  kube get validatingadmissionpolicy shared-lab-private-services >/dev/null \
    || fail 'política de Services privados ausente'
  kube get validatingadmissionpolicybinding shared-lab-private-services >/dev/null \
    || fail 'binding de Services privados ausente'
  [[ "$(kube get node "$NODE_NAME" -o jsonpath='{.metadata.labels.blindou\.io/node-role}')" == 'physical' ]] \
    || fail 'nó físico não possui o label Blindou esperado'
  if [[ "$edge_gate" == blocked ]]; then
    [[ "$(kube get deployment,statefulset,daemonset -A -o json | jq \
    '[.items[] | select((.metadata.name | ascii_downcase | contains("cloudflared")) or any(.spec.template.spec.containers[]?; .image | ascii_downcase | contains("cloudflared")))] | length')" == '0' ]] \
    || fail 'cloudflared apareceu no cluster antes da configuração externa'
  pgrep -x cloudflared >/dev/null \
    && fail 'cloudflared apareceu no host'
  fi
  negative_admission_tests
  pass 'namespaces vazios, quarentena, admissão e preservação do apiwpp verificados'
}

write_foundation_state() {
  local edge_preexisting="$1" app_preexisting="$2" node_label_before="$3" backup_dir="$4"
  install -d -o root -g root -m 0700 "$STATE_ROOT"
  {
    printf 'edge_preexisting=%s\n' "$edge_preexisting"
    printf 'app_preexisting=%s\n' "$app_preexisting"
    printf 'node_label_before=%s\n' "$node_label_before"
    printf 'backup_dir=%s\n' "$backup_dir"
  } >"${FOUNDATION_STATE}.tmp"
  install -o root -g root -m 0600 "${FOUNDATION_STATE}.tmp" "$FOUNDATION_STATE"
  rm -f -- "${FOUNDATION_STATE}.tmp"
}

apply_foundation() {
  [[ "${1:-}" == "$FOUNDATION_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${FOUNDATION_CONFIRMATION}"
  require_platform_preconditions
  local edge_preexisting=false app_preexisting=false node_label_before timestamp backup_dir
  namespace_exists "$EDGE_NAMESPACE" && edge_preexisting=true
  namespace_exists "$APP_NAMESPACE" && app_preexisting=true
  node_label_before="$(kube get node "$NODE_NAME" \
    -o jsonpath='{.metadata.labels.blindou\.io/node-role}' 2>/dev/null || true)"
  if [[ "$edge_preexisting" == true || "$app_preexisting" == true ]]; then
    if ( verify_foundation >/dev/null 2>&1 ); then
      pass 'fundação Blindou já estava aplicada'
      return
    fi
    fail 'namespace Blindou preexistente diverge; rollback/reconciliação humana exigida'
  fi

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_dir="${FOUNDATION_BACKUP_ROOT}/${timestamp}"
  install -d -o root -g root -m 0700 "$backup_dir"
  kube get validatingadmissionpolicy,validatingadmissionpolicybinding -o yaml \
    >"${backup_dir}/admission-before.yaml"
  kube get node "$NODE_NAME" -o yaml >"${backup_dir}/node-before.yaml"
  write_foundation_state \
    "$edge_preexisting" "$app_preexisting" "$node_label_before" "$backup_dir"

  if ! (
    kube apply -f "${FOUNDATION_DIR}/shared-service-exposure-policy.yaml" >/dev/null
    kube apply -f "${FOUNDATION_DIR}/20-production-workload-policy.yaml" >/dev/null
    kube apply -f "${FOUNDATION_DIR}/00-namespaces.yaml" >/dev/null
    kube apply -f "${FOUNDATION_DIR}/10-quarantine.yaml" >/dev/null
    kube label node "$NODE_NAME" blindou.io/node-role=physical --overwrite >/dev/null
    verify_foundation
  ); then
    rollback_foundation "$FOUNDATION_CONFIRMATION" auto \
      || fail 'aplicação falhou e rollback automático também falhou'
    fail 'aplicação da fundação falhou; rollback automático concluído'
  fi
  pass "fundação bloqueada aplicada; backup em ${backup_dir}"
}

rollback_foundation() {
  [[ "${1:-}" == "$FOUNDATION_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${FOUNDATION_CONFIRMATION}"
  local mode="${2:-human}" edge_preexisting app_preexisting node_label_before backup_dir
  require_root_and_host
  [[ -f "$FOUNDATION_STATE" && ! -L "$FOUNDATION_STATE" ]] \
    || fail 'estado da fundação ausente'
  # O arquivo é gerado pelo próprio controlador com valores restritos.
  # shellcheck disable=SC1090
  source "$FOUNDATION_STATE"
  [[ "$edge_preexisting" =~ ^(true|false)$ && "$app_preexisting" =~ ^(true|false)$ ]] \
    || fail 'estado da fundação inválido'
  [[ "$backup_dir" =~ ^${FOUNDATION_BACKUP_ROOT}/[0-9]{8}T[0-9]{6}Z$ \
      && -f "${backup_dir}/admission-before.yaml" ]] \
    || fail 'backup anterior da admissao e invalido'
  for namespace in "$APP_NAMESPACE" "$EDGE_NAMESPACE"; do
    if namespace_exists "$namespace"; then
      [[ "$(namespace_object_count "$namespace")" == '0' ]] \
        || fail "rollback recusado: ${namespace} contém objeto operacional"
    fi
  done
  kube delete -f "${FOUNDATION_DIR}/10-quarantine.yaml" --ignore-not-found >/dev/null
  if [[ "$app_preexisting" == false ]]; then
    kube delete namespace "$APP_NAMESPACE" --ignore-not-found --wait=true >/dev/null
  fi
  if [[ "$edge_preexisting" == false ]]; then
    kube delete namespace "$EDGE_NAMESPACE" --ignore-not-found --wait=true >/dev/null
  fi
  kube delete validatingadmissionpolicybinding \
    managed-production-workload-baseline shared-lab-private-services \
    --ignore-not-found >/dev/null
  kube delete validatingadmissionpolicy \
    managed-production-workload-baseline shared-lab-private-services \
    --ignore-not-found >/dev/null
  kube apply -f "${backup_dir}/admission-before.yaml" >/dev/null
  if [[ -z "$node_label_before" ]]; then
    kube label node "$NODE_NAME" blindou.io/node-role- >/dev/null 2>&1 || true
  else
    kube label node "$NODE_NAME" "blindou.io/node-role=${node_label_before}" --overwrite >/dev/null
  fi
  if [[ "$mode" != auto ]]; then
    pass 'somente namespaces vazios e controles da fundação Blindou foram revertidos'
  fi
}

verify_edge_connector() {
  verify_foundation >/dev/null
  [[ "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'connector-only' ]] \
    || fail 'edge connector gate is not active'
  pass 'Cloudflare connector is isolated and available'
}

rollback_edge_connector_internal() {
  kube delete -f "$EDGE_RUNTIME_MANIFEST" --ignore-not-found --wait=true >/dev/null
  kube -n "$EDGE_NAMESPACE" delete secret blindou-cloudflare-tunnel \
    --ignore-not-found --wait=true >/dev/null
  kube apply -f "${FOUNDATION_DIR}/00-namespaces.yaml" >/dev/null
  kube apply -f "${FOUNDATION_DIR}/10-quarantine.yaml" >/dev/null
  verify_foundation >/dev/null
}

provision_edge_connector() {
  [[ "${1:-}" == "$EDGE_CONNECTOR_CONFIRMATION" ]] \
    || fail "confirmation required: ${EDGE_CONNECTOR_CONFIRMATION}"
  require_platform_preconditions
  if ( verify_edge_connector >/dev/null 2>&1 ); then
    pass 'Cloudflare connector was already provisioned and healthy'
    return
  fi
  assert_namespace_labels "$APP_NAMESPACE" application blocked
  assert_quarantine_namespace "$APP_NAMESPACE"
  assert_namespace_labels "$EDGE_NAMESPACE" edge blocked
  assert_quarantine_namespace "$EDGE_NAMESPACE"
  [[ ! -t 0 ]] || fail 'tunnel token must arrive through non-interactive stdin'

  local token
  IFS= read -r token || fail 'tunnel token was not received'
  [[ ${#token} -ge 80 && ${#token} -le 4096 \
      && "$token" =~ ^[A-Za-z0-9._-]+$ ]] \
    || { unset token; fail 'tunnel token format is invalid'; }

  if ! (
    kube apply -f "${FOUNDATION_DIR}/20-production-workload-policy.yaml" >/dev/null
    kube apply -f "$EDGE_GATE_MANIFEST" >/dev/null
    printf '%s' "$token" \
      | kube -n "$EDGE_NAMESPACE" create secret generic blindou-cloudflare-tunnel \
          --from-file=token=/dev/stdin --dry-run=client -o yaml \
      | kube apply -f - >/dev/null
    kube apply -f "$EDGE_RUNTIME_MANIFEST" >/dev/null
    kube -n "$EDGE_NAMESPACE" rollout status deployment/blindou-cloudflared \
      --timeout=300s >/dev/null
    verify_edge_connector >/dev/null
  ); then
    unset token
    rollback_edge_connector_internal \
      || fail 'connector provisioning and automatic rollback both failed'
    fail 'connector provisioning failed; blocked edge quarantine was restored'
  fi
  unset token
  pass 'Cloudflare connector provisioned without persisting the token outside Kubernetes'
}

rollback_edge_connector() {
  [[ "${1:-}" == "$EDGE_CONNECTOR_CONFIRMATION" ]] \
    || fail "confirmation required: ${EDGE_CONNECTOR_CONFIRMATION}"
  require_platform_preconditions
  rollback_edge_connector_internal
  pass 'Cloudflare connector and its Kubernetes Secret were removed; edge is blocked again'
}

cloudflare_saas_token_format_is_valid() {
