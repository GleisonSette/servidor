verify_runtime_material() {
  runtime_secret_file_is_secure "$RUNTIME_CONFIG_FILE" || fail 'configuração root-only ausente'
  grep -Fxq 'AUTH_REQUIRE_2FA=false' "$RUNTIME_CONFIG_FILE" \
    || fail 'AUTH_REQUIRE_2FA deve permanecer false nesta release'
  if kube -n "$APP_NAMESPACE" get secret blindou-core-secrets \
      -o go-template='{{range $key, $value := .data}}{{printf "%s\n" $key}}{{end}}' \
      | grep -Fxq AUTH_SECURITY_WHATSAPP_SENDER_TOKEN; then
    fail 'sender WhatsApp do 2FA deve permanecer ausente'
  fi
  secret_has_keys "$APP_NAMESPACE" blindou-core-secrets \
    DATABASE_URL PASSWORD_PEPPER_CURRENT TOKEN_HASH_SECRET JWT_SECRET \
    TOTP_ENCRYPTION_KEY SESSION_ENCRYPTION_KEY AUTH_SECURITY_CODE_HASH_SECRET \
    AUTH_SECURITY_CODE_ENCRYPTION_KEY AUTH_SECURITY_CHANNEL_ENCRYPTION_KEY \
    AUTH_TRUST_HASH_SECRET UAZAPI_WEBHOOK_SECRET \
    UAZAPI_TOKEN_ENCRYPTION_KEY NATS_PASSWORD REDIS_PASSWORD \
    METRICS_BEARER_TOKEN CLOUDFLARE_SAAS_API_TOKEN \
    R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY
  local core_keys
  core_keys="$(kube -n "$APP_NAMESPACE" get secret blindou-core-secrets \
    -o go-template='{{range $key, $value := .data}}{{printf "%s\n" $key}}{{end}}')"
  if grep -Fxq 'UAZAPI_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    secret_has_keys "$APP_NAMESPACE" blindou-core-secrets UAZAPI_ADMIN_TOKEN
  else
    grep -Fxq 'UAZAPI_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
      || fail 'UAZAPI_ENABLED deve declarar true ou false explicitamente'
    ! grep -Fxq UAZAPI_ADMIN_TOKEN <<<"$core_keys" \
      || fail 'UAZAPI_ADMIN_TOKEN apareceu com UAZAPI desabilitada'
    [[ ! -e "${RUNTIME_SECRET_DIR}/UAZAPI_ADMIN_TOKEN" ]] \
      || fail 'UAZAPI_ADMIN_TOKEN apareceu no cofre com UAZAPI desabilitada'
  fi
  if grep -Fxq 'EMAIL_PROVIDER=resend' "$RUNTIME_CONFIG_FILE"; then
    secret_has_keys "$APP_NAMESPACE" blindou-core-secrets RESEND_API_KEY
  else
    grep -Fxq 'EMAIL_PROVIDER=disabled' "$RUNTIME_CONFIG_FILE" \
      || fail 'EMAIL_PROVIDER deve permanecer disabled ou usar Resend'
    ! grep -Fxq RESEND_API_KEY <<<"$core_keys" \
      || fail 'RESEND_API_KEY apareceu com o provider de e-mail desabilitado'
    [[ ! -e "${RUNTIME_SECRET_DIR}/RESEND_API_KEY" ]] \
      || fail 'RESEND_API_KEY apareceu no cofre com o provider de e-mail desabilitado'
  fi
  if grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    pagarme_credential_files_are_secure \
      || fail 'Pagar.me foi habilitado sem credencial segura no cofre dedicado'
    secret_has_keys "$APP_NAMESPACE" blindou-core-secrets \
      PAGARME_SECRET_KEY PAGARME_WEBHOOK_SECRET
  else
    grep -Fxq 'PAGARME_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
      || fail 'PAGARME_ENABLED deve declarar true ou false explicitamente'
    for forbidden_key in PAGARME_SECRET_KEY PAGARME_WEBHOOK_SECRET; do
      ! grep -Fxq "$forbidden_key" <<<"$core_keys" \
        || fail "${forbidden_key} apareceu com Pagar.me desabilitado"
    done
  fi
  for misplaced_key in PAGARME_SECRET_KEY PAGARME_WEBHOOK_SECRET; do
    [[ ! -e "${RUNTIME_SECRET_DIR}/${misplaced_key}" ]] \
      || fail "${misplaced_key} deve permanecer somente no cofre Pagar.me dedicado"
  done
  if grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    shopee_encryption_key_is_secure \
      || fail 'Shopee Open API foi habilitada sem chave de cifra segura no cofre root-only'
    secret_has_keys "$APP_NAMESPACE" blindou-core-secrets \
      SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY
  else
    if grep -q '^SHOPEE_OPEN_API_ENABLED=' "$RUNTIME_CONFIG_FILE"; then
      grep -Fxq 'SHOPEE_OPEN_API_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
        || fail 'SHOPEE_OPEN_API_ENABLED deve declarar true ou false'
    fi
    ! grep -Fxq SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY <<<"$core_keys" \
      || fail 'chave de cifra Shopee apareceu com a Open API desabilitada'
    [[ ! -e "${RUNTIME_SECRET_DIR}/SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY" ]] \
      || fail 'chave de cifra Shopee apareceu no cofre com a Open API desabilitada'
  fi
  if grep -Fxq 'INITIAL_UI_REVIEW_MODE=true' "$RUNTIME_CONFIG_FILE"; then
    grep -Fxq 'UAZAPI_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
      && grep -Fxq 'EMAIL_PROVIDER=disabled' "$RUNTIME_CONFIG_FILE" \
      && grep -Fxq 'PAGARME_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
      || fail 'revisão da UI exige todos os provedores externos desabilitados'
  fi
  grep -Fxq 'R2_PREVIEW_IMAGES_ENABLED=true' "$RUNTIME_CONFIG_FILE" \
    || fail 'R2 deve permanecer habilitado para o worker report-thumbnail'
  grep -Fxq "R2_ACCOUNT_ID=${R2_ACCOUNT_ID}" "$RUNTIME_CONFIG_FILE" \
    || fail 'R2_ACCOUNT_ID diverge da conta Cloudflare aprovada'
  grep -Fxq "R2_BUCKET=${R2_BUCKET}" "$RUNTIME_CONFIG_FILE" \
    || fail 'R2_BUCKET diverge do bucket exclusivo do Blindou'
  grep -Fxq "R2_PUBLIC_BASE_URL=${R2_PUBLIC_BASE_URL}" "$RUNTIME_CONFIG_FILE" \
    || fail 'R2_PUBLIC_BASE_URL diverge do domínio de mídia aprovado'
  r2_credential_files_are_secure \
    || fail 'credencial R2 root-only ausente ou insegura'
  secret_has_keys "$APP_NAMESPACE" blindou-redirect-secrets \
    REDIRECTOR_DATABASE_URL REDIRECTOR_CODE_SECRET REDIRECTOR_HMAC_SECRET \
    REDIRECTOR_IP_HASH_SECRET REDIRECTOR_FINGERPRINT_HASH_SECRET METRICS_BEARER_TOKEN
  secret_has_keys "$APP_NAMESPACE" blindou-ml-secrets \
    ML_CONNECTOR_DATABASE_URL ML_CONNECTOR_INTERNAL_API_KEY \
    ML_SESSION_ENCRYPTION_KEY ML_SESSION_ENCRYPTION_PEPPER
  secret_has_keys "$APP_NAMESPACE" blindou-migration-secrets MIGRATION_DATABASE_URL
  secret_has_keys "$APP_NAMESPACE" blindou-nats-auth backend-password
  secret_has_keys "$APP_NAMESPACE" blindou-redis-auth users.acl
  secret_has_keys "$APP_NAMESPACE" blindou-nats-tls ca.crt tls.crt tls.key
  secret_has_keys "$APP_NAMESPACE" blindou-postgres-client ca.crt tls.crt tls.key
  secret_has_keys "$APP_NAMESPACE" "$GHCR_PULL_SECRET" .dockerconfigjson
  secret_has_keys "$EDGE_NAMESPACE" blindou-cloudflare-tunnel token
}

prepare_internal_runtime_material() {
  install -d -o root -g root -m 0700 "$RUNTIME_SECRET_DIR"
  extract_database_url MIGRATION_DATABASE_URL
  extract_database_url DATABASE_URL
  extract_database_url REDIRECTOR_DATABASE_URL
  extract_database_url ML_CONNECTOR_DATABASE_URL
  local name
  for name in PASSWORD_PEPPER_CURRENT TOKEN_HASH_SECRET JWT_SECRET SESSION_ENCRYPTION_KEY \
    AUTH_SECURITY_CODE_HASH_SECRET AUTH_TRUST_HASH_SECRET UAZAPI_WEBHOOK_SECRET \
    NATS_PASSWORD REDIS_PASSWORD CORE_METRICS_BEARER_TOKEN REDIRECT_METRICS_BEARER_TOKEN \
    REDIRECTOR_CODE_SECRET REDIRECTOR_HMAC_SECRET REDIRECTOR_IP_HASH_SECRET \
    REDIRECTOR_FINGERPRINT_HASH_SECRET ML_CONNECTOR_INTERNAL_API_KEY \
    ML_SESSION_ENCRYPTION_PEPPER; do
    ensure_random_hex "$name"
  done
  for name in TOTP_ENCRYPTION_KEY AUTH_SECURITY_CODE_ENCRYPTION_KEY \
    AUTH_SECURITY_CHANNEL_ENCRYPTION_KEY UAZAPI_TOKEN_ENCRYPTION_KEY \
    ML_SESSION_ENCRYPTION_KEY; do
    ensure_random_base64_key "$name"
  done
  if grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    ensure_random_base64_key SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY
  fi
  cleanup_paths+=("${RUNTIME_SECRET_DIR}/users.acl.tmp")
  printf 'user default on >%s ~* &* +@all' \
    "$(<"${RUNTIME_SECRET_DIR}/REDIS_PASSWORD")" >"${RUNTIME_SECRET_DIR}/users.acl.tmp"
  install -o root -g root -m 0600 "${RUNTIME_SECRET_DIR}/users.acl.tmp" \
    "${RUNTIME_SECRET_DIR}/users.acl"
  rm -f -- "${RUNTIME_SECRET_DIR}/users.acl.tmp"
  generate_nats_pki
}

publish_runtime_material() {
  kube label namespace "$APP_NAMESPACE" \
    'platform.servidor.local/deployment-gate=secrets-only' --overwrite >/dev/null
  kube annotate namespace "$APP_NAMESPACE" \
    'platform.servidor.local/gate-reason=runtime-material-only' --overwrite >/dev/null
  kube -n "$APP_NAMESPACE" delete resourcequota platform-quarantine --ignore-not-found >/dev/null
  create_runtime_kubernetes_material
  verify_runtime_material
}

provision_ui_review_runtime() {
  [[ "${1:-}" == "$UI_REVIEW_RUNTIME_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${UI_REVIEW_RUNTIME_CONFIRMATION}"
  require_platform_preconditions
  verify_data_foundation >/dev/null
  verify_cloudflare_saas_token >/dev/null
  verify_ghcr_pull_credential >/dev/null
  verify_r2_runtime_credential >/dev/null
  for provider_file in UAZAPI_ADMIN_TOKEN RESEND_API_KEY PAGARME_SECRET_KEY PAGARME_WEBHOOK_SECRET; do
    [[ ! -e "${RUNTIME_SECRET_DIR}/${provider_file}" ]] \
      || fail "credencial ${provider_file} já existe; revisão sem provedores recusada"
  done
  install -d -o root -g root -m 0700 "$RUNTIME_SECRET_DIR"
  write_ui_review_runtime_config
  prepare_internal_runtime_material
  publish_runtime_material
  {
    printf 'schema=1\nstatus=authorized\nmode=initial-ui-review\n'
    printf 'authorized_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${UI_REVIEW_RECEIPT}.tmp"
  cleanup_paths+=("${UI_REVIEW_RECEIPT}.tmp")
  install -o root -g root -m 0600 "${UI_REVIEW_RECEIPT}.tmp" "$UI_REVIEW_RECEIPT"
  rm -f -- "${UI_REVIEW_RECEIPT}.tmp"
  pass 'núcleo preparado para revisão da UI; UAZAPI, Resend, Pagar.me e alertas externos permanecem ausentes'
}

provision_runtime_secrets() {
  [[ "${1:-}" == "$RUNTIME_SECRETS_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${RUNTIME_SECRETS_CONFIRMATION}"
  [[ ! -t 0 ]] || fail 'segredos de runtime devem chegar por stdin não interativo'
  require_platform_preconditions
  verify_data_foundation >/dev/null
  verify_cloudflare_saas_token >/dev/null
  verify_ghcr_pull_credential >/dev/null
  verify_r2_runtime_credential >/dev/null
  local schema uazapi_url_b64 uazapi_token_b64 resend_key_b64 email_from_b64
  IFS= read -r schema || fail 'payload de runtime ausente'
  IFS= read -r uazapi_url_b64 || fail 'UAZAPI_BASE_URL ausente'
  IFS= read -r uazapi_token_b64 || fail 'UAZAPI_ADMIN_TOKEN ausente'
  IFS= read -r resend_key_b64 || fail 'RESEND_API_KEY ausente'
  IFS= read -r email_from_b64 || fail 'EMAIL_FROM_EMAIL ausente'
  [[ "$schema" == 'schema=1' ]] || fail 'schema do payload de runtime inválido'
  local encoded
  for encoded in "$uazapi_url_b64" "$uazapi_token_b64" "$resend_key_b64" "$email_from_b64"; do
    [[ "$encoded" =~ ^[A-Za-z0-9+/=]{4,8192}$ ]] || fail 'campo base64 inválido no payload de runtime'
  done
  local uazapi_base_url uazapi_admin_token resend_api_key email_from
  uazapi_base_url="$(printf '%s' "$uazapi_url_b64" | base64 -d)" || fail 'UAZAPI_BASE_URL inválida'
  uazapi_admin_token="$(printf '%s' "$uazapi_token_b64" | base64 -d)" || fail 'UAZAPI_ADMIN_TOKEN inválido'
  resend_api_key="$(printf '%s' "$resend_key_b64" | base64 -d)" || fail 'RESEND_API_KEY inválida'
  email_from="$(printf '%s' "$email_from_b64" | base64 -d)" || fail 'EMAIL_FROM_EMAIL inválido'
  [[ "$uazapi_base_url" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[^[:space:]\"\\]*)?$ ]] \
    || fail 'UAZAPI_BASE_URL deve ser HTTPS sem credenciais embutidas'
  [[ "$uazapi_admin_token" =~ ^[^[:space:][:cntrl:]]{16,2048}$ ]] \
    || fail 'UAZAPI_ADMIN_TOKEN possui formato inválido'
  [[ "$resend_api_key" =~ ^re_[A-Za-z0-9_-]{16,512}$ ]] \
    || fail 'RESEND_API_KEY possui formato inválido'
  [[ "$email_from" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ && "$email_from" != *.invalid ]] \
    || fail 'EMAIL_FROM_EMAIL possui formato inválido'

  install -d -o root -g root -m 0700 "$RUNTIME_SECRET_DIR"
  write_runtime_value UAZAPI_ADMIN_TOKEN "$uazapi_admin_token"
  write_runtime_value RESEND_API_KEY "$resend_api_key"
  unset uazapi_admin_token resend_api_key uazapi_token_b64 resend_key_b64
  write_runtime_config "$uazapi_base_url" "$email_from"
  prepare_internal_runtime_material
  validate_runtime_providers "$uazapi_base_url" "$email_from"
  configure_external_alerting "$email_from"
  unset uazapi_base_url email_from uazapi_url_b64 email_from_b64

  publish_runtime_material
  pass 'segredos, configuração e provedores preparados; workloads continuam bloqueados'
}

current_release_is_pagarme_compatible() {
  local release_id="$1" worker_json
  [[ "$release_id" =~ $RELEASE_PATTERN \
      && -f "$CURRENT_RELEASE" \
      && ! -L "$CURRENT_RELEASE" \
      && "$(stat -c '%U:%G:%a' "$CURRENT_RELEASE")" == 'root:root:600' \
      && "$(<"$CURRENT_RELEASE")" == "$release_id" ]] \
    || return 1
  [[ "$(kube -n "$APP_NAMESPACE" get deployment blindou-backend \
      -o jsonpath='{.spec.template.metadata.annotations.blindou\.io/pagarme-first-compatible}')" == 'true' \
      && "$(kube -n "$APP_NAMESPACE" get deployment blindou-backend \
      -o jsonpath='{.spec.template.metadata.annotations.blindou\.io/release}')" == "$release_id" ]] \
    || return 1
  worker_json="$(kube -n "$APP_NAMESPACE" get deployment \
    -l blindou.io/tier=worker -o json)" || return 1
  jq -e --arg release_id "$release_id" '
    (.items | length) == 16
    and all(.items[];
      .spec.template.metadata.annotations["blindou.io/pagarme-first-compatible"] == "true"
      and .spec.template.metadata.annotations["blindou.io/release"] == $release_id
    )
  ' <<<"$worker_json" >/dev/null
}

