show_status() {
  require_root_and_host
  printf 'host=%s\n' "$(hostname)"
  printf 'foundation_state=%s\n' "$([[ -f "$FOUNDATION_STATE" ]] && echo present || echo absent)"
  for namespace in "$APP_NAMESPACE" "$EDGE_NAMESPACE"; do
    if namespace_exists "$namespace"; then
      printf 'namespace_%s=present gate=%s operational_objects=%s\n' \
        "${namespace//-/_}" \
        "$(namespace_label "$namespace" 'platform\.servidor\.local/deployment-gate')" \
        "$(namespace_object_count "$namespace")"
    else
      printf 'namespace_%s=absent\n' "${namespace//-/_}"
    fi
  done
  printf 'database_blindou=%s\n' \
    "$(postgres_query -d postgres -Atqc "SELECT CASE WHEN EXISTS (SELECT 1 FROM pg_database WHERE datname='blindou') THEN 'present' ELSE 'absent' END")"
  if [[ "$(postgres_query -d postgres -Atqc \
      "SELECT count(*) FROM pg_database WHERE datname='blindou'")" == '1' ]]; then
    if [[ "$(postgres_query -d blindou -Atqc \
        "SELECT to_regclass('public._sqlx_migrations') IS NOT NULL")" == 't' ]]; then
      printf 'migration_history_count=%s\n' \
        "$(postgres_query -d blindou -Atqc 'SELECT count(*) FROM public._sqlx_migrations')"
    else
      printf 'migration_history_count=absent\n'
    fi
    printf 'pg_stat_statements=%s\n' \
      "$(postgres_query -d blindou -Atqc \
        "SELECT CASE WHEN EXISTS (SELECT 1 FROM pg_extension WHERE extname='pg_stat_statements') THEN 'present' ELSE 'absent' END")"
  fi
  if [[ -f "${DATABASE_BACKUP_ROOT}/latest" ]]; then
    printf 'latest_encrypted_backup=%s\n' "$(<"${DATABASE_BACKUP_ROOT}/latest")"
  else
    printf 'latest_encrypted_backup=absent\n'
  fi
  if [[ -f "$CURRENT_RELEASE" ]]; then
    printf 'current_release=%s\n' "$(<"$CURRENT_RELEASE")"
  else
    printf 'current_release=absent\n'
  fi
  if [[ "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate' 2>/dev/null || true)" == passed \
      && "$(kube -n "$EDGE_NAMESPACE" get deployment blindou-cloudflared \
        -o jsonpath='{.status.availableReplicas}' 2>/dev/null || true)" == '1' ]] \
      || ( verify_edge_connector >/dev/null 2>&1 ); then
    printf 'cloudflare_connector=ready\n'
  else
    printf 'cloudflare_connector=absent_or_unhealthy\n'
  fi
  if cloudflare_saas_token_file_is_secure; then
    printf 'cloudflare_saas_credential_state=secure_local_store\n'
  else
    printf 'cloudflare_saas_credential_state=absent_or_insecure\n'
  fi
  if ghcr_token_file_is_secure; then
    printf 'ghcr_pull_credential_state=secure_local_store\n'
  else
    printf 'ghcr_pull_credential_state=absent_or_insecure\n'
  fi
  if ghcr_pull_latest_proof_is_secure; then
    printf 'ghcr_candidate_pull_proof=%s\n' "$(<"$GHCR_PULL_PROOF_LATEST")"
  else
    printf 'ghcr_candidate_pull_proof=absent_or_insecure\n'
  fi
  if r2_credential_files_are_secure; then
    printf 'r2_runtime_credential_state=secure_local_store\n'
  else
    printf 'r2_runtime_credential_state=absent_or_insecure\n'
  fi
  if [[ -f "$R2_VERIFICATION_RECEIPT" && ! -L "$R2_VERIFICATION_RECEIPT" ]] \
      && grep -Fxq "bucket=${R2_BUCKET}" "$R2_VERIFICATION_RECEIPT"; then
    printf 'r2_runtime_live_probe=passed\n'
  else
    printf 'r2_runtime_live_probe=absent_or_failed\n'
  fi
  if pagarme_credential_files_are_secure; then
    printf 'pagarme_credential_state=secure_local_store\n'
  else
    printf 'pagarme_credential_state=absent_or_insecure\n'
  fi
  if pagarme_plans_receipt_is_secure; then
    printf 'pagarme_plans_state=seven_live_verified\n'
  else
    printf 'pagarme_plans_state=absent_or_invalid\n'
  fi
  if pagarme_runtime_receipt_is_secure \
      && grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    printf 'pagarme_runtime_state=active\n'
  else
    printf 'pagarme_runtime_state=inactive\n'
  fi
  if marketplaces_runtime_receipt_is_secure \
      && grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    printf 'marketplaces_runtime_state=shopee_ready_for_tenant_credentials\n'
  else
    printf 'marketplaces_runtime_state=inactive\n'
  fi
  if [[ -f "$RUNTIME_CONFIG_FILE" && ! -L "$RUNTIME_CONFIG_FILE" ]]; then
    printf 'runtime_material=present\n'
  else
    printf 'runtime_material=absent\n'
  fi
  if [[ -f "$ALERT_RECEIPT" ]] && grep -Fxq 'status=confirmed' "$ALERT_RECEIPT"; then
    printf 'external_alert_receiver=confirmed\n'
  elif pagarme_runtime_receipt_is_secure; then
    printf 'external_alert_receiver=deferred_uazapi_resend\n'
  elif [[ -f "$UI_REVIEW_RECEIPT" ]] && grep -Fxq 'status=authorized' "$UI_REVIEW_RECEIPT"; then
    printf 'external_alert_receiver=deferred_ui_review\n'
  else
    printf 'external_alert_receiver=absent_or_pending\n'
  fi
  if [[ -f "$OFFSITE_BACKUP_RECEIPT" ]]; then
    printf 'offsite_backup_receipt=present\n'
  else
    printf 'offsite_backup_receipt=absent\n'
  fi
}

