}

cloudflare_saas_token_file_is_secure() {
  [[ -f "$CLOUDFLARE_SAAS_TOKEN_FILE" \
      && ! -L "$CLOUDFLARE_SAAS_TOKEN_FILE" \
      && "$(stat -c '%U:%G:%a' "$CLOUDFLARE_SAAS_TOKEN_FILE" 2>/dev/null)" == 'root:root:600' \
      && "$(wc -l <"$CLOUDFLARE_SAAS_TOKEN_FILE")" == '1' ]] \
    || return 1
  local token
  IFS= read -r token <"$CLOUDFLARE_SAAS_TOKEN_FILE" || return 1
  cloudflare_saas_token_format_is_valid "$token"
}

cloudflare_api_request() {
  local token="$1" url="$2"
  printf '%s\n' \
    'silent' \
    'show-error' \
    'fail-with-body' \
    'proto = "=https"' \
    'tlsv1.2' \
    'connect-timeout = 10' \
    'max-time = 30' \
    "header = \"Authorization: Bearer ${token}\"" \
    'header = "Accept: application/json"' \
    "url = \"${url}\"" \
    | curl --config -
}

cloudflare_saas_token_has_minimum_scope() {
  local token="$1" response
  response="$(cloudflare_api_request "$token" \
    'https://api.cloudflare.com/client/v4/user/tokens/verify')" \
    || return 1
  jq -e '.success == true and .result.status == "active"' \
    <<<"$response" >/dev/null || { unset response; return 1; }
  unset response

  response="$(cloudflare_api_request "$token" \
    "https://api.cloudflare.com/client/v4/zones/${CLOUDFLARE_SAAS_ZONE_ID}/custom_hostnames?per_page=1")" \
    || return 1
  jq -e '.success == true and (.result | type == "array")' \
    <<<"$response" >/dev/null || { unset response; return 1; }
  unset response
}

verify_cloudflare_saas_token() {
  require_platform_preconditions
  cloudflare_saas_token_file_is_secure \
    || fail 'Cloudflare for SaaS token file is absent or insecure'
  local token
  IFS= read -r token <"$CLOUDFLARE_SAAS_TOKEN_FILE" \
    || fail 'Cloudflare for SaaS token could not be read'
  if ! cloudflare_saas_token_has_minimum_scope "$token"; then
    unset token
    fail 'Cloudflare for SaaS token is inactive or lacks zone custom-hostname access'
  fi
  unset token
  pass 'Cloudflare for SaaS token is active, root-only and scoped to the Blindou zone'
}

provision_cloudflare_saas_token() {
  [[ "${1:-}" == "$CLOUDFLARE_SAAS_TOKEN_CONFIRMATION" ]] \
    || fail "confirmation required: ${CLOUDFLARE_SAAS_TOKEN_CONFIRMATION}"
  require_platform_preconditions
  assert_namespace_labels "$APP_NAMESPACE" application blocked
  assert_quarantine_namespace "$APP_NAMESPACE"
  [[ ! -f "$CURRENT_RELEASE" ]] \
    || fail 'Cloudflare for SaaS token provisioning is closed after a release exists'
  [[ ! -t 0 ]] || fail 'Cloudflare for SaaS token must arrive through non-interactive stdin'

  local token existing temporary
  IFS= read -r token || fail 'Cloudflare for SaaS token was not received'
  cloudflare_saas_token_format_is_valid "$token" \
    || { unset token; fail 'Cloudflare for SaaS token format is invalid'; }
  cloudflare_saas_token_has_minimum_scope "$token" \
    || { unset token; fail 'Cloudflare for SaaS token is inactive or lacks zone custom-hostname access'; }

  if [[ -e "$CLOUDFLARE_SAAS_TOKEN_FILE" || -L "$CLOUDFLARE_SAAS_TOKEN_FILE" ]]; then
    cloudflare_saas_token_file_is_secure \
      || { unset token; fail 'existing Cloudflare for SaaS token file is insecure'; }
    IFS= read -r existing <"$CLOUDFLARE_SAAS_TOKEN_FILE"
    [[ "$existing" == "$token" ]] \
      || { unset token existing; fail 'a different token is already provisioned'; }
    unset token existing
    verify_cloudflare_saas_token >/dev/null
    pass 'Cloudflare for SaaS token was already provisioned and remains valid'
    return
  fi

  install -d -o root -g root -m 0700 "$CLOUDFLARE_SAAS_SECRET_DIR"
  temporary="$(mktemp "${CLOUDFLARE_SAAS_TOKEN_FILE}.tmp.XXXXXX")"
  cleanup_paths+=("$temporary")
  printf '%s\n' "$token" >"$temporary"
  unset token
  install -o root -g root -m 0600 "$temporary" "$CLOUDFLARE_SAAS_TOKEN_FILE"
  rm -f -- "$temporary"
  verify_cloudflare_saas_token >/dev/null
  pass 'Cloudflare for SaaS token provisioned in the root-only provider store; runtime remains blocked'
}

rollback_cloudflare_saas_token() {
  [[ "${1:-}" == "$CLOUDFLARE_SAAS_TOKEN_CONFIRMATION" ]] \
    || fail "confirmation required: ${CLOUDFLARE_SAAS_TOKEN_CONFIRMATION}"
  require_platform_preconditions
  assert_namespace_labels "$APP_NAMESPACE" application blocked
  assert_quarantine_namespace "$APP_NAMESPACE"
  [[ ! -f "$CURRENT_RELEASE" ]] \
    || fail 'token rollback is closed after a release exists'
  rm -f -- "$CLOUDFLARE_SAAS_TOKEN_FILE"
  pass 'Cloudflare for SaaS token removed from the root-only provider store'
}

ghcr_token_format_is_valid() {
  local token="$1"
  [[ ${#token} -ge 40 && ${#token} -le 255 \
      && "$token" =~ ^ghp_[A-Za-z0-9]+$ ]]
}

ghcr_token_file_is_secure() {
  [[ -f "$GHCR_PULL_TOKEN_FILE" \
      && ! -L "$GHCR_PULL_TOKEN_FILE" \
      && "$(stat -c '%U:%G:%a' "$GHCR_PULL_TOKEN_FILE" 2>/dev/null)" == 'root:root:600' \
      && "$(wc -l <"$GHCR_PULL_TOKEN_FILE")" == '1' ]] \
    || return 1
  local token
  IFS= read -r token <"$GHCR_PULL_TOKEN_FILE" || return 1
  ghcr_token_format_is_valid "$token"
}

ghcr_token_has_read_only_packages_scope() {
  local token="$1" headers response login scopes
  headers="$(mktemp /var/tmp/blindou-ghcr-headers.XXXXXX)"
  cleanup_paths+=("$headers")
  response="$({
    printf '%s\n' \
      'silent' \
      'show-error' \
      'fail-with-body' \
      'proto = "=https"' \
      'tlsv1.2' \
      'connect-timeout = 10' \
      'max-time = 30' \
      "header = \"Authorization: Bearer ${token}\"" \
      'header = "Accept: application/vnd.github+json"' \
      'header = "X-GitHub-Api-Version: 2022-11-28"' \
      "dump-header = \"${headers}\"" \
      'url = "https://api.github.com/user"'
  } | curl --config -)" || { rm -f -- "$headers"; return 1; }

  login="$(jq -r '.login // empty' <<<"$response")"
  unset response
  [[ "${login,,}" == "${GHCR_USERNAME,,}" ]] \
    || { rm -f -- "$headers"; return 1; }
  scopes="$(awk -F: 'tolower($1) == "x-oauth-scopes" {sub(/^[^:]*:[[:space:]]*/, ""); gsub(/\r/, ""); print}' \
    "$headers" | tail -n 1 | tr -d '[:space:]')"
  rm -f -- "$headers"
  [[ "$scopes" == 'read:packages' ]]
}

verify_ghcr_pull_credential() {
  require_platform_preconditions
  ghcr_token_file_is_secure \
    || fail 'GHCR pull credential file is absent or insecure'
  local token
  IFS= read -r token <"$GHCR_PULL_TOKEN_FILE" \
    || fail 'GHCR pull credential could not be read'
  if ! ghcr_token_has_read_only_packages_scope "$token"; then
    unset token
    fail 'GHCR credential is inactive, belongs to another actor or is not exactly read:packages'
  fi
  unset token
  pass 'GHCR credential is active, root-only and limited to read:packages'
}

cached_release_ghcr_images() {
  local release_id="$1" rendered
  local -a images=()
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || return 1
  rendered="${RELEASE_CACHE}/${release_id}/rendered"
  [[ -d "$rendered" && ! -L "$rendered" ]] || return 1
  mapfile -t images < <(
    grep -hER '^[[:space:]]+image:[[:space:]]+ghcr\.io/gleisonsette/blindou-(backend|redirector|nats|cloudflared)@sha256:[0-9a-f]{64}[[:space:]]*$' \
      "$rendered" \
      | awk '{print $2}' \
      | sort -u
  )
  [[ "${#images[@]}" -eq 4 ]] || return 1
  local image
  for image in "${images[@]}"; do
    [[ "$image" =~ ^ghcr\.io/gleisonsette/blindou-(backend|redirector|nats|cloudflared)@sha256:[0-9a-f]{64}$ ]] \
      || return 1
  done
  printf '%s\n' "${images[@]}"
}

ghcr_pull_proof_file_is_secure() {
  local release_id="$1" proof
  local image component
  local -a expected_images=()
  proof="${GHCR_PULL_PROOF_ROOT}/${release_id}.env"
  [[ "$release_id" =~ $RELEASE_PATTERN \
      && -f "$proof" \
      && ! -L "$proof" \
      && "$(stat -c '%U:%G:%a' "$proof" 2>/dev/null)" == 'root:root:600' \
      && "$(wc -l <"$proof")" == '24' ]] \
    || return 1
  grep -Fxq 'schema=1' "$proof" || return 1
  grep -Fxq "release_id=${release_id}" "$proof" || return 1
  grep -Eq '^verified_at=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' "$proof" \
    || return 1
  grep -Fxq 'registry=ghcr.io' "$proof" || return 1
  grep -Fxq 'platform=linux/amd64' "$proof" || return 1
  grep -Fxq 'images=4' "$proof" || return 1
  grep -Eq '^blobs=[1-9][0-9]*$' "$proof" || return 1
  grep -Eq '^bytes=[1-9][0-9]*$' "$proof" || return 1
  grep -Eq '^backend_image=ghcr\.io/gleisonsette/blindou-backend@sha256:[0-9a-f]{64}$' "$proof" \
    || return 1
  grep -Eq '^redirector_image=ghcr\.io/gleisonsette/blindou-redirector@sha256:[0-9a-f]{64}$' "$proof" \
    || return 1
  grep -Eq '^nats_image=ghcr\.io/gleisonsette/blindou-nats@sha256:[0-9a-f]{64}$' "$proof" \
    || return 1
  grep -Eq '^cloudflared_image=ghcr\.io/gleisonsette/blindou-cloudflared@sha256:[0-9a-f]{64}$' "$proof" \
    || return 1
  mapfile -t expected_images < <(cached_release_ghcr_images "$release_id")
  [[ "${#expected_images[@]}" -eq 4 ]] || return 1
  for image in "${expected_images[@]}"; do
    case "$image" in
      ghcr.io/gleisonsette/blindou-backend@*) component='backend' ;;
      ghcr.io/gleisonsette/blindou-redirector@*) component='redirector' ;;
      ghcr.io/gleisonsette/blindou-nats@*) component='nats' ;;
      ghcr.io/gleisonsette/blindou-cloudflared@*) component='cloudflared' ;;
      *) return 1 ;;
    esac
    grep -Fxq "${component}_image=${image}" "$proof" || return 1
  done
  local prefix
  for prefix in backend redirector nats cloudflared; do
    grep -Eq "^${prefix}_platform_digest=sha256:[0-9a-f]{64}$" "$proof" || return 1
    grep -Eq "^${prefix}_blobs=[1-9][0-9]*$" "$proof" || return 1
    grep -Eq "^${prefix}_bytes=[1-9][0-9]*$" "$proof" || return 1
  done
}

ghcr_pull_latest_proof_is_secure() {
  [[ -f "$GHCR_PULL_PROOF_LATEST" \
      && ! -L "$GHCR_PULL_PROOF_LATEST" \
      && "$(stat -c '%U:%G:%a' "$GHCR_PULL_PROOF_LATEST" 2>/dev/null)" == 'root:root:600' \
      && "$(wc -l <"$GHCR_PULL_PROOF_LATEST")" == '1' ]] \
    || return 1
  local release_id
  IFS= read -r release_id <"$GHCR_PULL_PROOF_LATEST" || return 1
  ghcr_pull_proof_file_is_secure "$release_id"
}

verify_ghcr_candidate_pull() {
  local release_id="$1" token receipt latest_tmp
  local -a images=()
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id inválido'
  require_platform_preconditions
  verify_ghcr_pull_credential >/dev/null
  mapfile -t images < <(cached_release_ghcr_images "$release_id")
  [[ "${#images[@]}" -eq 4 ]] \
    || fail 'release validada não contém exatamente as quatro imagens privadas'
  [[ -f "$GHCR_PULL_VERIFIER" \
      && ! -L "$GHCR_PULL_VERIFIER" \
      && "$(stat -c '%U:%G:%a' "$GHCR_PULL_VERIFIER" 2>/dev/null)" == 'root:root:755' ]] \
    || fail 'verificador root-owned do pull GHCR está ausente ou inseguro'

  install -d -o root -g root -m 0700 "$GHCR_PULL_PROOF_ROOT"
  receipt="$(mktemp "${GHCR_PULL_PROOF_ROOT}/.tmp.${release_id}.XXXXXX")"
  cleanup_paths+=("$receipt")
  chmod 0600 "$receipt"
  IFS= read -r token <"$GHCR_PULL_TOKEN_FILE" \
    || fail 'GHCR pull credential could not be read'
  if ! printf '%s\n' "$token" \
      | python3 "$GHCR_PULL_VERIFIER" \
          --release-id "$release_id" \
          --output "$receipt" \
          --image "${images[0]}" \
          --image "${images[1]}" \
          --image "${images[2]}" \
          --image "${images[3]}"; then
    unset token
    fail 'o pull integral da candidata privada falhou'
  fi
  unset token
  install -o root -g root -m 0600 "$receipt" \
    "${GHCR_PULL_PROOF_ROOT}/${release_id}.env"
  rm -f -- "$receipt"
  ghcr_pull_proof_file_is_secure "$release_id" \
    || fail 'recibo do pull GHCR não passou no contrato fechado'

  latest_tmp="$(mktemp "${GHCR_PULL_PROOF_LATEST}.tmp.XXXXXX")"
  cleanup_paths+=("$latest_tmp")
  printf '%s\n' "$release_id" >"$latest_tmp"
  install -o root -g root -m 0600 "$latest_tmp" "$GHCR_PULL_PROOF_LATEST"
  rm -f -- "$latest_tmp"
  ghcr_pull_latest_proof_is_secure \
    || fail 'ponteiro do recibo GHCR não passou no contrato fechado'
  pass "pull integral das imagens privadas comprovado sem criar Secret ou workload: ${release_id}"
}

