    --receipt "$PAGARME_PLANS_RECEIPT" >/dev/null \
    || fail 'catálogo live Pagar.me diverge do recibo canônico'
  pass 'sete planos live Pagar.me conferidos contra o catálogo canônico'
}

provision_pagarme_plans() {
  [[ "${1:-}" == "$PAGARME_PLANS_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${PAGARME_PLANS_CONFIRMATION}"
  require_pagarme_catalog_preconditions
  "$PAGARME_PLAN_PROVISIONER" \
    --mode provision \
    --secret-key-file "$PAGARME_SECRET_KEY_FILE" \
    --receipt "$PAGARME_PLANS_RECEIPT" \
    || fail 'provisionamento fechado dos planos Pagar.me falhou'
  pagarme_plans_receipt_is_secure \
    || fail 'recibo final dos planos Pagar.me não passou na verificação root-only'
  pass 'sete planos live Pagar.me criados ou reconciliados e conferidos; runtime não foi alterado'
  printf 'pagarme_plans_receipt_base64='
  base64 -w 0 "$PAGARME_PLANS_RECEIPT"
  printf '\n'
}

ensure_ghcr_pull_secret() {
  verify_ghcr_pull_credential >/dev/null
  local token auth namespace
  IFS= read -r token <"$GHCR_PULL_TOKEN_FILE" \
    || fail 'GHCR pull credential could not be read'
  auth="$(printf '%s:%s' "$GHCR_USERNAME" "$token" | base64 -w 0)"
  unset token
  local namespaces=("$APP_NAMESPACE")
  if [[ "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate' 2>/dev/null || true)" == passed ]]; then
    namespaces+=("$EDGE_NAMESPACE")
  fi
  for namespace in "${namespaces[@]}"; do
    {
      printf '{"auths":{"%s":{"username":"%s","auth":"' \
        "$GHCR_REGISTRY" "$GHCR_USERNAME"
      printf '%s' "$auth"
      printf '"}}}'
    } | kube -n "$namespace" create secret generic "$GHCR_PULL_SECRET" \
        --type=kubernetes.io/dockerconfigjson \
        --from-file=.dockerconfigjson=/dev/stdin \
        --dry-run=client -o yaml \
      | kube apply -f - >/dev/null
    [[ "$(kube -n "$namespace" get secret "$GHCR_PULL_SECRET" \
      -o jsonpath='{.type}')" == 'kubernetes.io/dockerconfigjson' ]] \
      || fail "GHCR pull Secret has an unexpected Kubernetes type in ${namespace}"
    secret_has_keys "$namespace" "$GHCR_PULL_SECRET" .dockerconfigjson
  done
  unset auth
}

attach_edge_pull_credential() {
  kube -n "$EDGE_NAMESPACE" patch serviceaccount blindou-cloudflared \
    --type=merge --patch \
    "{\"imagePullSecrets\":[{\"name\":\"${GHCR_PULL_SECRET}\"}]}" >/dev/null
  kube -n "$EDGE_NAMESPACE" patch deployment blindou-cloudflared \
    --type=merge --patch \
    "{\"spec\":{\"template\":{\"spec\":{\"imagePullSecrets\":[{\"name\":\"${GHCR_PULL_SECRET}\"}]}}}}" \
    >/dev/null
}

generate_database_material() {
  install -d -o root -g root -m 0700 \
    "$DATABASE_SECRET_DIR" "$CLIENT_CA_DIR" "$CLIENT_CERT_DIR"
  if [[ ! -f "$DATABASE_CREDENTIALS" ]]; then
    {
      printf 'BLINDOU_MIGRATION_PASSWORD=%s\n' "$(openssl rand -hex 32)"
      printf 'BLINDOU_RUNTIME_PASSWORD=%s\n' "$(openssl rand -hex 32)"
      printf 'BLINDOU_REDIRECT_PASSWORD=%s\n' "$(openssl rand -hex 32)"
      printf 'BLINDOU_ML_PASSWORD=%s\n' "$(openssl rand -hex 32)"
    } >"${DATABASE_CREDENTIALS}.tmp"
    install -o root -g root -m 0600 "${DATABASE_CREDENTIALS}.tmp" "$DATABASE_CREDENTIALS"
    rm -f -- "${DATABASE_CREDENTIALS}.tmp"
  fi
  [[ -f "$DATABASE_CREDENTIALS" && ! -L "$DATABASE_CREDENTIALS" \
      && "$(stat -c '%U:%G:%a' "$DATABASE_CREDENTIALS")" == 'root:root:600' ]] \
    || fail 'arquivo de credenciais do banco inválido'

  if [[ ! -f "${CLIENT_CA_DIR}/client-ca.key" ]]; then
    cleanup_paths+=(
      "${CLIENT_CA_DIR}/client-ca.key.tmp"
      "${CLIENT_CA_DIR}/client-ca.crt.tmp"
    )
    openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
      -subj '/CN=Blindou PostgreSQL Client CA' \
      -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
      -addext 'keyUsage=critical,keyCertSign,cRLSign' \
      -keyout "${CLIENT_CA_DIR}/client-ca.key.tmp" \
      -out "${CLIENT_CA_DIR}/client-ca.crt.tmp" >/dev/null 2>&1
    install -o root -g root -m 0600 \
      "${CLIENT_CA_DIR}/client-ca.key.tmp" "${CLIENT_CA_DIR}/client-ca.key"
    install -o root -g root -m 0644 \
      "${CLIENT_CA_DIR}/client-ca.crt.tmp" "${CLIENT_CA_DIR}/client-ca.crt"
    rm -f -- "${CLIENT_CA_DIR}/client-ca.key.tmp" "${CLIENT_CA_DIR}/client-ca.crt.tmp"
  fi
  if [[ ! -f "$CLIENT_KEY_FILE" ]]; then
    local extension_file
    extension_file="$(mktemp "${CLIENT_CA_DIR}/client-ext.XXXXXX")"
    cleanup_paths+=(
      "$extension_file"
      "${CLIENT_CERT_DIR}/tls.key.tmp"
      "${CLIENT_CERT_DIR}/client.csr.tmp"
      "${CLIENT_CERT_DIR}/tls.crt.tmp"
    )
    cat >"$extension_file" <<'EOF'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=clientAuth
subjectAltName=DNS:blindou-k3s-clients
EOF
    openssl req -new -newkey rsa:3072 -sha256 -nodes \
      -subj '/CN=blindou-k3s-clients' \
      -keyout "${CLIENT_CERT_DIR}/tls.key.tmp" \
      -out "${CLIENT_CERT_DIR}/client.csr.tmp" >/dev/null 2>&1
    openssl x509 -req -sha256 -days 397 \
      -in "${CLIENT_CERT_DIR}/client.csr.tmp" \
      -CA "${CLIENT_CA_DIR}/client-ca.crt" \
      -CAkey "${CLIENT_CA_DIR}/client-ca.key" -CAcreateserial \
      -extfile "$extension_file" \
      -out "${CLIENT_CERT_DIR}/tls.crt.tmp" >/dev/null 2>&1
    install -o root -g root -m 0600 "${CLIENT_CERT_DIR}/tls.key.tmp" "$CLIENT_KEY_FILE"
    install -o root -g root -m 0644 "${CLIENT_CERT_DIR}/tls.crt.tmp" "$CLIENT_CERT_FILE"
    rm -f -- "${CLIENT_CERT_DIR}/tls.key.tmp" "${CLIENT_CERT_DIR}/tls.crt.tmp" \
      "${CLIENT_CERT_DIR}/client.csr.tmp" "$extension_file"
  fi
  install -o root -g root -m 0644 "$POSTGRES_SERVER_CERT" "$SERVER_CA_FILE"
  install -o root -g postgres -m 0640 \
    "${CLIENT_CA_DIR}/client-ca.crt" "$POSTGRES_CA_FILE"
}

load_database_credentials() {
  [[ -f "$DATABASE_CREDENTIALS" && ! -L "$DATABASE_CREDENTIALS" ]] \
    || fail 'credenciais do banco ausentes'
  if grep -Ev '^(BLINDOU_MIGRATION_PASSWORD|BLINDOU_RUNTIME_PASSWORD|BLINDOU_REDIRECT_PASSWORD|BLINDOU_ML_PASSWORD)=[0-9a-f]{64}$' \
      "$DATABASE_CREDENTIALS" | grep -q .; then
    fail 'formato das credenciais do banco inválido'
  fi
  [[ "$(wc -l <"$DATABASE_CREDENTIALS")" == '4' ]] \
    || fail 'quantidade de credenciais do banco inválida'
  # shellcheck disable=SC1090
  source "$DATABASE_CREDENTIALS"
}

install_postgres_client_auth() {
  cleanup_paths+=("${POSTGRES_CONFIG_FILE}.tmp" "${POSTGRES_HBA_FILE}.tmp")
  cat >"${POSTGRES_CONFIG_FILE}.tmp" <<EOF
# Blindou: CA exclusiva para autenticação adicional dos clientes K3s.
ssl_ca_file = '${POSTGRES_CA_FILE}'
EOF
  install -o root -g root -m 0644 "${POSTGRES_CONFIG_FILE}.tmp" "$POSTGRES_CONFIG_FILE"
  rm -f -- "${POSTGRES_CONFIG_FILE}.tmp"
  cat >"${POSTGRES_HBA_FILE}.tmp" <<'EOF'
# Blindou: TLS + certificado de cliente confiável + SCRAM por identidade.
hostssl blindou blindou_migration_login 10.42.0.0/16 scram-sha-256 clientcert=verify-ca
hostssl blindou blindou_runtime_login   10.42.0.0/16 scram-sha-256 clientcert=verify-ca
hostssl blindou blindou_redirect_login  10.42.0.0/16 scram-sha-256 clientcert=verify-ca
hostssl blindou blindou_ml_login        10.42.0.0/16 scram-sha-256 clientcert=verify-ca
EOF
  install -o postgres -g postgres -m 0640 "${POSTGRES_HBA_FILE}.tmp" "$POSTGRES_HBA_FILE"
  rm -f -- "${POSTGRES_HBA_FILE}.tmp"
  if ! grep -Fxq 'include_if_exists "pg_hba_blindou.conf"' "$POSTGRES_HBA_MAIN" \
      || grep -Fxq "include_if_exists 'pg_hba_blindou.conf'" "$POSTGRES_HBA_MAIN"; then
    local timestamp hba_tmp
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    install -d -o root -g root -m 0700 "${BACKUP_ROOT}/postgres-config/${timestamp}"
    install -o root -g root -m 0600 "$POSTGRES_HBA_MAIN" \
      "${BACKUP_ROOT}/postgres-config/${timestamp}/pg_hba.conf"
    hba_tmp="$(mktemp)"
    {
      printf '%s\n' 'include_if_exists "pg_hba_blindou.conf"'
      grep -Fvx 'include_if_exists "pg_hba_blindou.conf"' "$POSTGRES_HBA_MAIN" \
        | grep -Fvx "include_if_exists 'pg_hba_blindou.conf'"
    } >"$hba_tmp"
    install -o postgres -g postgres -m 0640 "$hba_tmp" "$POSTGRES_HBA_MAIN"
    rm -f -- "$hba_tmp"
  fi
  pg_ctlcluster 18 main reload
  sleep 1
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_file_settings WHERE error IS NOT NULL")" == '0' ]] \
    || fail 'PostgreSQL recusou a configuração Blindou'
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_hba_file_rules WHERE error IS NOT NULL")" == '0' ]] \
    || fail 'PostgreSQL recusou a regra HBA Blindou'
}

create_database_roles() {
  load_database_credentials
  postgres_query -d postgres \
    --set=migration_password="$BLINDOU_MIGRATION_PASSWORD" \
    --set=runtime_password="$BLINDOU_RUNTIME_PASSWORD" \
    --set=redirect_password="$BLINDOU_REDIRECT_PASSWORD" \
    --set=ml_password="$BLINDOU_ML_PASSWORD" <<'SQL' >/dev/null
SELECT format('CREATE ROLE %I NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS', role_name)
FROM (VALUES
  ('blindou_migrator'),
  ('blindou_runtime'),
  ('blindou_app'),
  ('blindou_auth'),
  ('blindou_redirector')
) AS roles(role_name)
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = role_name)
\gexec
SELECT format('CREATE ROLE blindou_migration_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'migration_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_migration_login')
\gexec
SELECT format('CREATE ROLE blindou_runtime_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'runtime_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_runtime_login')
\gexec
SELECT format('CREATE ROLE blindou_redirect_login LOGIN INHERIT PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS', :'redirect_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_redirect_login')
\gexec
SELECT format('CREATE ROLE blindou_ml_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'ml_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_ml_login')
\gexec
ALTER ROLE blindou_migration_login PASSWORD :'migration_password';
ALTER ROLE blindou_runtime_login PASSWORD :'runtime_password';
ALTER ROLE blindou_redirect_login INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD :'redirect_password';
ALTER ROLE blindou_ml_login PASSWORD :'ml_password';
GRANT blindou_migrator TO blindou_migration_login;
GRANT blindou_runtime TO blindou_runtime_login;
GRANT blindou_app TO blindou_redirect_login;
GRANT blindou_redirector TO blindou_redirect_login;
GRANT blindou_app TO blindou_ml_login;
SELECT 'CREATE DATABASE blindou OWNER blindou_migration_login ENCODING ''UTF8'' TEMPLATE template0'
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'blindou')
\gexec
REVOKE ALL ON DATABASE blindou FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE blindou TO blindou_migration_login, blindou_runtime_login, blindou_redirect_login, blindou_ml_login;
SQL
}

redirector_least_privilege_migration_applied() {
  [[ "$(postgres_query -d blindou -Atqc \
    "SELECT to_regclass('public._sqlx_migrations') IS NOT NULL")" == 't' ]] \
    || return 1
  [[ "$(postgres_query -d blindou -Atqc \
    "SELECT count(*) FROM public._sqlx_migrations WHERE version=12 AND success")" == '1' ]]
}

prepare_redirector_database_role() {
  postgres_query -d postgres <<'SQL' >/dev/null
SELECT 'CREATE ROLE blindou_redirector NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS'
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_redirector')
\gexec
ALTER ROLE blindou_redirector NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
ALTER ROLE blindou_redirect_login INHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
REVOKE blindou_runtime, blindou_app FROM blindou_redirector;
GRANT blindou_redirector TO blindou_redirect_login;
SQL
}

reconcile_redirector_database_role() {
  prepare_redirector_database_role
  if redirector_least_privilege_migration_applied; then
    postgres_query -d postgres <<'SQL' >/dev/null
REVOKE blindou_app FROM blindou_redirect_login;
GRANT blindou_redirector TO blindou_redirect_login;
SQL
  else
    postgres_query -d postgres <<'SQL' >/dev/null
GRANT blindou_app TO blindou_redirect_login;
GRANT blindou_redirector TO blindou_redirect_login;
SQL
  fi
}

provision_database_extensions() {
  postgres_query -d blindou <<'SQL' >/dev/null
CREATE EXTENSION IF NOT EXISTS pg_stat_statements WITH SCHEMA public;
COMMENT ON EXTENSION pg_stat_statements IS
  'track planning and execution statistics of all SQL statements executed';
SQL
}

write_database_urls() {
  load_database_credentials
  local query_suffix
  query_suffix='sslmode=verify-full&sslrootcert=/etc/blindou/postgres/ca.crt&sslcert=/etc/blindou/postgres/tls.crt&sslkey=/etc/blindou/postgres/tls.key'
  {
    printf 'MIGRATION_DATABASE_URL=postgresql://blindou_migration_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_MIGRATION_PASSWORD" "$query_suffix"
    printf 'DATABASE_URL=postgresql://blindou_runtime_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_RUNTIME_PASSWORD" "$query_suffix"
    printf 'REDIRECTOR_DATABASE_URL=postgresql://blindou_redirect_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_REDIRECT_PASSWORD" "$query_suffix"
    printf 'ML_CONNECTOR_DATABASE_URL=postgresql://blindou_ml_login:%s@192.168.100.59:5432/blindou?%s\n' \
      "$BLINDOU_ML_PASSWORD" "$query_suffix"
  } >"${DATABASE_SECRET_DIR}/urls.env.tmp"
  install -o root -g root -m 0600 \
    "${DATABASE_SECRET_DIR}/urls.env.tmp" "${DATABASE_SECRET_DIR}/urls.env"
  rm -f -- "${DATABASE_SECRET_DIR}/urls.env.tmp"
}

verify_data_foundation() {
  require_root_and_host
  local hba_rule_count hba_diagnostic redirector_contract
  [[ -f "$DATABASE_CREDENTIALS" && "$(stat -c '%U:%G:%a' "$DATABASE_CREDENTIALS")" == 'root:root:600' ]] \
    || fail 'credenciais do banco ausentes ou expostas'
  [[ -f "${DATABASE_SECRET_DIR}/urls.env" \
      && "$(stat -c '%U:%G:%a' "${DATABASE_SECRET_DIR}/urls.env")" == 'root:root:600' ]] \
    || fail 'URLs do banco ausentes ou expostas'
  openssl verify -CAfile "${CLIENT_CA_DIR}/client-ca.crt" "$CLIENT_CERT_FILE" >/dev/null \
    || fail 'certificado cliente PostgreSQL inválido'
  [[ "$(stat -c '%U:%G:%a' "$CLIENT_KEY_FILE")" == 'root:root:600' ]] \
    || fail 'chave cliente PostgreSQL exposta'
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_database WHERE datname='blindou'")" == '1' ]] \
    || fail 'database Blindou ausente'
  [[ "$(postgres_query -d blindou -Atqc \
    "SELECT count(*) FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace JOIN pg_roles r ON r.oid=e.extowner WHERE e.extname='pg_stat_statements' AND n.nspname='public' AND r.rolname='postgres'")" == '1' ]] \
    || fail 'extensão administrativa pg_stat_statements ausente ou com autoridade divergente'
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_roles WHERE rolname IN ('blindou_migration_login','blindou_runtime_login','blindou_redirect_login','blindou_ml_login') AND rolcanlogin AND rolinherit AND NOT rolsuper AND NOT rolcreatedb AND NOT rolcreaterole AND NOT rolreplication AND NOT rolbypassrls")" == '4' ]] \
    || fail 'logins Blindou ausentes ou privilegiados'
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_auth_members m JOIN pg_roles member ON member.oid=m.member JOIN pg_roles role ON role.oid=m.roleid WHERE (member.rolname,role.rolname) IN (('blindou_migration_login','blindou_migrator'),('blindou_runtime_login','blindou_runtime'),('blindou_ml_login','blindou_app'))")" == '3' ]] \
    || fail 'associação dos papéis principais Blindou divergente'
  if redirector_least_privilege_migration_applied; then
    redirector_contract='dedicated'
    [[ "$(postgres_query -d postgres -Atqc \
      "SELECT count(*) FROM pg_roles AS role WHERE role.rolname='blindou_redirector' AND NOT role.rolcanlogin AND NOT role.rolsuper AND NOT role.rolcreatedb AND NOT role.rolcreaterole AND NOT role.rolreplication AND NOT role.rolbypassrls AND NOT EXISTS (SELECT 1 FROM pg_auth_members AS membership WHERE membership.member=role.oid)")" == '1' ]] \
      || fail 'papel dedicado do redirector ausente ou privilegiado'
    [[ "$(postgres_query -d postgres -Atqc \
      "SELECT count(*) FROM pg_auth_members m JOIN pg_roles member ON member.oid=m.member JOIN pg_roles role ON role.oid=m.roleid WHERE member.rolname='blindou_redirect_login' AND role.rolname='blindou_redirector'")" == '1' ]] \
      || fail 'login do redirector não recebeu o papel dedicado'
    [[ "$(postgres_query -d postgres -Atqc \
      "SELECT count(*) FROM pg_auth_members m JOIN pg_roles member ON member.oid=m.member JOIN pg_roles role ON role.oid=m.roleid WHERE member.rolname='blindou_redirect_login' AND role.rolname IN ('blindou_app','blindou_runtime')")" == '0' ]] \
      || fail 'login do redirector ainda herda papel geral depois da migration 0012'
  else
    redirector_contract='legacy'
    [[ "$(postgres_query -d postgres -Atqc \
      "SELECT count(*) FROM pg_auth_members m JOIN pg_roles member ON member.oid=m.member JOIN pg_roles role ON role.oid=m.roleid WHERE member.rolname='blindou_redirect_login' AND role.rolname='blindou_app'")" == '1' ]] \
      || fail 'papel legado do redirector ausente antes da migration 0012'
    if [[ "$(postgres_query -d postgres -Atqc \
      "SELECT count(*) FROM pg_roles WHERE rolname='blindou_redirector'")" != '0' ]]; then
      [[ "$(postgres_query -d postgres -Atqc \
        "SELECT count(*) FROM pg_roles AS role WHERE role.rolname='blindou_redirector' AND NOT role.rolcanlogin AND NOT role.rolsuper AND NOT role.rolcreatedb AND NOT role.rolcreaterole AND NOT role.rolreplication AND NOT role.rolbypassrls AND NOT EXISTS (SELECT 1 FROM pg_auth_members AS membership WHERE membership.member=role.oid)")" == '1' ]] \
        || fail 'papel de transição do redirector está privilegiado'
    fi
  fi
  [[ "$(postgres_query -d postgres -Atqc 'SHOW ssl_ca_file')" == "$POSTGRES_CA_FILE" ]] \
    || fail 'PostgreSQL não usa a CA cliente Blindou'
  hba_rule_count="$(postgres_query -d postgres -Atqc \
    "SELECT count(*)
       FROM pg_hba_file_rules
      WHERE file_name='${POSTGRES_HBA_FILE}'
        AND type='hostssl'
        AND database=ARRAY['blindou']::text[]
        AND user_name <@ ARRAY['blindou_migration_login','blindou_runtime_login','blindou_redirect_login','blindou_ml_login']::text[]
        AND cardinality(user_name)=1
        AND address='10.42.0.0'
        AND netmask='255.255.0.0'
        AND auth_method='scram-sha-256'
        AND options @> ARRAY['clientcert=verify-ca']::text[]
        AND error IS NULL")"
  if [[ "$hba_rule_count" != '4' ]]; then
    hba_diagnostic="$(postgres_query -d postgres -Atqc \
      "SELECT coalesce(string_agg(
          concat_ws('|', file_name, type, array_to_string(database, ','),
                    array_to_string(user_name, ','), address, netmask,
                    auth_method, array_to_string(options, ','), coalesce(error, 'ok')),
          ';' ORDER BY rule_number), 'nenhuma')
         FROM pg_hba_file_rules
        WHERE file_name='${POSTGRES_HBA_FILE}' OR database @> ARRAY['blindou']::text[]")"
    fail "HBA não exige TLS, certificado e SCRAM para os quatro logins (regras válidas=${hba_rule_count}; observadas=${hba_diagnostic})"
  fi
  /usr/local/sbin/apiwpp-deployctl verify >/dev/null \
    || fail 'apiwpp regrediu depois do provisionamento do banco'
  pass "database, quatro logins, TLS cliente e papéis isolados verificados (redirector=${redirector_contract})"
}

provision_data_foundation() {
  [[ "${1:-}" == "$DATA_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${DATA_CONFIRMATION}"
  require_platform_preconditions
  generate_database_material
  install_postgres_client_auth
  create_database_roles
  provision_database_extensions
  write_database_urls
  reconcile_redirector_database_role
  verify_data_foundation
  pass 'fundação de dados Blindou provisionada sem executar migrations'
}

rollback_data_foundation() {
  [[ "${1:-}" == "$DATA_ROLLBACK_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${DATA_ROLLBACK_CONFIRMATION}"
  require_root_and_host
  local user_table_count
  user_table_count="$(postgres_query -d blindou -Atqc \
    "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind IN ('r','p') AND n.nspname NOT IN ('pg_catalog','information_schema')")"
  [[ "$user_table_count" == '0' ]] \
    || fail 'rollback de dados recusado: database já contém tabelas de aplicação'
  postgres_query -d postgres <<'SQL' >/dev/null
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname='blindou' AND pid <> pg_backend_pid();
DROP DATABASE IF EXISTS blindou;
DROP ROLE IF EXISTS blindou_migration_login, blindou_runtime_login, blindou_redirect_login, blindou_ml_login;
DROP ROLE IF EXISTS blindou_migrator, blindou_runtime, blindou_app, blindou_auth, blindou_redirector;
SQL
  rm -f -- "$POSTGRES_CONFIG_FILE" "$POSTGRES_HBA_FILE"
  local hba_tmp
  hba_tmp="$(mktemp)"
  grep -Fvx 'include_if_exists "pg_hba_blindou.conf"' "$POSTGRES_HBA_MAIN" \
    | grep -Fvx "include_if_exists 'pg_hba_blindou.conf'" >"$hba_tmp"
  install -o postgres -g postgres -m 0640 "$hba_tmp" "$POSTGRES_HBA_MAIN"
  rm -f -- "$hba_tmp"
  pg_ctlcluster 18 main reload
  rm -rf -- "$DATABASE_SECRET_DIR" "$CLIENT_CA_DIR" "$CLIENT_CERT_DIR"
  pass 'database vazio, logins e configuração PostgreSQL Blindou removidos'
}

backup_database() {
  [[ "${1:-}" == "$BACKUP_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${BACKUP_CONFIRMATION}"
  require_root_and_host
  verify_data_foundation >/dev/null
  [[ -f "$BACKUP_RECIPIENT_CERT" && ! -L "$BACKUP_RECIPIENT_CERT" ]] \
    || fail 'certificado público de recuperação ausente'
  openssl x509 -checkend 2592000 -noout -in "$BACKUP_RECIPIENT_CERT" >/dev/null \
    || fail 'certificado de recuperação expira em menos de 30 dias'
  local timestamp backup_id temporary_dir plain_dump encrypted_tmp encrypted_file manifest
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_id="blindou-${timestamp}"
  install -d -o root -g root -m 0700 "$DATABASE_BACKUP_ROOT"
  temporary_dir="$(mktemp -d --tmpdir="$DATABASE_PLAINTEXT_TMP_ROOT" \
    "blindou-backup.${backup_id}.XXXXXXXXXX")"
  chown postgres:postgres "$temporary_dir"
  chmod 0700 "$temporary_dir"
  cleanup_paths+=("$temporary_dir")
  plain_dump="${temporary_dir}/blindou.dump"
  runuser -u postgres -- pg_dump --dbname=blindou --format=custom \
    --compress=zstd:6 --file="$plain_dump"
  runuser -u postgres -- pg_restore --list "$plain_dump" >/dev/null \
    || fail 'catálogo do dump lógico é inválido'
  chown root:root "$plain_dump"
  chmod 0600 "$plain_dump"
  encrypted_tmp="${DATABASE_BACKUP_ROOT}/${backup_id}.dump.cms.tmp"
  cleanup_paths+=("$encrypted_tmp")
  encrypted_file="${DATABASE_BACKUP_ROOT}/${backup_id}.dump.cms"
  openssl cms -encrypt -binary -stream -aes-256-gcm \
    -in "$plain_dump" -out "$encrypted_tmp" -outform DER \
    "$BACKUP_RECIPIENT_CERT"
  chmod 0600 "$encrypted_tmp"
  openssl cms -cmsout -inform DER -in "$encrypted_tmp" -noout >/dev/null \
    || fail 'envelope CMS do backup é inválido'
  mv "$encrypted_tmp" "$encrypted_file"
  manifest="${DATABASE_BACKUP_ROOT}/${backup_id}.manifest"
  {
    printf 'schema=1\n'
    printf 'project=blindou\n'
    printf 'database=blindou\n'
    printf 'backup_id=%s\n' "$backup_id"
    printf 'created_at_utc=%s\n' "$timestamp"
    printf 'encryption=cms-aes-256-gcm\n'
    printf 'encrypted_sha256=%s\n' "$(sha256sum "$encrypted_file" | awk '{print $1}')"
    printf 'encrypted_size=%s\n' "$(stat -c '%s' "$encrypted_file")"
    printf 'plaintext_catalog_verified=true\n'
  } >"${manifest}.tmp"
  install -o root -g root -m 0600 "${manifest}.tmp" "$manifest"
  rm -f -- "${manifest}.tmp" "$plain_dump"
  rmdir -- "$temporary_dir"
  printf '%s\n' "$backup_id" >"${DATABASE_BACKUP_ROOT}/latest.tmp"
  install -o root -g root -m 0600 \
    "${DATABASE_BACKUP_ROOT}/latest.tmp" "${DATABASE_BACKUP_ROOT}/latest"
  rm -f -- "${DATABASE_BACKUP_ROOT}/latest.tmp"
  pass "backup lógico criptografado criado: ${backup_id}"
}

verify_latest_backup() {
  require_root_and_host
  [[ -f "${DATABASE_BACKUP_ROOT}/latest" && ! -L "${DATABASE_BACKUP_ROOT}/latest" ]] \
    || fail 'marcador do backup Blindou ausente'
  local backup_id encrypted_file manifest expected_sha expected_size
  backup_id="$(<"${DATABASE_BACKUP_ROOT}/latest")"
  [[ "$backup_id" =~ ^blindou-[0-9]{8}T[0-9]{6}Z$ ]] \
    || fail 'identificador do backup inválido'
  encrypted_file="${DATABASE_BACKUP_ROOT}/${backup_id}.dump.cms"
  manifest="${DATABASE_BACKUP_ROOT}/${backup_id}.manifest"
  [[ -f "$encrypted_file" && ! -L "$encrypted_file" \
      && "$(stat -c '%U:%G:%a' "$encrypted_file")" == 'root:root:600' ]] \
    || fail 'arquivo de backup ausente ou exposto'
  [[ -f "$manifest" && ! -L "$manifest" ]] || fail 'manifesto do backup ausente'
  expected_sha="$(sed -n 's/^encrypted_sha256=//p' "$manifest")"
  expected_size="$(sed -n 's/^encrypted_size=//p' "$manifest")"
  [[ "$expected_sha" =~ ^[0-9a-f]{64}$ \
      && "$(sha256sum "$encrypted_file" | awk '{print $1}')" == "$expected_sha" ]] \
    || fail 'checksum do backup diverge'
  [[ "$expected_size" =~ ^[0-9]+$ \
      && "$(stat -c '%s' "$encrypted_file")" == "$expected_size" ]] \
    || fail 'tamanho do backup diverge'
  grep -Fxq 'encryption=cms-aes-256-gcm' "$manifest" \
    || fail 'algoritmo de criptografia do backup diverge'
  grep -Fxq 'plaintext_catalog_verified=true' "$manifest" \
    || fail 'catálogo do dump não foi validado antes da criptografia'
  openssl cms -cmsout -inform DER -in "$encrypted_file" -noout >/dev/null \
    || fail 'envelope criptografado inválido'
  pass "backup lógico criptografado verificado: ${backup_id}"
}

export_latest_backup() {
  verify_latest_backup >/dev/null
  local backup_id export_dir encrypted_file manifest
  backup_id="$(<"${DATABASE_BACKUP_ROOT}/latest")"
  encrypted_file="${DATABASE_BACKUP_ROOT}/${backup_id}.dump.cms"
  manifest="${DATABASE_BACKUP_ROOT}/${backup_id}.manifest"
  if [[ -e "$BACKUP_EXPORT_ROOT" ]]; then
    [[ -d "$BACKUP_EXPORT_ROOT" && ! -L "$BACKUP_EXPORT_ROOT" \
        && "$(stat -c '%U:%G:%a' "$BACKUP_EXPORT_ROOT")" == 'root:apiadmin:750' ]] \
      || fail 'outbox de backup possui owner ou modo inesperado'
  else
    install -d -o root -g apiadmin -m 0750 "$BACKUP_EXPORT_ROOT"
  fi
  export_dir="${BACKUP_EXPORT_ROOT}/${backup_id}"
  if [[ -e "$export_dir" ]]; then
    [[ -d "$export_dir" && ! -L "$export_dir" \
        && "$(stat -c '%U:%G:%a' "$export_dir")" == 'root:apiadmin:750' ]] \
      || fail 'diretorio exportado possui owner ou modo inesperado'
  else
    install -d -o root -g apiadmin -m 0750 "$export_dir"
  fi
  install -o root -g apiadmin -m 0640 \
    "$encrypted_file" "${export_dir}/${backup_id}.dump.cms"
  install -o root -g apiadmin -m 0640 \
    "$manifest" "${export_dir}/${backup_id}.manifest"
  install -o root -g apiadmin -m 0640 \
    "$BACKUP_RECIPIENT_CERT" "${export_dir}/recovery-recipient.crt"
  [[ "$(sha256sum "${export_dir}/${backup_id}.dump.cms" | awk '{print $1}')" \
      == "$(sha256sum "$encrypted_file" | awk '{print $1}')" ]] \
    || fail 'copia exportada do backup diverge da origem'
  pass "backup criptografado exportado para leitura: ${export_dir}"
}

read_field() {
  local key="$1" manifest="$2" count
  count="$(grep -Ec "^${key}=[^=[:cntrl:]]*$" "$manifest" || true)"
  [[ "$count" == '1' ]] || return 1
  sed -n "s/^${key}=//p" "$manifest"
}

verify_apiadmin_file() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" && "$(stat -c '%U' "$path")" == 'apiadmin' ]]
}

cache_release() {
  local release_id="$1"
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id inválido'
  local release_dir manifest signature archive schema project signed_release revision bundle_sha source_state cached_dir verify_dir
  release_dir="${RELEASE_INBOX}/${release_id}"
  manifest="${release_dir}/release.manifest"
  signature="${release_dir}/release.manifest.sig"
  archive="${release_dir}/rendered.tar.gz"
  [[ -d "$release_dir" && ! -L "$release_dir" \
      && "$(stat -c '%U' "$release_dir")" == 'apiadmin' ]] \
    || fail 'diretório de release ausente ou com owner inválido'
  verify_apiadmin_file "$manifest" || fail 'manifesto de release inválido'
  verify_apiadmin_file "$signature" || fail 'assinatura de release inválida'
  verify_apiadmin_file "$archive" || fail 'archive de release inválido'
  [[ "$(stat -c '%s' "$manifest")" -le 4096 \
      && "$(stat -c '%s' "$archive")" -le 52428800 ]] \
    || fail 'artefato de release excede o limite'
  ssh-keygen -Y verify -f "$ALLOWED_SIGNERS" -I blindou-local -n blindou-deploy \
    -s "$signature" <"$manifest" >/dev/null \
    || fail 'assinatura da release não foi aceita'
  schema="$(read_field schema "$manifest")" || fail 'schema ausente'
  project="$(read_field project "$manifest")" || fail 'project ausente'
  signed_release="$(read_field release_id "$manifest")" || fail 'release_id ausente'
  revision="$(read_field revision "$manifest")" || fail 'revision ausente'
  bundle_sha="$(read_field bundle_sha256 "$manifest")" || fail 'bundle_sha256 ausente'
  source_state="$(read_field source_state "$manifest")" || fail 'source_state ausente'
  [[ "$schema" == '1' && "$project" == 'blindou' \
      && "$signed_release" == "$release_id" && "$revision" == "$release_id" \
      && "$bundle_sha" =~ ^[0-9a-f]{64}$ && "$source_state" == 'clean' ]] \
    || fail 'campos do manifesto assinado divergem do contrato'

  install -d -o root -g root -m 0700 "$RELEASE_CACHE" "$RELEASE_HISTORY"
  cached_dir="${RELEASE_CACHE}/${release_id}"
  if [[ -e "$cached_dir" ]]; then
    [[ -d "$cached_dir" && ! -L "$cached_dir" ]] \
      || fail 'cache da release inválido'
    [[ "$(sha256sum "${cached_dir}/rendered.tar.gz" | awk '{print $1}')" == "$bundle_sha" ]] \
      || fail 'release já existe com conteúdo divergente'
  else
    install -d -o root -g root -m 0700 "$cached_dir"
    install -o root -g root -m 0600 "$manifest" "${cached_dir}/release.manifest"
    install -o root -g root -m 0600 "$signature" "${cached_dir}/release.manifest.sig"
    install -o root -g root -m 0600 "$archive" "${cached_dir}/rendered.tar.gz"
  fi
  rm -rf -- "${cached_dir}/rendered"
  verify_dir="$(mktemp -d "${RELEASE_CACHE}/.verify.${release_id}.XXXXXX")"
  cleanup_paths+=("$verify_dir")
  python3 "$RELEASE_VERIFIER" "${cached_dir}/rendered.tar.gz" "$verify_dir" \
    "$release_id" "$bundle_sha"
  mv "$verify_dir" "${cached_dir}/rendered"
  install -o root -g root -m 0600 "$manifest" "${RELEASE_HISTORY}/${release_id}.manifest"
  install -o root -g root -m 0600 "$signature" "${RELEASE_HISTORY}/${release_id}.manifest.sig"
  pass "release assinada validada e armazenada: ${release_id}"
}

secret_has_keys() {
  local namespace="$1" secret_name="$2"
  shift 2
  local keys required
  keys="$(kube -n "$namespace" get secret "$secret_name" \
    -o go-template='{{range $key, $value := .data}}{{printf "%s\n" $key}}{{end}}')" \
    || fail "Secret obrigatório ausente: ${namespace}/${secret_name}"
  for required in "$@"; do
    grep -Fxq "$required" <<<"$keys" \
      || fail "Secret ${namespace}/${secret_name} não contém ${required}"
  done
}

runtime_secret_file_is_secure() {
  local path="$1"
  [[ -f "$path" && ! -L "$path" \
    && "$(stat -c '%U:%G:%a' "$path")" == 'root:root:600' ]]
}

shopee_encryption_key_is_secure() {
  local key_file="${RUNTIME_SECRET_DIR}/SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY"
  runtime_secret_file_is_secure "$key_file" \
    && [[ "$(base64 -d <"$key_file" 2>/dev/null | wc -c)" == '32' ]]
}

write_runtime_value_to_path() {
  local path="$1" value="$2" temporary
  temporary="$(mktemp "${path}.tmp.XXXXXX")"
  cleanup_paths+=("$temporary")
  printf '%s\n' "$value" >"$temporary"
  install -o root -g root -m 0600 "$temporary" "$path"
  rm -f -- "$temporary"
}

write_runtime_value() {
  local name="$1" value="$2" path="${RUNTIME_SECRET_DIR}/${name}"
  [[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || fail 'nome de segredo de runtime inválido'
  cleanup_paths+=("${path}.tmp")
  printf '%s' "$value" >"${path}.tmp"
  install -o root -g root -m 0600 "${path}.tmp" "$path"
  rm -f -- "${path}.tmp"
}

ensure_random_hex() {
  local name="$1"
  runtime_secret_file_is_secure "${RUNTIME_SECRET_DIR}/${name}" \
    || write_runtime_value "$name" "$(openssl rand -hex 32)"
}

ensure_random_base64_key() {
  local name="$1"
  runtime_secret_file_is_secure "${RUNTIME_SECRET_DIR}/${name}" \
    || write_runtime_value "$name" "$(openssl rand -base64 32 | tr -d '\n')"
}

extract_database_url() {
  local name="$1" source="${DATABASE_SECRET_DIR}/urls.env" value
  value="$(sed -n "s/^${name}=//p" "$source")"
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
    || fail "URL de banco ausente: ${name}"
  write_runtime_value "$name" "$value"
}

generate_nats_pki() {
  install -d -o root -g root -m 0700 "$NATS_PKI_DIR"
  if [[ ! -f "${NATS_PKI_DIR}/ca.key" ]]; then
    cleanup_paths+=("${NATS_PKI_DIR}/ca.key.tmp" "${NATS_PKI_DIR}/ca.crt.tmp")
    openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
      -subj '/CN=Blindou NATS CA' \
      -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
      -addext 'keyUsage=critical,keyCertSign,cRLSign' \
      -keyout "${NATS_PKI_DIR}/ca.key.tmp" \
      -out "${NATS_PKI_DIR}/ca.crt.tmp" >/dev/null 2>&1
    install -o root -g root -m 0600 "${NATS_PKI_DIR}/ca.key.tmp" "${NATS_PKI_DIR}/ca.key"
    install -o root -g root -m 0644 "${NATS_PKI_DIR}/ca.crt.tmp" "${NATS_PKI_DIR}/ca.crt"
    rm -f -- "${NATS_PKI_DIR}/ca.key.tmp" "${NATS_PKI_DIR}/ca.crt.tmp"
  fi
  if [[ ! -f "${NATS_PKI_DIR}/tls.key" ]]; then
    local extension_file
    extension_file="$(mktemp "${NATS_PKI_DIR}/server-ext.XXXXXX")"
    cleanup_paths+=("$extension_file")
    cleanup_paths+=(
      "${NATS_PKI_DIR}/tls.key.tmp" "${NATS_PKI_DIR}/tls.crt.tmp"
      "${NATS_PKI_DIR}/server.csr.tmp"
    )
    cat >"$extension_file" <<'EOF'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=DNS:blindou-nats,DNS:blindou-nats.blindou-production,DNS:blindou-nats.blindou-production.svc,DNS:blindou-nats.blindou-production.svc.cluster.local
EOF
    openssl req -new -newkey rsa:3072 -sha256 -nodes \
      -subj '/CN=blindou-nats.blindou-production.svc' \
      -keyout "${NATS_PKI_DIR}/tls.key.tmp" \
      -out "${NATS_PKI_DIR}/server.csr.tmp" >/dev/null 2>&1
    openssl x509 -req -sha256 -days 397 \
      -in "${NATS_PKI_DIR}/server.csr.tmp" \
      -CA "${NATS_PKI_DIR}/ca.crt" -CAkey "${NATS_PKI_DIR}/ca.key" \
      -CAcreateserial -extfile "$extension_file" \
      -out "${NATS_PKI_DIR}/tls.crt.tmp" >/dev/null 2>&1
    install -o root -g root -m 0600 "${NATS_PKI_DIR}/tls.key.tmp" "${NATS_PKI_DIR}/tls.key"
    install -o root -g root -m 0644 "${NATS_PKI_DIR}/tls.crt.tmp" "${NATS_PKI_DIR}/tls.crt"
    rm -f -- "${NATS_PKI_DIR}/tls.key.tmp" "${NATS_PKI_DIR}/tls.crt.tmp" \
      "${NATS_PKI_DIR}/server.csr.tmp" "$extension_file"
  fi
  openssl verify -CAfile "${NATS_PKI_DIR}/ca.crt" "${NATS_PKI_DIR}/tls.crt" >/dev/null \
    || fail 'certificado NATS inválido'
}

validate_runtime_providers() {
  local uazapi_base_url="$1" email_from="$2" response headers http_code resend_id
  response="$(mktemp /var/tmp/blindou-provider-response.XXXXXX)"
  headers="$(mktemp /var/tmp/blindou-provider-headers.XXXXXX)"
  cleanup_paths+=("$response" "$headers")
  chmod 0600 "$response" "$headers"
  printf 'admintoken: %s\n' "$(<"${RUNTIME_SECRET_DIR}/UAZAPI_ADMIN_TOKEN")" >"$headers"
  http_code="$(curl --silent --show-error --output "$response" --write-out '%{http_code}' \
    --connect-timeout 5 --max-time 20 --header "@${headers}" \
    "${uazapi_base_url%/}/instance/all")" \
    || fail 'UAZAPI não respondeu à validação autenticada'
  [[ "$http_code" == '200' ]] || fail "UAZAPI recusou a credencial (HTTP ${http_code})"
  jq -e 'type == "array" or type == "object"' "$response" >/dev/null \
    || fail 'UAZAPI retornou resposta inesperada'

  printf 'Authorization: Bearer %s\n' "$(<"${RUNTIME_SECRET_DIR}/RESEND_API_KEY")" >"$headers"
  jq -n --arg from "Blindou <${email_from}>" --arg to "$SUPERADMIN_EMAIL" \
    --arg subject 'Blindou: receptor de alertas em validação' \
    --arg text 'Este e-mail confirma o canal externo usado pelos alertas operacionais do Blindou.' \
    '{from:$from,to:[$to],subject:$subject,text:$text}' >"$response.request"
  chmod 0600 "$response.request"
  cleanup_paths+=("$response.request")
  http_code="$(curl --silent --show-error --output "$response" --write-out '%{http_code}' \
    --connect-timeout 5 --max-time 20 --request POST \
    --header "@${headers}" --header 'Content-Type: application/json' \
    --header "Idempotency-Key: blindou-alert-$(date -u +%Y%m%dT%H%M%SZ)" \
    --data-binary "@${response.request}" 'https://api.resend.com/emails')" \
    || fail 'Resend não respondeu ao envio de validação'
  [[ "$http_code" == '200' ]] || fail "Resend recusou o envio de validação (HTTP ${http_code})"
  resend_id="$(jq -er '.id | select(type == "string" and length > 0 and length <= 200)' "$response")" \
    || fail 'Resend não retornou identificador do envio'
  install -d -o root -g root -m 0700 "$STATE_ROOT"
  {
    printf 'schema=1\nstatus=pending\nrecipient=%s\nprovider=resend\n' "$SUPERADMIN_EMAIL"
    printf 'provider_message_id=%s\nsent_at_utc=%s\n' "$resend_id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${ALERT_RECEIPT}.tmp"
  install -o root -g root -m 0600 "${ALERT_RECEIPT}.tmp" "$ALERT_RECEIPT"
  rm -f -- "${ALERT_RECEIPT}.tmp" "$response" "$headers" "$response.request"
}

configure_external_alerting() {
  local email_from="$1" timestamp backup_dir prometheus_config alertmanager_config
  prometheus_config='/etc/prometheus/prometheus.yml'
  alertmanager_config='/etc/prometheus/alertmanager.yml'
  cleanup_paths+=(
    "${alertmanager_config}.tmp" "${prometheus_config}.tmp"
    /etc/prometheus/rules/blindou-platform.yml.tmp
    /etc/default/prometheus-alertmanager.tmp
  )
  if ! command -v prometheus-alertmanager >/dev/null 2>&1; then
    systemctl mask prometheus-alertmanager.service >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq prometheus-alertmanager
  fi
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_dir="${BACKUP_ROOT}/alerting/${timestamp}"
  install -d -o root -g root -m 0700 "$backup_dir"
  [[ -f "$prometheus_config" && ! -L "$prometheus_config" ]] \
    || fail 'configuração principal do Prometheus ausente'
  install -o root -g root -m 0600 "$prometheus_config" "${backup_dir}/prometheus.yml"
  [[ ! -f "$alertmanager_config" ]] \
    || install -o root -g root -m 0600 "$alertmanager_config" "${backup_dir}/alertmanager.yml"

  cat >"${alertmanager_config}.tmp" <<EOF
global:
  resolve_timeout: 5m
  smtp_smarthost: smtp.resend.com:587
  smtp_from: ${email_from}
  smtp_auth_username: resend
  smtp_auth_password: $(<"${RUNTIME_SECRET_DIR}/RESEND_API_KEY")
  smtp_require_tls: true
route:
  receiver: blindou-operations
  group_by: [alertname, service]
  group_wait: 15s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: blindou-operations
    email_configs:
      - to: ${SUPERADMIN_EMAIL}
        send_resolved: true
inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, service]
EOF
  install -o root -g prometheus -m 0640 "${alertmanager_config}.tmp" "$alertmanager_config"
  rm -f -- "${alertmanager_config}.tmp"
  install -d -o prometheus -g prometheus -m 0750 /var/lib/prometheus/alertmanager
  cat >/etc/default/prometheus-alertmanager.tmp <<'EOF'
ARGS="--config.file=/etc/prometheus/alertmanager.yml --storage.path=/var/lib/prometheus/alertmanager --web.listen-address=127.0.0.1:9093"
EOF
  install -o root -g root -m 0644 /etc/default/prometheus-alertmanager.tmp \
    /etc/default/prometheus-alertmanager
  rm -f -- /etc/default/prometheus-alertmanager.tmp
  command -v amtool >/dev/null 2>&1 || fail 'amtool não foi instalado com o Alertmanager'
  runuser -u prometheus -- amtool check-config "$alertmanager_config" >/dev/null \
    || fail 'Alertmanager recusou a configuração'

  install -d -o root -g prometheus -m 0750 /etc/prometheus/rules
  cat >/etc/prometheus/rules/blindou-platform.yml.tmp <<'EOF'
groups:
  - name: blindou-platform
    rules:
      - alert: BlindouPlatformVerificationFailed
        expr: blindou_platform_foundation_verified == 0 or blindou_platform_data_verified == 0
        for: 10m
        labels:
          severity: critical
          service: blindou-platform
        annotations:
          summary: A verificação da plataforma Blindou falhou
      - alert: BlindouPlatformMetricsAbsent
        expr: absent(blindou_platform_foundation_verified)
        for: 10m
        labels:
          severity: critical
          service: blindou-platform
        annotations:
          summary: As métricas da plataforma Blindou desapareceram
EOF
  install -o root -g prometheus -m 0640 /etc/prometheus/rules/blindou-platform.yml.tmp \
    /etc/prometheus/rules/blindou-platform.yml
  rm -f -- /etc/prometheus/rules/blindou-platform.yml.tmp
  python3 - "$prometheus_config" <<'PY'
from pathlib import Path
import sys
import yaml

path = Path(sys.argv[1])
config = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
rule_files = config.setdefault("rule_files", [])
rule_path = "/etc/prometheus/rules/blindou-platform.yml"
if rule_path not in rule_files:
    rule_files.append(rule_path)
alerting = config.setdefault("alerting", {})
managers = alerting.setdefault("alertmanagers", [])
target = {"static_configs": [{"targets": ["127.0.0.1:9093"]}]}
if target not in managers:
    managers.append(target)
temporary = path.with_suffix(path.suffix + ".tmp")
temporary.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
PY
  install -o root -g root -m 0644 "${prometheus_config}.tmp" "$prometheus_config"
  rm -f -- "${prometheus_config}.tmp"
  promtool check config "$prometheus_config" >/dev/null \
    || fail 'Prometheus recusou a integração com Alertmanager'
  systemctl unmask prometheus-alertmanager.service >/dev/null
  systemctl enable --now prometheus-alertmanager.service >/dev/null
  systemctl reload prometheus.service
  curl --fail --silent --show-error --max-time 5 \
    http://127.0.0.1:9093/-/ready >/dev/null \
    || fail 'Alertmanager não ficou Ready em loopback'
  [[ "$(ss -H -lnt 'sport = :9093' | awk '{print $4}')" == '127.0.0.1:9093' ]] \
    || fail 'Alertmanager não está restrito ao loopback IPv4'

  local synthetic_file starts_at ends_at
  synthetic_file="$(mktemp /var/tmp/blindou-alert-synthetic.XXXXXX)"
  cleanup_paths+=("$synthetic_file")
  starts_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  ends_at="$(date -u -d '+10 minutes' +%Y-%m-%dT%H:%M:%SZ)"
  jq -n --arg starts "$starts_at" --arg ends "$ends_at" \
    '[{labels:{alertname:"BlindouSyntheticReceiverTest",severity:"warning",service:"blindou-platform"},annotations:{summary:"Teste do receptor externo do Blindou"},startsAt:$starts,endsAt:$ends}]' \
    >"$synthetic_file"
  chmod 0600 "$synthetic_file"
  curl --fail --silent --show-error --max-time 10 \
    --header 'Content-Type: application/json' --data-binary "@${synthetic_file}" \
    http://127.0.0.1:9093/api/v2/alerts >/dev/null \
    || fail 'Alertmanager recusou o alerta sintético'
  {
    printf 'schema=1\nstatus=pending\nrecipient=%s\nprovider=alertmanager-resend-smtp\n' \
      "$SUPERADMIN_EMAIL"
    printf 'sent_at_utc=%s\nbackup_dir=%s\n' "$starts_at" "$backup_dir"
  } >"${ALERT_RECEIPT}.tmp"
  install -o root -g root -m 0600 "${ALERT_RECEIPT}.tmp" "$ALERT_RECEIPT"
  rm -f -- "${ALERT_RECEIPT}.tmp" "$synthetic_file"
}

