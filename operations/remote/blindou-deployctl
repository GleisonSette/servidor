      'max-time = 30' \
      'aws-sigv4 = "aws:amz:auto:s3"' \
      "user = \"${access_key}:${secret_key}\"" \
      "request = \"${method}\"" \
      "url = \"https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com/${R2_BUCKET}/${object_key}\"" \
      "output = \"${output_file}\"" \
      'write-out = "%{http_code}"'
    if [[ "$method" == 'PUT' ]]; then
      printf '%s\n' \
        "data-binary = \"@${input_file}\"" \
        'header = "Content-Type: text/plain"' \
        'header = "Cache-Control: no-store"'
    fi
  } | curl --config -
}

r2_public_get() {
  local object_key="$1" output_file="$2"
  printf '%s\n' \
    'silent' \
    'show-error' \
    'proto = "=https"' \
    'tlsv1.2' \
    'connect-timeout = 10' \
    'max-time = 30' \
    "url = \"${R2_PUBLIC_BASE_URL}/${object_key}\"" \
    "output = \"${output_file}\"" \
    'write-out = "%{http_code}"' \
    | curl --config -
}

r2_live_probe() {
  local access_key="$1" secret_key="$2" workdir object_key payload public_copy sink
  local put_code='' public_code='' delete_code='' result=0
  workdir="$(mktemp -d /var/tmp/blindou-r2-probe.XXXXXX)"
  cleanup_paths+=("$workdir")
  object_key="health/runtime-credential-$(openssl rand -hex 12).txt"
  payload="${workdir}/payload"
  public_copy="${workdir}/public"
  sink="${workdir}/sink"
  openssl rand -hex 32 >"$payload"

  put_code="$(r2_signed_request "$access_key" "$secret_key" PUT "$object_key" "$payload" "$sink")" \
    || result=1
  [[ "$put_code" == '200' ]] || result=1
  if (( result == 0 )); then
    public_code="$(r2_public_get "$object_key" "$public_copy")" || result=1
    [[ "$public_code" == '200' ]] || result=1
    if (( result == 0 )); then
      [[ "$(sha256sum "$payload" | awk '{print $1}')" == \
          "$(sha256sum "$public_copy" | awk '{print $1}')" ]] || result=1
    fi
  fi

  delete_code="$(r2_signed_request "$access_key" "$secret_key" DELETE "$object_key" /dev/null "$sink")" \
    || result=1
  [[ "$delete_code" == '200' || "$delete_code" == '204' ]] || result=1
  rm -rf -- "$workdir"
  (( result == 0 ))
}

record_r2_verification() {
  {
    printf 'schema=1\naccount_id=%s\nbucket=%s\npublic_base_url=%s\n' \
      "$R2_ACCOUNT_ID" "$R2_BUCKET" "$R2_PUBLIC_BASE_URL"
    printf 'verified_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${R2_VERIFICATION_RECEIPT}.tmp"
  cleanup_paths+=("${R2_VERIFICATION_RECEIPT}.tmp")
  install -o root -g root -m 0600 \
    "${R2_VERIFICATION_RECEIPT}.tmp" "$R2_VERIFICATION_RECEIPT"
  rm -f -- "${R2_VERIFICATION_RECEIPT}.tmp"
}

verify_r2_runtime_credential() {
  require_platform_preconditions
  r2_credential_files_are_secure \
    || fail 'credencial R2 ausente, insegura ou fora do formato esperado'
  local access_key secret_key
  IFS= read -r access_key <"$R2_ACCESS_KEY_FILE" || fail 'R2 access key ausente'
  IFS= read -r secret_key <"$R2_SECRET_KEY_FILE" || fail 'R2 secret key ausente'
  if ! r2_live_probe "$access_key" "$secret_key"; then
    unset access_key secret_key
    fail 'R2 recusou o ciclo fechado de escrita, leitura pública e exclusão'
  fi
  unset access_key secret_key
  record_r2_verification
  pass 'R2 validado por escrita, leitura pública e exclusão no bucket exclusivo do Blindou'
}

provision_r2_runtime_credential() {
  [[ "${1:-}" == "$R2_CREDENTIAL_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${R2_CREDENTIAL_CONFIRMATION}"
  [[ ! -t 0 ]] || fail 'credencial R2 deve chegar por stdin não interativo'
  require_platform_preconditions
  [[ ! -f "$CURRENT_RELEASE" ]] \
    || fail 'provisionamento inicial do R2 é fechado depois de uma release corrente'
  local app_gate
  app_gate="$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')"
  [[ "$app_gate" == 'blocked' || "$app_gate" == 'secrets-only' ]] \
    || fail 'R2 só pode ser provisionado com a aplicação bloqueada ou em secrets-only'

  local schema access_key_b64 secret_key_b64 access_key secret_key existing_access existing_secret
  IFS= read -r schema || fail 'payload R2 ausente'
  IFS= read -r access_key_b64 || fail 'R2 access key ausente'
  IFS= read -r secret_key_b64 || fail 'R2 secret key ausente'
  [[ "$schema" == 'schema=1' ]] || fail 'schema do payload R2 inválido'
  [[ "$access_key_b64" =~ ^[A-Za-z0-9+/=]{28,256}$ \
      && "$secret_key_b64" =~ ^[A-Za-z0-9+/=]{44,512}$ ]] \
    || fail 'payload base64 R2 inválido'
  access_key="$(printf '%s' "$access_key_b64" | base64 -d)" || fail 'R2 access key inválida'
  secret_key="$(printf '%s' "$secret_key_b64" | base64 -d)" || fail 'R2 secret key inválida'
  unset access_key_b64 secret_key_b64
  r2_access_key_format_is_valid "$access_key" \
    || { unset access_key secret_key; fail 'R2 access key possui formato inválido'; }
  r2_secret_key_format_is_valid "$secret_key" \
    || { unset access_key secret_key; fail 'R2 secret key possui formato inválido'; }

  if [[ -e "$R2_ACCESS_KEY_FILE" || -L "$R2_ACCESS_KEY_FILE" \
      || -e "$R2_SECRET_KEY_FILE" || -L "$R2_SECRET_KEY_FILE" ]]; then
    r2_credential_files_are_secure \
      || { unset access_key secret_key; fail 'credencial R2 existente está incompleta ou insegura'; }
    IFS= read -r existing_access <"$R2_ACCESS_KEY_FILE"
    IFS= read -r existing_secret <"$R2_SECRET_KEY_FILE"
    [[ "$existing_access" == "$access_key" && "$existing_secret" == "$secret_key" ]] \
      || { unset access_key secret_key existing_access existing_secret; fail 'uma credencial R2 diferente já está provisionada'; }
    unset access_key secret_key existing_access existing_secret
    verify_r2_runtime_credential >/dev/null
    pass 'credencial R2 já estava provisionada e foi revalidada'
    return
  fi

  if ! r2_live_probe "$access_key" "$secret_key"; then
    unset access_key secret_key
    fail 'credencial R2 recusada pelo ciclo de escrita, leitura pública e exclusão'
  fi
  install -d -o root -g root -m 0700 "$R2_SECRET_DIR"
  write_runtime_value_to_path "$R2_ACCESS_KEY_FILE" "$access_key"
  write_runtime_value_to_path "$R2_SECRET_KEY_FILE" "$secret_key"
  unset access_key secret_key
  record_r2_verification
  pass 'credencial R2 validada e guardada no cofre root-only; runtime ainda não foi publicado'
}

pagarme_secret_key_format_is_valid() {
  local value="$1"
  [[ ${#value} -ge 19 && ${#value} -le 512 \
      && "$value" =~ ^sk_[A-Za-z0-9]+$ \
      && "$value" != sk_test_* ]]
}

pagarme_webhook_secret_format_is_valid() {
  local value="$1"
  [[ ${#value} -ge 43 && ${#value} -le 256 \
      && "$value" =~ ^[A-Za-z0-9_-]+$ ]]
}

pagarme_credential_files_are_secure() {
  runtime_secret_file_is_secure "$PAGARME_SECRET_KEY_FILE" \
    && runtime_secret_file_is_secure "$PAGARME_WEBHOOK_SECRET_FILE" \
    || return 1
  [[ "$(wc -l <"$PAGARME_SECRET_KEY_FILE")" == '1' \
      && "$(wc -l <"$PAGARME_WEBHOOK_SECRET_FILE")" == '1' ]] \
    || return 1
  local secret_key webhook_secret
  IFS= read -r secret_key <"$PAGARME_SECRET_KEY_FILE" || return 1
  IFS= read -r webhook_secret <"$PAGARME_WEBHOOK_SECRET_FILE" || return 1
  pagarme_secret_key_format_is_valid "$secret_key" \
    && pagarme_webhook_secret_format_is_valid "$webhook_secret"
  local result=$?
  unset secret_key webhook_secret
  return "$result"
}

pagarme_live_probe() {
  local secret_key="$1" http_code
  http_code="$({
    printf '%s\n' \
      'silent' \
      'show-error' \
      'proto = "=https"' \
      'tlsv1.2' \
      'connect-timeout = 10' \
      'max-time = 30' \
      "user = \"${secret_key}:\"" \
      'request = "GET"' \
      "url = \"${PAGARME_API_BASE_URL}/plans?page=1&size=1\"" \
      'output = "/dev/null"' \
      'write-out = "%{http_code}"'
  } | curl --config -)" || return 1
  [[ "$http_code" == '200' ]]
}

record_pagarme_verification() {
  install -d -o root -g root -m 0700 "$STATE_ROOT"
  if [[ -e "$PAGARME_VERIFICATION_RECEIPT" \
      || -L "$PAGARME_VERIFICATION_RECEIPT" ]]; then
    runtime_secret_file_is_secure "$PAGARME_VERIFICATION_RECEIPT" \
      || fail 'recibo de validação Pagar.me existente está inseguro'
  fi
  [[ ! -e "${PAGARME_VERIFICATION_RECEIPT}.tmp" \
      && ! -L "${PAGARME_VERIFICATION_RECEIPT}.tmp" ]] \
    || fail 'arquivo temporário inesperado no recibo Pagar.me'
  {
    printf 'schema=1\nenvironment=live\nprovider=pagarme-v5\n'
    printf 'verified_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${PAGARME_VERIFICATION_RECEIPT}.tmp"
  cleanup_paths+=("${PAGARME_VERIFICATION_RECEIPT}.tmp")
  install -o root -g root -m 0600 \
    "${PAGARME_VERIFICATION_RECEIPT}.tmp" "$PAGARME_VERIFICATION_RECEIPT"
  rm -f -- "${PAGARME_VERIFICATION_RECEIPT}.tmp"
}

pagarme_runtime_receipt_is_secure() {
  [[ -f "$PAGARME_RUNTIME_RECEIPT" \
      && ! -L "$PAGARME_RUNTIME_RECEIPT" \
      && "$(stat -c '%U:%G:%a' "$PAGARME_RUNTIME_RECEIPT" 2>/dev/null)" == 'root:root:600' \
      && "$(wc -l <"$PAGARME_RUNTIME_RECEIPT")" == '5' ]] \
    || return 1
  grep -Fxq 'schema=1' "$PAGARME_RUNTIME_RECEIPT" \
    && grep -Fxq 'provider=pagarme-v5' "$PAGARME_RUNTIME_RECEIPT" \
    && grep -Fxq 'environment=live' "$PAGARME_RUNTIME_RECEIPT" \
    && grep -Eq '^release_id=[0-9a-f]{40}$' "$PAGARME_RUNTIME_RECEIPT" \
    && grep -Eq '^activated_at_utc=[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$' \
      "$PAGARME_RUNTIME_RECEIPT"
}

marketplaces_runtime_receipt_is_secure() {
  [[ -f "$MARKETPLACES_RUNTIME_RECEIPT" \
      && ! -L "$MARKETPLACES_RUNTIME_RECEIPT" \
      && "$(stat -c '%U:%G:%a' "$MARKETPLACES_RUNTIME_RECEIPT" 2>/dev/null)" == 'root:root:600' \
      && "$(wc -l <"$MARKETPLACES_RUNTIME_RECEIPT")" == '5' ]] \
