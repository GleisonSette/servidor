#!/usr/bin/env bash
set -Eeuo pipefail

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
umask 077

readonly EXPECTED_HOSTNAME='apiwpp'
readonly NODE_NAME='apiwpp'
readonly APP_NAMESPACE='blindou-production'
readonly EDGE_NAMESPACE='blindou-edge'
readonly FOUNDATION_DIR='/usr/local/lib/blindou-platform/foundation'
readonly RELEASE_VERIFIER='/usr/local/lib/blindou-platform/blindou-release-verify.py'
readonly STATE_ROOT='/var/lib/blindou-platform'
readonly FOUNDATION_STATE="${STATE_ROOT}/foundation.state"
readonly BACKUP_ROOT='/var/backups/blindou'
readonly FOUNDATION_BACKUP_ROOT="${BACKUP_ROOT}/platform-foundation"
readonly DATABASE_BACKUP_ROOT="${BACKUP_ROOT}/postgresql"
readonly BACKUP_EXPORT_ROOT='/home/apiadmin/blindou-backup-outbox'
readonly DATA_ROOT='/etc/blindou'
readonly DATABASE_SECRET_DIR="${DATA_ROOT}/database"
readonly DATABASE_CREDENTIALS="${DATABASE_SECRET_DIR}/credentials.env"
readonly CLIENT_CA_DIR="${DATA_ROOT}/postgres-ca"
readonly CLIENT_CERT_DIR="${DATA_ROOT}/postgres-client"
readonly SERVER_CA_FILE="${CLIENT_CERT_DIR}/ca.crt"
readonly CLIENT_CERT_FILE="${CLIENT_CERT_DIR}/tls.crt"
readonly CLIENT_KEY_FILE="${CLIENT_CERT_DIR}/tls.key"
readonly POSTGRES_CA_FILE='/etc/postgresql/18/main/blindou-client-ca.crt'
readonly POSTGRES_CONFIG_FILE='/etc/postgresql/18/main/conf.d/91-blindou.conf'
readonly POSTGRES_HBA_FILE='/etc/postgresql/18/main/pg_hba_blindou.conf'
readonly POSTGRES_HBA_MAIN='/etc/postgresql/18/main/pg_hba.conf'
readonly POSTGRES_SERVER_CERT='/etc/postgresql/18/main/apiwpp-server.crt'
readonly BACKUP_RECIPIENT_CERT="${DATA_ROOT}/backup/recovery-recipient.crt"
readonly RELEASE_INBOX='/home/apiadmin/blindou-deploy-inbox'
readonly RELEASE_CACHE="${STATE_ROOT}/deploy-cache"
readonly RELEASE_HISTORY="${STATE_ROOT}/deploy-history"
readonly CURRENT_RELEASE="${STATE_ROOT}/current-release"
readonly ALLOWED_SIGNERS="${DATA_ROOT}/deploy/allowed_signers"
readonly RELEASE_PATTERN='^[0-9a-f]{40}$'
readonly FOUNDATION_CONFIRMATION='blindou-platform-foundation'
readonly DATA_CONFIRMATION='blindou-data-foundation'
readonly DATA_ROLLBACK_CONFIRMATION='blindou-empty-data-foundation'
readonly BACKUP_CONFIRMATION='blindou-database-backup'
readonly ROLLBACK_CONFIRMATION='blindou-signed-rollback'

exec 9>/run/lock/blindou-deployctl.lock
if ! flock --nonblock 9; then
  printf '%s\n' '[blindou-deployctl] ERRO: outra operação Blindou está em andamento' >&2
  exit 2
fi

cleanup_paths=()
cleanup() {
  local path resolved
  for path in "${cleanup_paths[@]:-}"; do
    [[ -n "$path" ]] || continue
    resolved="$(readlink -m "$path")"
    case "$resolved" in
      "${RELEASE_CACHE}"/.verify.*|"${DATABASE_BACKUP_ROOT}"/.tmp.*|\
      "${DATABASE_BACKUP_ROOT}"/blindou-*.tmp|\
      "${CLIENT_CA_DIR}"/*.tmp|"${CLIENT_CA_DIR}"/client-ext.*|\
      "${CLIENT_CERT_DIR}"/*.tmp|\
      "${POSTGRES_CONFIG_FILE}.tmp"|"${POSTGRES_HBA_FILE}.tmp")
        rm -rf -- "$resolved"
        ;;
    esac
  done
}
trap cleanup EXIT

fail() {
  printf '[blindou-deployctl] ERRO: %s\n' "$*" >&2
  exit 1
}

pass() {
  printf '[blindou-deployctl] OK: %s\n' "$*"
}

kube() {
  k3s kubectl "$@"
}

postgres_query() {
  runuser -u postgres -- psql -X --no-psqlrc --set=ON_ERROR_STOP=1 "$@"
}

require_root_and_host() {
  [[ "${EUID}" -eq 0 ]] || fail 'execute pelo sudo restrito do controlador'
  [[ "$(hostname)" == "$EXPECTED_HOSTNAME" ]] || fail 'hostname inesperado'
  systemctl is-active --quiet k3s.service || fail 'K3s não está ativo'
  systemctl is-active --quiet postgresql@18-main.service \
    || fail 'PostgreSQL 18/main não está ativo'
}

require_platform_preconditions() {
  require_root_and_host
  /usr/local/sbin/blindou-hostctl verify >/dev/null \
    || fail 'contenção temporária do host não passou'
  /usr/local/sbin/apiwpp-deployctl verify >/dev/null \
    || fail 'apiwpp não passou no gate de preservação'
  [[ -d "$FOUNDATION_DIR" && ! -L "$FOUNDATION_DIR" ]] \
    || fail 'bundle root-owned da fundação está ausente'
}

namespace_exists() {
  kube get namespace "$1" >/dev/null 2>&1
}

namespace_label() {
  kube get namespace "$1" -o "jsonpath={.metadata.labels.$2}"
}

namespace_object_count() {
  local namespace="$1"
  kube -n "$namespace" get \
    deployment,statefulset,daemonset,job,cronjob,pod,service,secret,pvc \
    -o json | jq '[.items[]] | length'
}

assert_namespace_labels() {
  local namespace="$1" role="$2"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/managed')" == 'true' ]] \
    || fail "namespace ${namespace} não é gerenciado pela plataforma"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/project')" == 'blindou' ]] \
    || fail "namespace ${namespace} pertence a projeto inesperado"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/environment')" == 'production' ]] \
    || fail "namespace ${namespace} não está marcado como produção"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/role')" == "$role" ]] \
    || fail "papel do namespace ${namespace} diverge"
  [[ "$(namespace_label "$namespace" 'platform\.servidor\.local/deployment-gate')" == 'blocked' ]] \
    || fail "namespace ${namespace} deve permanecer bloqueado nesta etapa"
  [[ "$(namespace_label "$namespace" 'pod-security\.kubernetes\.io/enforce')" == 'restricted' ]] \
    || fail "Pod Security não está restricted em ${namespace}"
  [[ "$(namespace_label "$namespace" 'pod-security\.kubernetes\.io/enforce-version')" == 'v1.36' ]] \
    || fail "versão de Pod Security diverge em ${namespace}"
}

assert_quarantine_namespace() {
  local namespace="$1"
  [[ "$(namespace_object_count "$namespace")" == '0' ]] \
    || fail "namespace ${namespace} contém workload, Service, Secret ou PVC"
  [[ "$(kube -n "$namespace" get serviceaccount default \
    -o jsonpath='{.automountServiceAccountToken}')" == 'false' ]] \
    || fail "ServiceAccount default permite token em ${namespace}"
  [[ "$(kube -n "$namespace" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.pods}')" == '0' ]] \
    || fail "quota de quarentena não bloqueia Pods em ${namespace}"
  [[ "$(kube -n "$namespace" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.services}')" == '0' ]] \
    || fail "quota de quarentena não bloqueia Services em ${namespace}"
  [[ "$(kube -n "$namespace" get resourcequota platform-quarantine \
    -o jsonpath='{.spec.hard.secrets}')" == '0' ]] \
    || fail "quota de quarentena não bloqueia Secrets em ${namespace}"
  kube -n "$namespace" get limitrange platform-quarantine-defaults >/dev/null \
    || fail "LimitRange ausente em ${namespace}"
  kube -n "$namespace" get networkpolicy platform-default-deny >/dev/null \
    || fail "default deny ausente em ${namespace}"
  kube -n "$namespace" get networkpolicy platform-allow-cluster-dns >/dev/null \
    || fail "política DNS ausente em ${namespace}"
}

negative_admission_tests() {
  if cat <<EOF | kube apply --dry-run=server -f - >/dev/null 2>&1
apiVersion: v1
kind: Pod
metadata:
  name: blindou-negative-pod
  namespace: ${APP_NAMESPACE}
spec:
  automountServiceAccountToken: false
  containers:
    - name: negative
      image: docker.io/library/busybox:latest
      command: ["sh", "-c", "exit 0"]
      resources:
        requests: {cpu: 1m, memory: 1Mi}
        limits: {cpu: 1m, memory: 1Mi}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: ["ALL"]}
EOF
  then
    fail 'admissão aceitou Pod enquanto o gate está bloqueado'
  fi
  if cat <<EOF | kube apply --dry-run=server -f - >/dev/null 2>&1
apiVersion: v1
kind: Service
metadata:
  name: blindou-negative-nodeport
  namespace: ${APP_NAMESPACE}
spec:
  type: NodePort
  selector: {app: negative}
  ports:
    - port: 8080
      targetPort: 8080
EOF
  then
    fail 'admissão aceitou Service NodePort no Blindou'
  fi
}

verify_foundation() {
  require_platform_preconditions
  namespace_exists "$APP_NAMESPACE" || fail "namespace ${APP_NAMESPACE} ausente"
  namespace_exists "$EDGE_NAMESPACE" || fail "namespace ${EDGE_NAMESPACE} ausente"
  assert_namespace_labels "$APP_NAMESPACE" application
  assert_namespace_labels "$EDGE_NAMESPACE" edge
  assert_quarantine_namespace "$APP_NAMESPACE"
  assert_quarantine_namespace "$EDGE_NAMESPACE"
  kube get validatingadmissionpolicy managed-production-workload-baseline >/dev/null \
    || fail 'ValidatingAdmissionPolicy de produção ausente'
  kube get validatingadmissionpolicybinding managed-production-workload-baseline >/dev/null \
    || fail 'binding da admissão de produção ausente'
  kube get validatingadmissionpolicy shared-lab-private-services >/dev/null \
    || fail 'política de Services privados ausente'
  kube get validatingadmissionpolicybinding shared-lab-private-services >/dev/null \
    || fail 'binding de Services privados ausente'
  [[ "$(kube get node "$NODE_NAME" -o jsonpath='{.metadata.labels.blindou\.io/node-role}')" == 'physical' ]] \
    || fail 'nó físico não possui o label Blindou esperado'
  [[ "$(kube get deployment,statefulset,daemonset -A -o json | jq \
    '[.items[] | select((.metadata.name | ascii_downcase | contains("cloudflared")) or any(.spec.template.spec.containers[]?; .image | ascii_downcase | contains("cloudflared")))] | length')" == '0' ]] \
    || fail 'cloudflared apareceu no cluster antes da configuração externa'
  pgrep -fa '(^|/|[[:space:]])cloudflared([[:space:]]|$)' >/dev/null \
    && fail 'cloudflared apareceu no host'
  negative_admission_tests
  pass 'namespaces vazios, quarentena, admissão e preservação do apiwpp verificados'
}

write_foundation_state() {
  local edge_preexisting="$1" app_preexisting="$2" node_label_before="$3" backup_dir="$4"
  install -d -o root -g root -m 0700 "$STATE_ROOT"
  {
    printf 'edge_preexisting=%s\n' "$edge_preexisting"
    printf 'app_preexisting=%s\n' "$app_preexisting"
    printf 'node_label_before=%s\n' "$node_label_before"
    printf 'backup_dir=%s\n' "$backup_dir"
  } >"${FOUNDATION_STATE}.tmp"
  install -o root -g root -m 0600 "${FOUNDATION_STATE}.tmp" "$FOUNDATION_STATE"
  rm -f -- "${FOUNDATION_STATE}.tmp"
}

apply_foundation() {
  [[ "${1:-}" == "$FOUNDATION_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${FOUNDATION_CONFIRMATION}"
  require_platform_preconditions
  local edge_preexisting=false app_preexisting=false node_label_before timestamp backup_dir
  namespace_exists "$EDGE_NAMESPACE" && edge_preexisting=true
  namespace_exists "$APP_NAMESPACE" && app_preexisting=true
  node_label_before="$(kube get node "$NODE_NAME" \
    -o jsonpath='{.metadata.labels.blindou\.io/node-role}' 2>/dev/null || true)"
  if [[ "$edge_preexisting" == true || "$app_preexisting" == true ]]; then
    if verify_foundation >/dev/null 2>&1; then
      pass 'fundação Blindou já estava aplicada'
      return
    fi
    fail 'namespace Blindou preexistente diverge; rollback/reconciliação humana exigida'
  fi

  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup_dir="${FOUNDATION_BACKUP_ROOT}/${timestamp}"
  install -d -o root -g root -m 0700 "$backup_dir"
  kube get validatingadmissionpolicy,validatingadmissionpolicybinding -o yaml \
    >"${backup_dir}/admission-before.yaml"
  kube get node "$NODE_NAME" -o yaml >"${backup_dir}/node-before.yaml"
  write_foundation_state \
    "$edge_preexisting" "$app_preexisting" "$node_label_before" "$backup_dir"

  if ! (
    kube apply -f "${FOUNDATION_DIR}/shared-service-exposure-policy.yaml" >/dev/null
    kube apply -f "${FOUNDATION_DIR}/20-production-workload-policy.yaml" >/dev/null
    kube apply -f "${FOUNDATION_DIR}/00-namespaces.yaml" >/dev/null
    kube apply -f "${FOUNDATION_DIR}/10-quarantine.yaml" >/dev/null
    kube label node "$NODE_NAME" blindou.io/node-role=physical --overwrite >/dev/null
    verify_foundation
  ); then
    rollback_foundation "$FOUNDATION_CONFIRMATION" auto \
      || fail 'aplicação falhou e rollback automático também falhou'
    fail 'aplicação da fundação falhou; rollback automático concluído'
  fi
  pass "fundação bloqueada aplicada; backup em ${backup_dir}"
}

rollback_foundation() {
  [[ "${1:-}" == "$FOUNDATION_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${FOUNDATION_CONFIRMATION}"
  local mode="${2:-human}" edge_preexisting app_preexisting node_label_before backup_dir
  require_root_and_host
  [[ -f "$FOUNDATION_STATE" && ! -L "$FOUNDATION_STATE" ]] \
    || fail 'estado da fundação ausente'
  # O arquivo é gerado pelo próprio controlador com valores restritos.
  # shellcheck disable=SC1090
  source "$FOUNDATION_STATE"
  [[ "$edge_preexisting" =~ ^(true|false)$ && "$app_preexisting" =~ ^(true|false)$ ]] \
    || fail 'estado da fundação inválido'
  [[ "$backup_dir" =~ ^${FOUNDATION_BACKUP_ROOT}/[0-9]{8}T[0-9]{6}Z$ \
      && -f "${backup_dir}/admission-before.yaml" ]] \
    || fail 'backup anterior da admissao e invalido'
  for namespace in "$APP_NAMESPACE" "$EDGE_NAMESPACE"; do
    if namespace_exists "$namespace"; then
      [[ "$(namespace_object_count "$namespace")" == '0' ]] \
        || fail "rollback recusado: ${namespace} contém objeto operacional"
    fi
  done
  kube delete -f "${FOUNDATION_DIR}/10-quarantine.yaml" --ignore-not-found >/dev/null
  if [[ "$app_preexisting" == false ]]; then
    kube delete namespace "$APP_NAMESPACE" --ignore-not-found --wait=true >/dev/null
  fi
  if [[ "$edge_preexisting" == false ]]; then
    kube delete namespace "$EDGE_NAMESPACE" --ignore-not-found --wait=true >/dev/null
  fi
  kube delete validatingadmissionpolicybinding \
    managed-production-workload-baseline shared-lab-private-services \
    --ignore-not-found >/dev/null
  kube delete validatingadmissionpolicy \
    managed-production-workload-baseline shared-lab-private-services \
    --ignore-not-found >/dev/null
  kube apply -f "${backup_dir}/admission-before.yaml" >/dev/null
  if [[ -z "$node_label_before" ]]; then
    kube label node "$NODE_NAME" blindou.io/node-role- >/dev/null 2>&1 || true
  else
    kube label node "$NODE_NAME" "blindou.io/node-role=${node_label_before}" --overwrite >/dev/null
  fi
  if [[ "$mode" != auto ]]; then
    pass 'somente namespaces vazios e controles da fundação Blindou foram revertidos'
  fi
}

generate_database_material() {
  install -d -o root -g root -m 0700 \
    "$DATABASE_SECRET_DIR" "$CLIENT_CA_DIR" "$CLIENT_CERT_DIR"
  if [[ ! -f "$DATABASE_CREDENTIALS" ]]; then
    {
      printf 'BLINDOU_MIGRATION_PASSWORD=%s\n' "$(openssl rand -hex 32)"
      printf 'BLINDOU_RUNTIME_PASSWORD=%s\n' "$(openssl rand -hex 32)"
      printf 'BLINDOU_REDIRECT_PASSWORD=%s\n' "$(openssl rand -hex 32)"
      printf 'BLINDOU_ML_PASSWORD=%s\n' "$(openssl rand -hex 32)"
    } >"${DATABASE_CREDENTIALS}.tmp"
    install -o root -g root -m 0600 "${DATABASE_CREDENTIALS}.tmp" "$DATABASE_CREDENTIALS"
    rm -f -- "${DATABASE_CREDENTIALS}.tmp"
  fi
  [[ -f "$DATABASE_CREDENTIALS" && ! -L "$DATABASE_CREDENTIALS" \
      && "$(stat -c '%U:%G:%a' "$DATABASE_CREDENTIALS")" == 'root:root:600' ]] \
    || fail 'arquivo de credenciais do banco inválido'

  if [[ ! -f "${CLIENT_CA_DIR}/client-ca.key" ]]; then
    cleanup_paths+=(
      "${CLIENT_CA_DIR}/client-ca.key.tmp"
      "${CLIENT_CA_DIR}/client-ca.crt.tmp"
    )
    openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
      -subj '/CN=Blindou PostgreSQL Client CA' \
      -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
      -addext 'keyUsage=critical,keyCertSign,cRLSign' \
      -keyout "${CLIENT_CA_DIR}/client-ca.key.tmp" \
      -out "${CLIENT_CA_DIR}/client-ca.crt.tmp" >/dev/null 2>&1
    install -o root -g root -m 0600 \
      "${CLIENT_CA_DIR}/client-ca.key.tmp" "${CLIENT_CA_DIR}/client-ca.key"
    install -o root -g root -m 0644 \
      "${CLIENT_CA_DIR}/client-ca.crt.tmp" "${CLIENT_CA_DIR}/client-ca.crt"
    rm -f -- "${CLIENT_CA_DIR}/client-ca.key.tmp" "${CLIENT_CA_DIR}/client-ca.crt.tmp"
  fi
  if [[ ! -f "$CLIENT_KEY_FILE" ]]; then
    local extension_file
    extension_file="$(mktemp "${CLIENT_CA_DIR}/client-ext.XXXXXX")"
    cleanup_paths+=(
      "$extension_file"
      "${CLIENT_CERT_DIR}/tls.key.tmp"
      "${CLIENT_CERT_DIR}/client.csr.tmp"
      "${CLIENT_CERT_DIR}/tls.crt.tmp"
    )
    cat >"$extension_file" <<'EOF'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=clientAuth
subjectAltName=DNS:blindou-k3s-clients
EOF
    openssl req -new -newkey rsa:3072 -sha256 -nodes \
      -subj '/CN=blindou-k3s-clients' \
      -keyout "${CLIENT_CERT_DIR}/tls.key.tmp" \
      -out "${CLIENT_CERT_DIR}/client.csr.tmp" >/dev/null 2>&1
    openssl x509 -req -sha256 -days 397 \
      -in "${CLIENT_CERT_DIR}/client.csr.tmp" \
      -CA "${CLIENT_CA_DIR}/client-ca.crt" \
      -CAkey "${CLIENT_CA_DIR}/client-ca.key" -CAcreateserial \
      -extfile "$extension_file" \
      -out "${CLIENT_CERT_DIR}/tls.crt.tmp" >/dev/null 2>&1
    install -o root -g root -m 0600 "${CLIENT_CERT_DIR}/tls.key.tmp" "$CLIENT_KEY_FILE"
    install -o root -g root -m 0644 "${CLIENT_CERT_DIR}/tls.crt.tmp" "$CLIENT_CERT_FILE"
    rm -f -- "${CLIENT_CERT_DIR}/tls.key.tmp" "${CLIENT_CERT_DIR}/tls.crt.tmp" \
      "${CLIENT_CERT_DIR}/client.csr.tmp" "$extension_file"
  fi
  install -o root -g root -m 0644 "$POSTGRES_SERVER_CERT" "$SERVER_CA_FILE"
  install -o root -g postgres -m 0640 \
    "${CLIENT_CA_DIR}/client-ca.crt" "$POSTGRES_CA_FILE"
}

load_database_credentials() {
  [[ -f "$DATABASE_CREDENTIALS" && ! -L "$DATABASE_CREDENTIALS" ]] \
    || fail 'credenciais do banco ausentes'
  if grep -Ev '^(BLINDOU_MIGRATION_PASSWORD|BLINDOU_RUNTIME_PASSWORD|BLINDOU_REDIRECT_PASSWORD|BLINDOU_ML_PASSWORD)=[0-9a-f]{64}$' \
      "$DATABASE_CREDENTIALS" | grep -q .; then
    fail 'formato das credenciais do banco inválido'
  fi
  [[ "$(wc -l <"$DATABASE_CREDENTIALS")" == '4' ]] \
    || fail 'quantidade de credenciais do banco inválida'
  # shellcheck disable=SC1090
  source "$DATABASE_CREDENTIALS"
}

install_postgres_client_auth() {
  cleanup_paths+=("${POSTGRES_CONFIG_FILE}.tmp" "${POSTGRES_HBA_FILE}.tmp")
  cat >"${POSTGRES_CONFIG_FILE}.tmp" <<EOF
# Blindou: CA exclusiva para autenticação adicional dos clientes K3s.
ssl_ca_file = '${POSTGRES_CA_FILE}'
EOF
  install -o root -g root -m 0644 "${POSTGRES_CONFIG_FILE}.tmp" "$POSTGRES_CONFIG_FILE"
  rm -f -- "${POSTGRES_CONFIG_FILE}.tmp"
  cat >"${POSTGRES_HBA_FILE}.tmp" <<'EOF'
# Blindou: TLS + certificado de cliente confiável + SCRAM por identidade.
hostssl blindou blindou_migration_login 10.42.0.0/16 scram-sha-256 clientcert=verify-ca
hostssl blindou blindou_runtime_login   10.42.0.0/16 scram-sha-256 clientcert=verify-ca
hostssl blindou blindou_redirect_login  10.42.0.0/16 scram-sha-256 clientcert=verify-ca
hostssl blindou blindou_ml_login        10.42.0.0/16 scram-sha-256 clientcert=verify-ca
EOF
  install -o postgres -g postgres -m 0640 "${POSTGRES_HBA_FILE}.tmp" "$POSTGRES_HBA_FILE"
  rm -f -- "${POSTGRES_HBA_FILE}.tmp"
  if ! grep -Fxq "include_if_exists 'pg_hba_blindou.conf'" "$POSTGRES_HBA_MAIN"; then
    local timestamp hba_tmp
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    install -d -o root -g root -m 0700 "${BACKUP_ROOT}/postgres-config/${timestamp}"
    install -o root -g root -m 0600 "$POSTGRES_HBA_MAIN" \
      "${BACKUP_ROOT}/postgres-config/${timestamp}/pg_hba.conf"
    hba_tmp="$(mktemp)"
    {
      printf "%s\n" "include_if_exists 'pg_hba_blindou.conf'"
      cat "$POSTGRES_HBA_MAIN"
    } >"$hba_tmp"
    install -o postgres -g postgres -m 0640 "$hba_tmp" "$POSTGRES_HBA_MAIN"
    rm -f -- "$hba_tmp"
  fi
  pg_ctlcluster 18 main reload
  sleep 1
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_file_settings WHERE error IS NOT NULL")" == '0' ]] \
    || fail 'PostgreSQL recusou a configuração Blindou'
  [[ "$(postgres_query -d postgres -Atqc \
    "SELECT count(*) FROM pg_hba_file_rules WHERE error IS NOT NULL")" == '0' ]] \
    || fail 'PostgreSQL recusou a regra HBA Blindou'
}

create_database_roles() {
  load_database_credentials
  postgres_query -d postgres \
    --set=migration_password="$BLINDOU_MIGRATION_PASSWORD" \
    --set=runtime_password="$BLINDOU_RUNTIME_PASSWORD" \
    --set=redirect_password="$BLINDOU_REDIRECT_PASSWORD" \
    --set=ml_password="$BLINDOU_ML_PASSWORD" <<'SQL' >/dev/null
SELECT format('CREATE ROLE %I NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', role_name)
FROM (VALUES ('blindou_migrator'), ('blindou_runtime'), ('blindou_app'), ('blindou_auth')) AS roles(role_name)
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = role_name)
\gexec
SELECT format('CREATE ROLE blindou_migration_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'migration_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_migration_login')
\gexec
SELECT format('CREATE ROLE blindou_runtime_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'runtime_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_runtime_login')
\gexec
SELECT format('CREATE ROLE blindou_redirect_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'redirect_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_redirect_login')
\gexec
SELECT format('CREATE ROLE blindou_ml_login LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION', :'ml_password')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'blindou_ml_login')
\gexec
ALTER ROLE blindou_migration_login PASSWORD :'migration_password';
ALTER ROLE blindou_runtime_login PASSWORD :'runtime_password';
ALTER ROLE blindou_redirect_login PASSWORD :'redirect_password';
ALTER ROLE blindou_ml_login PASSWORD :'ml_password';
GRANT blindou_migrator TO blindou_migration_login;
GRANT blindou_runtime TO blindou_runtime_login;
GRANT blindou_app TO blindou_redirect_login;
GRANT blindou_app TO blindou_ml_login;
SELECT 'CREATE DATABASE blindou OWNER blindou_migration_login ENCODING ''UTF8'' TEMPLATE template0'
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = 'blindou')
\gexec
REVOKE ALL ON DATABASE blindou FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE blindou TO blindou_migration_login, blindou_runtime_login, blindou_redirect_login, blindou_ml_login;
SQL
}

write_database_urls() {
