  ensure_ghcr_pull_secret
  verify_runtime_material
}

redact_migration_diagnostics() {
  sed -E \
    -e 's#(postgres(ql)?://)[^[:space:]]+#\1[REDACTED]#gI' \
    -e 's#((password|token|secret|private[_-]?key)=)[^[:space:]]+#\1[REDACTED]#gI'
}

emit_migration_diagnostics() {
  local migration_job="$1" logs
  printf '[blindou-deployctl] diagnóstico sanitizado do Job %s:\n' \
    "$migration_job" >&2
  logs="$(
    kube -n "$APP_NAMESPACE" logs "job/${migration_job}" \
      --container=migrate --tail=100 2>&1 || true
  )"
  if [[ -n "$logs" ]]; then
    printf '%s\n' "$logs" | redact_migration_diagnostics >&2
  else
    printf '[blindou-deployctl] nenhum log de migration disponível\n' >&2
  fi
  unset logs
}

wait_migration_job() {
  local migration_job="$1" deadline complete failed
  deadline=$((SECONDS + 600))
  while (( SECONDS < deadline )); do
    complete="$(
      kube -n "$APP_NAMESPACE" get job "$migration_job" \
        -o 'jsonpath={.status.conditions[?(@.type=="Complete")].status}' \
        2>/dev/null || true
    )"
    [[ "$complete" == 'True' ]] && return 0
    failed="$(
      kube -n "$APP_NAMESPACE" get job "$migration_job" \
        -o 'jsonpath={.status.conditions[?(@.type=="Failed")].status}' \
        2>/dev/null || true
    )"
    if [[ "$failed" == 'True' ]]; then
      emit_migration_diagnostics "$migration_job"
      printf '[blindou-deployctl] ERRO: Job de migration falhou\n' >&2
      return 1
    fi
    sleep 2
  done
  emit_migration_diagnostics "$migration_job"
  printf '[blindou-deployctl] ERRO: Job de migration excedeu 600 segundos\n' >&2
  return 1
}

wait_release() {
  local release_id="$1" rendered="$2" migration_job="blindou-migrate-${release_id:0:12}"
  kube -n "$APP_NAMESPACE" rollout status statefulset/blindou-nats --timeout=300s
  kube -n "$APP_NAMESPACE" rollout status statefulset/blindou-redis --timeout=300s
  wait_migration_job "$migration_job"
  local deployment
  for deployment in blindou-backend blindou-ml-affiliate-connector blindou-redirector; do
    kube -n "$APP_NAMESPACE" rollout status "deployment/${deployment}" --timeout=600s
  done
  while IFS= read -r worker_manifest; do
    deployment="blindou-worker-$(basename "$worker_manifest" .yaml)"
    kube -n "$APP_NAMESPACE" rollout status "deployment/${deployment}" --timeout=600s
  done < <(find "$rendered/workers" -maxdepth 1 -type f -name '*.yaml' | sort)
  kube -n "$EDGE_NAMESPACE" rollout status deployment/blindou-cloudflared --timeout=300s
}

apply_cached_release() {
  local release_id="$1" rendered="${RELEASE_CACHE}/${release_id}/rendered"
  [[ -d "$rendered" && ! -L "$rendered" ]] || fail 'release não está validada no cache root-owned'
  require_release_gates "$release_id"
  kube -n "$APP_NAMESPACE" annotate configmap blindou-runtime-config \
    "blindou.io/release=${release_id}" --overwrite >/dev/null
  kube apply -f "$rendered/00-platform.yaml" >/dev/null
  kube apply -f "$rendered/10-services.yaml" >/dev/null
  kube apply -f "$rendered/20-nats-config.yaml" >/dev/null
  kube apply -f "$rendered/30-network-policies.yaml" >/dev/null
  kube apply -f "$rendered/40-workloads.yaml" -l 'blindou.io/tier=infra' >/dev/null
  kube -n "$APP_NAMESPACE" rollout status statefulset/blindou-nats --timeout=300s
  kube -n "$APP_NAMESPACE" rollout status statefulset/blindou-redis --timeout=300s
  kube apply -f "$rendered/40-workloads.yaml" -l 'blindou.io/tier=migration' >/dev/null
  wait_migration_job "blindou-migrate-${release_id:0:12}"
  reconcile_redirector_database_role
  verify_data_foundation >/dev/null
  kube apply -f "$rendered/40-workloads.yaml" -l 'blindou.io/tier=app' >/dev/null
  kube apply -f "$rendered/workers" >/dev/null
  kube apply -f "$rendered/60-cloudflared.yaml" >/dev/null
  attach_edge_pull_credential
  wait_release "$release_id" "$rendered"
  printf '%s\n' "$release_id" >"${CURRENT_RELEASE}.tmp"
  install -o root -g root -m 0600 "${CURRENT_RELEASE}.tmp" "$CURRENT_RELEASE"
  rm -f -- "${CURRENT_RELEASE}.tmp"
}

rollback_release() {
  local release_id="$1" confirmation="$2"
  [[ "$confirmation" == "$ROLLBACK_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${ROLLBACK_CONFIRMATION}"
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id inválido'
  local rendered="${RELEASE_CACHE}/${release_id}/rendered"
  [[ -d "$rendered" && ! -L "$rendered" ]] || fail 'release de rollback ausente do cache'
  if marketplaces_runtime_receipt_is_secure \
      && grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    cached_release_is_marketplaces_compatible "$release_id" \
      || fail 'rollback recusado: Shopee ativa exige release compatível ou desativação reconciliada'
  fi
  require_release_gates "$release_id"
  kube apply -f "$rendered/00-platform.yaml" >/dev/null
  kube apply -f "$rendered/10-services.yaml" >/dev/null
  kube apply -f "$rendered/20-nats-config.yaml" >/dev/null
  kube apply -f "$rendered/30-network-policies.yaml" >/dev/null
  kube apply -f "$rendered/40-workloads.yaml" -l 'blindou.io/tier in (infra,app)' >/dev/null
  kube apply -f "$rendered/workers" >/dev/null
  kube apply -f "$rendered/60-cloudflared.yaml" >/dev/null
  attach_edge_pull_credential
  local deployment
  for deployment in blindou-backend blindou-ml-affiliate-connector blindou-redirector; do
    kube -n "$APP_NAMESPACE" rollout status "deployment/${deployment}" --timeout=600s
  done
  kube -n "$EDGE_NAMESPACE" rollout status deployment/blindou-cloudflared --timeout=300s
  printf '%s\n' "$release_id" >"${CURRENT_RELEASE}.tmp"
  install -o root -g root -m 0600 "${CURRENT_RELEASE}.tmp" "$CURRENT_RELEASE"
  rm -f -- "${CURRENT_RELEASE}.tmp"
  pass "rollback de workloads para a release assinada ${release_id}; migrations não foram revertidas"
}

apply_release() {
  local release_id="$1" previous='' apply_status=0
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id inválido'
  prepare_redirector_database_role
  cache_release "$release_id"
  [[ -f "$CURRENT_RELEASE" ]] && previous="$(<"$CURRENT_RELEASE")"
  set +e
  (
    set -Eeuo pipefail
    apply_cached_release "$release_id"
  )
  apply_status=$?
  set -e
  if (( apply_status != 0 )); then
    reconcile_redirector_database_role
    if [[ "$previous" =~ $RELEASE_PATTERN ]]; then
      rollback_release "$previous" "$ROLLBACK_CONFIRMATION" \
        || fail 'release falhou e rollback automático também falhou'
      fail "release falhou; workloads restaurados para ${previous}"
    fi
    kube -n "$APP_NAMESPACE" delete deployment,statefulset,daemonset,job,cronjob \
      --all --ignore-not-found --wait=true >/dev/null 2>&1 || true
    kube -n "$APP_NAMESPACE" delete service --all --ignore-not-found --wait=true >/dev/null 2>&1 || true
    kube -n "$EDGE_NAMESPACE" delete deployment blindou-cloudflared \
      --ignore-not-found --wait=true >/dev/null 2>&1 || true
    kube -n "$EDGE_NAMESPACE" delete secret "$GHCR_PULL_SECRET" \
      --ignore-not-found --wait=true >/dev/null 2>&1 || true
    kube label namespace "$APP_NAMESPACE" \
      'platform.servidor.local/deployment-gate=secrets-only' --overwrite >/dev/null 2>&1 || true
    kube annotate namespace "$APP_NAMESPACE" \
      'platform.servidor.local/gate-reason=first-release-failed' --overwrite >/dev/null 2>&1 || true
    kube apply -f "$EDGE_GATE_MANIFEST" >/dev/null 2>&1 || true
    kube apply -f "$EDGE_RUNTIME_MANIFEST" >/dev/null 2>&1 || true
    rm -f -- "$RELEASE_GATE_RECEIPT"
    fail 'primeira release falhou; workloads removidos, aplicação bloqueada e conector isolado restaurado'
  fi
  pass "release assinada ${release_id} aplicada"
}

metrics() {
  require_root_and_host
  local foundation=0 data=0 latest_backup=0 gate_app=0 gate_edge=0 cloudflare_saas_token=0 ghcr_pull_credential=0 ghcr_candidate_pull=0 r2_credential=0 pagarme_credential=0 pagarme_runtime=0 marketplaces_runtime=0
  if ( verify_foundation >/dev/null 2>&1 ); then foundation=1; fi
  if ( verify_data_foundation >/dev/null 2>&1 ); then data=1; fi
  if [[ -f "${DATABASE_BACKUP_ROOT}/latest" ]]; then
    local backup_id epoch
    backup_id="$(<"${DATABASE_BACKUP_ROOT}/latest")"
    if [[ "$backup_id" =~ ^blindou-([0-9]{8}T[0-9]{6}Z)$ ]]; then
      epoch="$(date -u -d "${BASH_REMATCH[1]:0:8} ${BASH_REMATCH[1]:9:2}:${BASH_REMATCH[1]:11:2}:${BASH_REMATCH[1]:13:2}" +%s 2>/dev/null || true)"
      [[ "$epoch" =~ ^[0-9]+$ ]] && latest_backup="$epoch"
    fi
  fi
  [[ "$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate' 2>/dev/null || true)" == 'passed' ]] && gate_app=1
  [[ "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate' 2>/dev/null || true)" == 'passed' ]] && gate_edge=1
  if cloudflare_saas_token_file_is_secure; then cloudflare_saas_token=1; fi
  if ghcr_token_file_is_secure; then ghcr_pull_credential=1; fi
  if ghcr_pull_latest_proof_is_secure; then ghcr_candidate_pull=1; fi
  if r2_credential_files_are_secure; then r2_credential=1; fi
  if pagarme_credential_files_are_secure; then pagarme_credential=1; fi
  if pagarme_runtime_receipt_is_secure \
      && grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    pagarme_runtime=1
  fi
  if marketplaces_runtime_receipt_is_secure \
      && grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    marketplaces_runtime=1
  fi
  cat <<EOF
# HELP blindou_platform_foundation_up Fundação Kubernetes bloqueada e íntegra.
# TYPE blindou_platform_foundation_up gauge
blindou_platform_foundation_up ${foundation}
# HELP blindou_data_foundation_up Database, papéis e TLS internos íntegros.
# TYPE blindou_data_foundation_up gauge
blindou_data_foundation_up ${data}
# HELP blindou_database_backup_latest_timestamp_seconds Timestamp do último backup lógico criptografado.
