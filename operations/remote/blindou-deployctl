cached_release_is_marketplaces_compatible() {
  local release_id="$1" rendered="${RELEASE_CACHE}/${release_id}/rendered"
  local worker_count
  [[ "$release_id" =~ $RELEASE_PATTERN \
      && -d "$rendered" \
      && ! -L "$rendered" \
      && "$(grep -Fc 'blindou.io/marketplaces-compatible: "true"' \
        "${rendered}/40-workloads.yaml")" == '1' ]] \
    || return 1
  worker_count="$(grep -Fl 'blindou.io/marketplaces-compatible: "true"' \
    "${rendered}"/workers/*.yaml | wc -l)"
  [[ "$worker_count" == '16' ]]
}

restart_pagarme_consumers() {
  local -a deployments=()
  mapfile -t deployments < <(
    kube -n "$APP_NAMESPACE" get deployment -l blindou.io/tier=worker \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | sort
  )
  [[ "${#deployments[@]}" -eq 16 ]] \
    || fail 'ativação de provedor externo exige exatamente os 16 workers contínuos'
  kube -n "$APP_NAMESPACE" rollout restart deployment/blindou-backend >/dev/null
  local deployment
  for deployment in "${deployments[@]}"; do
    kube -n "$APP_NAMESPACE" rollout restart "deployment/${deployment}" >/dev/null
  done
  kube -n "$APP_NAMESPACE" rollout status deployment/blindou-backend --timeout=600s >/dev/null
  for deployment in "${deployments[@]}"; do
    kube -n "$APP_NAMESPACE" rollout status "deployment/${deployment}" --timeout=600s >/dev/null
  done
  # O rollout só conclui depois das probes HTTP /ready declaradas na release
  # assinada passarem pelo kubelet. A imagem mínima não carrega ferramentas de
  # diagnóstico e a ativação não pode depender de executá-las dentro do Pod.
}

activate_pagarme_runtime() {
  local release_id="$1" confirmation="$2" activation_status rollback_status
  [[ "$confirmation" == "$PAGARME_RUNTIME_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${PAGARME_RUNTIME_CONFIRMATION}"
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id Pagar.me inválido'
  require_platform_preconditions
  [[ "$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' \
      && "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' ]] \
    || fail 'ativação Pagar.me exige aplicação e EDGE em passed'
  current_release_is_pagarme_compatible "$release_id" \
    || fail 'release corrente não declara compatibilidade Pagar.me-first'
  verify_pagarme_credential >/dev/null

  if pagarme_runtime_receipt_is_secure \
      && grep -Fxq "release_id=${release_id}" "$PAGARME_RUNTIME_RECEIPT" \
      && grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    verify_runtime_material >/dev/null
    if [[ -e "$PAGARME_RUNTIME_ROLLBACK_CONFIG" \
        || -L "$PAGARME_RUNTIME_ROLLBACK_CONFIG" ]]; then
      runtime_secret_file_is_secure "$PAGARME_RUNTIME_ROLLBACK_CONFIG" \
        || fail 'journal residual Pagar.me está inseguro; remoção automática recusada'
      rm -f -- "$PAGARME_RUNTIME_ROLLBACK_CONFIG"
    fi
    pass "runtime Pagar.me já está ativo na release ${release_id}"
    return
  fi

  if [[ -e "$PAGARME_RUNTIME_ROLLBACK_CONFIG" \
      || -L "$PAGARME_RUNTIME_ROLLBACK_CONFIG" ]]; then
    runtime_secret_file_is_secure "$PAGARME_RUNTIME_ROLLBACK_CONFIG" \
      || fail 'ativação Pagar.me interrompida deixou journal inseguro; recuperação recusada'
    install -o root -g root -m 0600 \
      "$PAGARME_RUNTIME_ROLLBACK_CONFIG" "$RUNTIME_CONFIG_FILE"
    create_runtime_kubernetes_material
    verify_runtime_material
    restart_pagarme_consumers
    rm -f -- "$PAGARME_RUNTIME_ROLLBACK_CONFIG"
  fi

  grep -Fxq 'INITIAL_UI_REVIEW_MODE=true' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'PAGARME_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'UAZAPI_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'EMAIL_PROVIDER=disabled' "$RUNTIME_CONFIG_FILE" \
    || fail 'ativação Pagar.me exige o runtime compatível ainda no modo fechado anterior'
  verify_runtime_material >/dev/null

  [[ ! -e "${PAGARME_RUNTIME_ROLLBACK_CONFIG}.tmp" \
      && ! -L "${PAGARME_RUNTIME_ROLLBACK_CONFIG}.tmp" ]] \
    || fail 'arquivo temporário inesperado no journal Pagar.me'
  install -o root -g root -m 0600 "$RUNTIME_CONFIG_FILE" \
    "${PAGARME_RUNTIME_ROLLBACK_CONFIG}.tmp"
  cleanup_paths+=("${PAGARME_RUNTIME_ROLLBACK_CONFIG}.tmp")
  mv -- "${PAGARME_RUNTIME_ROLLBACK_CONFIG}.tmp" \
    "$PAGARME_RUNTIME_ROLLBACK_CONFIG"
  set +e
  (
    set -Eeuo pipefail
    write_pagarme_first_runtime_config
    create_runtime_kubernetes_material
    verify_runtime_material
    restart_pagarme_consumers
  )
  activation_status=$?
  set -e
  if (( activation_status != 0 )); then
    set +e
    (
      set -Eeuo pipefail
      install -o root -g root -m 0600 \
        "$PAGARME_RUNTIME_ROLLBACK_CONFIG" "$RUNTIME_CONFIG_FILE"
      create_runtime_kubernetes_material
      verify_runtime_material
      restart_pagarme_consumers
    )
    rollback_status=$?
    set -e
    (( rollback_status == 0 )) \
      || fail 'ativação Pagar.me falhou e o rollback automático também falhou; journal preservado'
    rm -f -- "$PAGARME_RUNTIME_ROLLBACK_CONFIG"
    fail 'ativação Pagar.me falhou; configuração e workloads anteriores foram restaurados'
  fi
  if [[ -e "$PAGARME_RUNTIME_RECEIPT" \
      || -L "$PAGARME_RUNTIME_RECEIPT" ]]; then
    pagarme_runtime_receipt_is_secure \
      || fail 'recibo de ativação Pagar.me existente está inseguro'
  fi
  [[ ! -e "${PAGARME_RUNTIME_RECEIPT}.tmp" \
      && ! -L "${PAGARME_RUNTIME_RECEIPT}.tmp" ]] \
    || fail 'arquivo temporário inesperado no recibo de ativação Pagar.me'
  {
    printf 'schema=1\nprovider=pagarme-v5\nenvironment=live\n'
    printf 'release_id=%s\nactivated_at_utc=%s\n' \
      "$release_id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${PAGARME_RUNTIME_RECEIPT}.tmp"
  cleanup_paths+=("${PAGARME_RUNTIME_RECEIPT}.tmp")
  install -o root -g root -m 0600 \
    "${PAGARME_RUNTIME_RECEIPT}.tmp" "$PAGARME_RUNTIME_RECEIPT"
  rm -f -- "${PAGARME_RUNTIME_RECEIPT}.tmp"
  rm -f -- "$PAGARME_RUNTIME_ROLLBACK_CONFIG"
  pass "Pagar.me ativado na release compatível ${release_id}; UAZAPI e Resend permanecem ausentes"
}

verify_marketplaces_runtime() {
  require_platform_preconditions
  [[ "$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' \
      && "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' ]] \
    || fail 'verificação de Marketplaces exige aplicação e EDGE em passed'
  [[ -f "$CURRENT_RELEASE" && ! -L "$CURRENT_RELEASE" \
      && "$(stat -c '%U:%G:%a' "$CURRENT_RELEASE")" == 'root:root:600' ]] \
    || fail 'release corrente ausente ou insegura'
  local release_id
  release_id="$(<"$CURRENT_RELEASE")"
  current_release_is_marketplaces_compatible "$release_id" \
    || fail 'release corrente não declara compatibilidade com Marketplaces'
  marketplaces_runtime_receipt_is_secure \
    || fail 'recibo de ativação da Shopee está ausente ou inseguro'
  grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'UAZAPI_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'EMAIL_PROVIDER=disabled' "$RUNTIME_CONFIG_FILE" \
    || fail 'runtime de Marketplaces diverge do rollout autorizado'
  verify_runtime_material >/dev/null
  pass "Shopee Open API pronta para credenciais por tenant na release ${release_id}"
}

activate_marketplaces_runtime() {
  local release_id="$1" confirmation="$2" activation_status rollback_status
  local shopee_key_file="${RUNTIME_SECRET_DIR}/SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY"
  [[ "$confirmation" == "$MARKETPLACES_RUNTIME_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${MARKETPLACES_RUNTIME_CONFIRMATION}"
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id de Marketplaces inválido'
  require_platform_preconditions
  [[ "$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' \
      && "$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')" == 'passed' ]] \
    || fail 'ativação de Marketplaces exige aplicação e EDGE em passed'
  current_release_is_marketplaces_compatible "$release_id" \
    || fail 'release corrente não declara compatibilidade com Marketplaces'
  pagarme_runtime_receipt_is_secure \
    || fail 'ativação de Marketplaces exige o runtime Pagar.me já ativo'

  if marketplaces_runtime_receipt_is_secure \
      && grep -Fxq 'SHOPEE_OPEN_API_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    verify_runtime_material >/dev/null
    if [[ -e "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" \
        || -L "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" ]]; then
      runtime_secret_file_is_secure "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" \
        || fail 'journal residual de Marketplaces está inseguro; remoção automática recusada'
      rm -f -- "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG"
    fi
    pass "Shopee Open API já está pronta na release ${release_id}"
    return
  fi

  if [[ -e "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" \
      || -L "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" ]]; then
    runtime_secret_file_is_secure "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" \
      || fail 'ativação de Marketplaces interrompida deixou journal inseguro; recuperação recusada'
    install -o root -g root -m 0600 \
      "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" "$RUNTIME_CONFIG_FILE"
    rm -f -- "$shopee_key_file"
    create_runtime_kubernetes_material
    verify_runtime_material
    restart_pagarme_consumers
    rm -f -- "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG"
  fi

  grep -Fxq 'INITIAL_UI_REVIEW_MODE=false' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'UAZAPI_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
    && grep -Fxq 'EMAIL_PROVIDER=disabled' "$RUNTIME_CONFIG_FILE" \
    || fail 'ativação de Marketplaces exige o rollout Pagar.me-first vigente'
  if grep -q '^SHOPEE_OPEN_API_ENABLED=' "$RUNTIME_CONFIG_FILE"; then
    grep -Fxq 'SHOPEE_OPEN_API_ENABLED=false' "$RUNTIME_CONFIG_FILE" \
      || fail 'Shopee Open API já está em estado divergente do rollout esperado'
  fi
  verify_runtime_material >/dev/null

  [[ ! -e "${MARKETPLACES_RUNTIME_ROLLBACK_CONFIG}.tmp" \
      && ! -L "${MARKETPLACES_RUNTIME_ROLLBACK_CONFIG}.tmp" ]] \
    || fail 'arquivo temporário inesperado no journal de Marketplaces'
  install -o root -g root -m 0600 "$RUNTIME_CONFIG_FILE" \
    "${MARKETPLACES_RUNTIME_ROLLBACK_CONFIG}.tmp"
  cleanup_paths+=("${MARKETPLACES_RUNTIME_ROLLBACK_CONFIG}.tmp")
  mv -- "${MARKETPLACES_RUNTIME_ROLLBACK_CONFIG}.tmp" \
    "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG"
  set +e
  (
    set -Eeuo pipefail
    write_marketplaces_runtime_config
    ensure_random_base64_key SHOPEE_OPEN_API_CREDENTIAL_ENCRYPTION_KEY
    create_runtime_kubernetes_material
    verify_runtime_material
    restart_pagarme_consumers
  )
  activation_status=$?
  set -e
  if (( activation_status != 0 )); then
    set +e
    (
      set -Eeuo pipefail
      install -o root -g root -m 0600 \
        "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG" "$RUNTIME_CONFIG_FILE"
      rm -f -- "$shopee_key_file"
      create_runtime_kubernetes_material
      verify_runtime_material
      restart_pagarme_consumers
    )
    rollback_status=$?
    set -e
    (( rollback_status == 0 )) \
      || fail 'ativação de Marketplaces falhou e o rollback automático também falhou; journal preservado'
    rm -f -- "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG"
    fail 'ativação de Marketplaces falhou; configuração, segredo e workloads anteriores foram restaurados'
  fi
  if [[ -e "$MARKETPLACES_RUNTIME_RECEIPT" \
      || -L "$MARKETPLACES_RUNTIME_RECEIPT" ]]; then
    marketplaces_runtime_receipt_is_secure \
      || fail 'recibo de ativação de Marketplaces existente está inseguro'
  fi
  [[ ! -e "${MARKETPLACES_RUNTIME_RECEIPT}.tmp" \
      && ! -L "${MARKETPLACES_RUNTIME_RECEIPT}.tmp" ]] \
    || fail 'arquivo temporário inesperado no recibo de ativação de Marketplaces'
  {
    printf 'schema=1\nfeature=shopee-open-api\nstate=ready-for-tenant-credentials\n'
    printf 'release_id=%s\nactivated_at_utc=%s\n' \
      "$release_id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${MARKETPLACES_RUNTIME_RECEIPT}.tmp"
  cleanup_paths+=("${MARKETPLACES_RUNTIME_RECEIPT}.tmp")
  install -o root -g root -m 0600 \
    "${MARKETPLACES_RUNTIME_RECEIPT}.tmp" "$MARKETPLACES_RUNTIME_RECEIPT"
  rm -f -- "${MARKETPLACES_RUNTIME_RECEIPT}.tmp"
  rm -f -- "$MARKETPLACES_RUNTIME_ROLLBACK_CONFIG"
  pass "Shopee Open API pronta para credenciais por tenant na release ${release_id}; Pagar.me preservado e UAZAPI/Resend adiados"
}

confirm_alert_delivery() {
  [[ "${1:-}" == "$ALERT_DELIVERY_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${ALERT_DELIVERY_CONFIRMATION}"
  require_root_and_host
  [[ -f "$ALERT_RECEIPT" && ! -L "$ALERT_RECEIPT" ]] || fail 'envio de alerta pendente ausente'
  grep -Fxq 'status=pending' "$ALERT_RECEIPT" || fail 'alerta não está pendente de confirmação'
  sed 's/^status=pending$/status=confirmed/' "$ALERT_RECEIPT" >"${ALERT_RECEIPT}.tmp"
  printf 'confirmed_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"${ALERT_RECEIPT}.tmp"
  install -o root -g root -m 0600 "${ALERT_RECEIPT}.tmp" "$ALERT_RECEIPT"
  rm -f -- "${ALERT_RECEIPT}.tmp"
  pass "receptor externo confirmado: ${SUPERADMIN_EMAIL}"
}

confirm_offsite_backup() {
  local backup_id="$1" expected_sha="$2" confirmation="$3" manifest
  [[ "$confirmation" == "$OFFSITE_BACKUP_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${OFFSITE_BACKUP_CONFIRMATION}"
  require_root_and_host
  [[ "$backup_id" =~ ^blindou-[0-9]{8}T[0-9]{6}Z$ && "$expected_sha" =~ ^[0-9a-f]{64}$ ]] \
    || fail 'recibo offsite possui formato inválido'
  [[ "$(<"${DATABASE_BACKUP_ROOT}/latest")" == "$backup_id" ]] \
    || fail 'recibo offsite não corresponde ao backup mais recente'
  manifest="${DATABASE_BACKUP_ROOT}/${backup_id}.manifest"
  grep -Fxq "encrypted_sha256=${expected_sha}" "$manifest" \
    || fail 'checksum offsite diverge do manifesto no host'
  {
    printf 'schema=1\nbackup_id=%s\nencrypted_sha256=%s\n' "$backup_id" "$expected_sha"
    printf 'target=administrative-workstation\nrpo_minutes=15\nrto_hours=4\nretention_days=30\n'
    printf 'confirmed_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${OFFSITE_BACKUP_RECEIPT}.tmp"
  install -o root -g root -m 0600 "${OFFSITE_BACKUP_RECEIPT}.tmp" "$OFFSITE_BACKUP_RECEIPT"
  rm -f -- "${OFFSITE_BACKUP_RECEIPT}.tmp"
  pass "cópia offsite confirmada para ${backup_id}"
}

activate_release_gates() {
  local release_id="$1" confirmation="$2" backup_id backup_timestamp backup_epoch now_epoch
  local app_gate edge_gate current_release=''
  [[ "$confirmation" == "$RELEASE_GATES_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${RELEASE_GATES_CONFIRMATION}"
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id inválido'
  require_platform_preconditions
  verify_data_foundation >/dev/null
  verify_runtime_material
  verify_r2_runtime_credential >/dev/null
  app_gate="$(namespace_label "$APP_NAMESPACE" 'platform\.servidor\.local/deployment-gate')"
  edge_gate="$(namespace_label "$EDGE_NAMESPACE" 'platform\.servidor\.local/deployment-gate')"
  case "${app_gate}:${edge_gate}" in
    secrets-only:connector-only)
      [[ ! -e "$CURRENT_RELEASE" && ! -L "$CURRENT_RELEASE" ]] \
        || fail 'gates de primeira instalação exigem ausência de release corrente'
      ;;
    passed:passed)
      [[ -f "$CURRENT_RELEASE" && ! -L "$CURRENT_RELEASE" \
          && "$(stat -c '%U:%G:%a' "$CURRENT_RELEASE")" == 'root:root:600' ]] \
        || fail 'gates passed exigem ponteiro seguro da release corrente'
      current_release="$(<"$CURRENT_RELEASE")"
      [[ "$current_release" =~ $RELEASE_PATTERN ]] \
        || fail 'ponteiro da release corrente é inválido'
      ;;
    *) fail 'combinação de gates não é aceita para primeira instalação ou atualização' ;;
  esac
  [[ -d "${RELEASE_CACHE}/${release_id}/rendered" ]] || fail 'release assinada não está no cache'
  [[ "$(<"$GHCR_PULL_PROOF_LATEST")" == "$release_id" ]] \
    || fail 'prova GHCR não corresponde à release'
  if grep -Fxq 'INITIAL_UI_REVIEW_MODE=true' "$RUNTIME_CONFIG_FILE"; then
    [[ -f "$UI_REVIEW_RECEIPT" ]] \
      && grep -Fxq 'status=authorized' "$UI_REVIEW_RECEIPT" \
      || fail 'adiamento dos provedores para revisão da UI não foi registrado'
  elif [[ -f "$ALERT_RECEIPT" ]] && grep -Fxq 'status=confirmed' "$ALERT_RECEIPT"; then
    :
  elif pagarme_runtime_receipt_is_secure \
      && grep -Fxq 'PAGARME_ENABLED=true' "$RUNTIME_CONFIG_FILE"; then
    :
  else
    fail 'receptor externo de alertas não foi confirmado e o adiamento UAZAPI/Resend não está autorizado'
  fi
  backup_id="$(<"${DATABASE_BACKUP_ROOT}/latest")"
  [[ -f "$OFFSITE_BACKUP_RECEIPT" ]] \
    && grep -Fxq "backup_id=${backup_id}" "$OFFSITE_BACKUP_RECEIPT" \
    || fail 'cópia offsite do backup mais recente não foi confirmada'
  backup_timestamp="${backup_id#blindou-}"
  backup_epoch="$(date -u -d "${backup_timestamp:0:8} ${backup_timestamp:9:2}:${backup_timestamp:11:2}:${backup_timestamp:13:2}" +%s)"
  now_epoch="$(date -u +%s)"
  (( now_epoch - backup_epoch <= 3600 )) || fail 'backup anterior ao deploy tem mais de uma hora'
  /usr/local/sbin/blindou-hostctl verify >/dev/null
  /usr/local/sbin/apiwpp-deployctl verify >/dev/null
  kube -n "$EDGE_NAMESPACE" delete resourcequota platform-quarantine --ignore-not-found >/dev/null
  for namespace in "$APP_NAMESPACE" "$EDGE_NAMESPACE"; do
    kube label namespace "$namespace" \
      'platform.servidor.local/deployment-gate=passed' --overwrite >/dev/null
    kube annotate namespace "$namespace" \
      "platform.servidor.local/gate-reason=release-${release_id}" --overwrite >/dev/null
  done
  {
    printf 'schema=1\nrelease_id=%s\nbackup_id=%s\n' "$release_id" "$backup_id"
    printf 'activated_at_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } >"${RELEASE_GATE_RECEIPT}.tmp"
  install -o root -g root -m 0600 "${RELEASE_GATE_RECEIPT}.tmp" "$RELEASE_GATE_RECEIPT"
  rm -f -- "${RELEASE_GATE_RECEIPT}.tmp"
  pass "gates de produção liberados para a release ${release_id}"
}

bootstrap_superadmin() {
  local release_id="$1" confirmation="$2" encoded_password password
  [[ "$confirmation" == "$SUPERADMIN_CONFIRMATION" ]] \
    || fail "confirmação exigida: ${SUPERADMIN_CONFIRMATION}"
  [[ "$release_id" =~ $RELEASE_PATTERN ]] || fail 'release_id inválido'
  [[ ! -t 0 ]] || fail 'senha do superadmin deve chegar por stdin não interativo'
  require_platform_preconditions
  [[ -f "$CURRENT_RELEASE" && "$(<"$CURRENT_RELEASE")" == "$release_id" ]] \
    || fail 'release implantada diverge da release confirmada'
  grep -Fxq "release_id=${release_id}" "$RELEASE_GATE_RECEIPT" \
    || fail 'recibo do gate da release está ausente'
  kube -n "$APP_NAMESPACE" rollout status deployment/blindou-backend --timeout=120s >/dev/null
  [[ "$(kube -n "$APP_NAMESPACE" get deployment blindou-backend \
    -o jsonpath='{.spec.template.metadata.annotations.blindou\.io/release}')" == "$release_id" ]] \
    || fail 'backend Ready diverge da release confirmada'
  IFS= read -r encoded_password || fail 'senha do superadmin não foi recebida'
  [[ "$encoded_password" =~ ^[A-Za-z0-9+/=]{16,1024}$ ]] \
    || fail 'senha codificada do superadmin possui formato inválido'
  password="$(printf '%s' "$encoded_password" | base64 -d)" \
    || fail 'senha codificada do superadmin é inválida'
  unset encoded_password
  [[ ${#password} -le 256 && "$password" != *$'\n'* && "$password" != *$'\r'* ]] \
    || { unset password; fail 'senha do superadmin excede o contrato de entrada'; }
  printf '%s' "$password" | kube -n "$APP_NAMESPACE" exec -i deployment/blindou-backend -c backend -- \
    /usr/bin/env "BOOTSTRAP_TENANT_NAME=${SUPERADMIN_TENANT}" \
    "BOOTSTRAP_USER_EMAIL=${SUPERADMIN_EMAIL}" "BOOTSTRAP_USER_NAME=${SUPERADMIN_NAME}" \
    BOOTSTRAP_USER_ROLE=super_admin /usr/local/bin/blindou-bootstrap-user
  unset password
  pass "superadmin inicial criado: ${SUPERADMIN_EMAIL}"
}

