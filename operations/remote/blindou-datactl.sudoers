Defaults!/usr/local/sbin/blindou-datactl env_reset
Cmnd_Alias BLINDOU_DATA_READ = /usr/local/sbin/blindou-datactl status, /usr/local/sbin/blindou-datactl verify-quarantine, /usr/local/sbin/blindou-datactl validate-release *
Cmnd_Alias BLINDOU_DATA_MUTATE = /usr/local/sbin/blindou-datactl pull-proof * blindou-data-pull-proof, /usr/local/sbin/blindou-datactl foundation * blindou-data-foundation, /usr/local/sbin/blindou-datactl secrets * blindou-data-secrets, /usr/local/sbin/blindou-datactl bootstrap * blindou-data-bootstrap, /usr/local/sbin/blindou-datactl backup * blindou-data-backup, /usr/local/sbin/blindou-datactl restore-base * blindou-data-restore-base
apiadmin ALL=(root) NOPASSWD: BLINDOU_DATA_READ, BLINDOU_DATA_MUTATE
