[Unit]
Description=Coleta métricas do controlador fechado do DRE
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/dre-deployctl metrics
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dre-deployctl /var/lib/prometheus/node-exporter /run/lock
