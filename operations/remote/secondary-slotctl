def pending_age_seconds() -> int:
    if not PENDING_FILE.exists() and not PENDING_FILE.is_symlink():
        return 0
    try:
        pending = read_pending()
        started = parse_timestamp(str(pending["started_at"]))
        now = parse_timestamp(utc_now())
        return max(0, int((now - started).total_seconds()))
    except ContractError:
        return TRANSITION_STUCK_SECONDS + 1


def write_metrics_file(content: str) -> None:
    parent = METRICS_FILE.parent
    metadata = parent.lstat()
    try:
        prometheus_uid = pwd.getpwnam("prometheus").pw_uid
        prometheus_gid = grp.getgrnam("prometheus").gr_gid
    except KeyError:
        fail("identidade do textfile collector está ausente")
    if parent.is_symlink() or not textfile_directory_metadata_is_safe(
        metadata, prometheus_uid, prometheus_gid
    ):
        fail("diretório do textfile collector é inseguro")
    descriptor, temporary_name = tempfile.mkstemp(prefix=".secondary-slot.", dir=parent)
    temporary = pathlib.Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o644)
        os.fchown(descriptor, 0, 0)
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as stream:
            descriptor = -1
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, METRICS_FILE)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


