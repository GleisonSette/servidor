def fail(message: str) -> None:
    raise ContractError(message)


def require_root_host_and_runtime() -> None:
    if os.geteuid() != 0:
        fail("execute pelo sudo restrito do controlador")
    if socket.gethostname() != EXPECTED_HOSTNAME:
        fail("hostname inesperado")
    result = subprocess.run(
        ("systemctl", "is-active", "--quiet", "k3s.service"),
        check=False,
        timeout=SYSTEMD_CHECK_TIMEOUT_SECONDS,
        env={"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"},
    )
    if result.returncode != 0:
        fail("K3s não está ativo")


@contextlib.contextmanager
def exclusive_slot_lock() -> Iterator[None]:
    if not LOCK_FILE.parent.is_dir() or LOCK_FILE.parent.is_symlink():
        fail("diretório do lock global é inválido")
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(LOCK_FILE, flags, 0o600)
    except OSError as error:
        raise ContractError("não foi possível abrir o lock global com segurança") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_gid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_nlink != 1
        ):
            fail("lock global possui ownership, modo ou tipo inseguro")
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise ContractError("outra operação do slot está em andamento") from error
        yield
    finally:
        os.close(descriptor)


def actor() -> str:
    candidate = os.environ.get("SUDO_USER", "root")
    return candidate if ACTOR_PATTERN.fullmatch(candidate) else "unknown"


def audit(action: str, operation_id: str, result: str, detail: str) -> None:
    append_secure_jsonl(
        AUDIT_FILE,
        {
            "timestamp": utc_now(),
            "actor": actor(),
            "action": action,
            "operation_id": operation_id,
            "result": result,
            "detail": detail,
        },
    )


def alert_id(operation_id: str, code: str) -> str:
    return f"{operation_id}:{code}"


def alert(
    operation_id: str,
    code: str,
    detail: str,
    *,
    severity: str = "warning",
    status_value: str = "open",
) -> None:
    unresolved = read_unresolved_alert_ids()
    current_alert_id = alert_id(operation_id, code)
    append_secure_jsonl(
        ALERT_OUTBOX,
        {
            "schema": "servidor-local.operational-alert/v1",
            "alert_id": current_alert_id,
            "occurred_at": utc_now(),
            "source": "secondary-slotctl",
            "severity": severity,
            "code": code,
            "operation_id": operation_id,
            "status": status_value,
            "detail": detail,
        },
    )
    if status_value == "open":
        unresolved.add(current_alert_id)
    elif status_value == "resolved":
        unresolved.discard(current_alert_id)
    else:
        fail("status de alerta inválido")
    atomic_secure_write(
        ALERT_STATE,
        json.dumps(
            {"schema": 1, "unresolved_alert_ids": sorted(unresolved)},
            ensure_ascii=False,
            separators=(",", ":"),
        )
        + "\n",
    )


def read_unresolved_alert_ids() -> set[str]:
    if not ALERT_STATE.exists() and not ALERT_STATE.is_symlink():
        if ALERT_OUTBOX.exists() or ALERT_OUTBOX.is_symlink():
            fail("estado compacto de alertas está ausente")
        return set()
    require_secure_regular_file(ALERT_STATE)
    try:
        payload = json.loads(ALERT_STATE.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ContractError("estado compacto de alertas é inválido") from error
    if not isinstance(payload, dict) or set(payload) != {
        "schema",
        "unresolved_alert_ids",
    }:
        fail("contrato do estado compacto de alertas diverge")
    identifiers = payload["unresolved_alert_ids"]
    if payload["schema"] != 1 or not isinstance(identifiers, list):
        fail("estado compacto de alertas diverge")
    if not all(
        isinstance(identifier, str)
        and len(identifier) <= MAX_ALERT_IDENTIFIER_LENGTH
        for identifier in identifiers
    ):
        fail("identificador inválido no estado compacto de alertas")
    return set(identifiers)


def resolve_alert(operation_id: str, code: str, detail: str) -> None:
    expected_id = alert_id(operation_id, code)
    if expected_id in read_unresolved_alert_ids():
        alert(operation_id, code, detail, severity="info", status_value="resolved")


def resolve_transition_alerts(operation_id: str, detail: str) -> None:
    for code in (
        "transition-needs-reconciliation",
        "blindou-changed-during-transition",
        "runtime-ambiguous",
    ):
        resolve_alert(operation_id, code, detail)


def require_confirmation(action: str, supplied: str) -> None:
    expected = CONFIRMATIONS[action]
    if supplied != expected:
        fail(f"confirmação exigida: {expected}")


def pending_payload(
    operation_id: str,
    phase: str,
    member: str,
    source_generation: int,
    blindou_fingerprint: str,
) -> dict[str, Any]:
    validate_operation_id(operation_id)
    validate_fingerprint(blindou_fingerprint)
    if phase not in {"suspending", "activating"} or member not in {
        "apiwpp",
        "saferwpp",
    }:
        fail("transição pendente inválida")
    return {
        "schema": 1,
        "operation_id": operation_id,
        "phase": phase,
        "member": member,
        "source_generation": source_generation,
        "blindou_fingerprint": blindou_fingerprint,
        "started_at": utc_now(),
    }


def write_pending(payload: dict[str, Any]) -> None:
    atomic_secure_write(
        PENDING_FILE,
        json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
        + "\n",
    )


def read_pending() -> dict[str, Any]:
    require_secure_regular_file(PENDING_FILE)
    try:
        payload = json.loads(PENDING_FILE.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ContractError("transição pendente possui JSON inválido") from error
    if not isinstance(payload, dict) or set(payload) != {
        "schema",
        "operation_id",
        "phase",
        "member",
        "source_generation",
        "blindou_fingerprint",
        "started_at",
    }:
        fail("contrato da transição pendente diverge")
    if payload["schema"] != 1:
        fail("schema da transição pendente diverge")
    validate_operation_id(str(payload["operation_id"]))
    validate_fingerprint(str(payload["blindou_fingerprint"]))
    if payload["phase"] not in {"suspending", "activating"}:
        fail("fase pendente inválida")
    if payload["member"] not in {"apiwpp", "saferwpp"}:
        fail("membro pendente inválido")
    if not isinstance(payload["source_generation"], int) or payload[
        "source_generation"
    ] < 1:
        fail("generation pendente inválida")
    parse_timestamp(str(payload["started_at"]))
    return payload


def require_no_pending() -> None:
    if PENDING_FILE.exists() or PENDING_FILE.is_symlink():
        fail("já existe uma transição pendente; reconcilie ou aborte primeiro")


def require_pending(operation_id: str, phase: str, member: str) -> dict[str, Any]:
    payload = read_pending()
    if (
        payload["operation_id"] != operation_id
        or payload["phase"] != phase
        or payload["member"] != member
    ):
        fail("a transição pendente não corresponde à operação solicitada")
    return payload


def archive_state(operation_id: str, *, allow_invalid_content: bool = False) -> None:
    if not STATE_FILE.exists() and not STATE_FILE.is_symlink():
        return
    require_secure_regular_file(STATE_FILE)
    content = STATE_FILE.read_text(encoding="utf-8")
    generation = "invalid"
    try:
        generation = str(parse_state(content).generation)
    except ContractError:
        if not allow_invalid_content:
            raise
    ensure_secure_directory(STATE_HISTORY)
    target = STATE_HISTORY / f"{generation}-{operation_id}.state"
    if target.exists() or target.is_symlink():
        fail("histórico da operação já existe")
    atomic_secure_write(target, content)
    prune_secure_history(STATE_HISTORY)


def write_state(state: SlotState, operation_id: str, *, archive_invalid: bool = False) -> None:
    archive_state(operation_id, allow_invalid_content=archive_invalid)
    atomic_secure_write(STATE_FILE, state.serialize())


def next_state(
    generation: int, occupant: str, apiwpp_workloads: int, saferwpp_workloads: int
) -> SlotState:
    return SlotState(
        generation=generation,
        active_occupant=occupant,
        apiwpp_workloads=apiwpp_workloads,
        saferwpp_workloads=saferwpp_workloads,
        updated_at=utc_now(),
    )


def require_state_runtime_and_gates() -> tuple[SlotState, RuntimeObservation]:
    state = read_secure_state(STATE_FILE)
    runtime = observe_runtime(kubernetes)
    if not state_matches_runtime(state, runtime):
        fail("atestado diverge do runtime")
    if not admission_is_installed(kubernetes, ADMISSION_MANIFEST):
        fail("admissão do slot está ausente ou divergente")
    if not namespace_gates_match(kubernetes, state):
        fail("labels dos namespaces divergem do atestado")
    return state, runtime


def update_generation_annotations(generation: int) -> None:
    for namespace in (API_NAMESPACE, *SAFER_NAMESPACES):
        if kubernetes.namespace_exists(namespace):
            kubernetes.annotate_namespace(
                namespace, GENERATION_ANNOTATION, str(generation)
            )


def initialize_apiwpp_active(operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("initialize-apiwpp-active", confirmation)
    require_no_pending()
    if STATE_FILE.exists() or STATE_FILE.is_symlink():
        state, runtime = require_state_runtime_and_gates()
        if (
            state.active_occupant == "apiwpp"
            and state.apiwpp_workloads == 1
            and runtime.apiwpp_state == "active"
        ):
            audit("initialize-apiwpp-active", operation_id, "idempotent", "already-initialized")
            print("secondary_slot_initialize=idempotent")
            return
        fail("o atestado já existe em outro estado")
    runtime = observe_runtime(kubernetes)
    if not (
        runtime.apiwpp_state == "active"
        and runtime.apiwpp_workloads == 1
        and runtime.saferwpp_workloads == 0
    ):
        fail("inicialização exige APIWPP ativo exato e SaferWPP sem workload")
    require_blindou_healthy_and_fingerprint(kubernetes, BLINDOU_CURRENT_RELEASE)
    apply_admission(kubernetes, ADMISSION_MANIFEST)
    state = next_state(1, "apiwpp", 1, 0)
    write_state(state, operation_id)
    set_namespace_gates(kubernetes, "apiwpp", 1, require_safer=False)
    if not namespace_gates_match(kubernetes, state):
        fail("gates não convergiram após a inicialização")
    audit("initialize-apiwpp-active", operation_id, "succeeded", "apiwpp-active")
    resolve_transition_alerts(operation_id, "inicialização concluída")
    print("secondary_slot_initialize=passed occupant=apiwpp generation=1")


def begin_suspend(member: str, operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("begin-suspend", confirmation)
    if member not in {"apiwpp", "saferwpp"}:
        fail("membro inválido")
    require_no_pending()
    state, runtime = require_state_runtime_and_gates()
    if state.active_occupant != member:
        fail("somente o ocupante ativo pode iniciar suspensão")
    expected_count = runtime.apiwpp_workloads if member == "apiwpp" else runtime.saferwpp_workloads
    if expected_count < 1:
        fail("o membro solicitado não possui workload ativo")
    fingerprint = require_blindou_healthy_and_fingerprint(
        kubernetes, BLINDOU_CURRENT_RELEASE
    )
    write_pending(
        pending_payload(
            operation_id, "suspending", member, state.generation, fingerprint
        )
    )
    audit("begin-suspend", operation_id, "succeeded", f"member={member}")
    print(f"secondary_slot_transition=pending phase=suspending member={member}")


def complete_suspend(member: str, operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("complete-suspend", confirmation)
    pending = require_pending(operation_id, "suspending", member)
    state = read_secure_state(STATE_FILE)
    if state.active_occupant != member or state.generation != pending["source_generation"]:
        fail("estado mudou desde o início da suspensão")
    if not admission_is_installed(kubernetes, ADMISSION_MANIFEST):
        fail("admissão do slot mudou durante a suspensão")
    if not namespace_gates_match(kubernetes, state):
        fail("gates mudaram durante a suspensão")
    runtime = observe_runtime(kubernetes)
    if not runtime_is_fully_suspended(runtime):
        fail("suspensão ainda não produziu zero workload nos dois lados")
    fingerprint = require_blindou_healthy_and_fingerprint(
        kubernetes, BLINDOU_CURRENT_RELEASE
    )
    if fingerprint != pending["blindou_fingerprint"]:
        alert(
            operation_id,
            "blindou-changed-during-transition",
            "fingerprint Blindou divergiu entre início e conclusão",
            severity="critical",
        )
        fail("Blindou mudou durante a transição; reconciliação explícita exigida")
    generation = state.generation + 1
    set_namespace_gates(kubernetes, "none", generation, require_safer=False)
    write_state(next_state(generation, "none", 0, 0), operation_id)
    PENDING_FILE.unlink()
    audit("complete-suspend", operation_id, "succeeded", f"member={member}")
    resolve_transition_alerts(operation_id, f"{member} suspenso e atestado")
    print(f"secondary_slot_transition=completed phase=suspending member={member}")


def reserve(member: str, operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("reserve", confirmation)
    if member not in {"apiwpp", "saferwpp"}:
        fail("membro inválido")
    require_no_pending()
    state, runtime = require_state_runtime_and_gates()
    if state.active_occupant != "none" or runtime.unambiguous_occupant != "none":
        fail("reserva exige os dois lados suspensos e atestados")
    if member == "saferwpp":
        require_safer_namespaces(kubernetes)
    fingerprint = require_blindou_healthy_and_fingerprint(
        kubernetes, BLINDOU_CURRENT_RELEASE
    )
    write_pending(
        pending_payload(
            operation_id, "activating", member, state.generation, fingerprint
        )
    )
    generation = state.generation + 1
    reserved = next_state(generation, member, 0, 0)
    write_state(reserved, operation_id)
    set_namespace_gates(
        kubernetes, member, generation, require_safer=member == "saferwpp"
    )
    if not namespace_gates_match(kubernetes, reserved):
        fail("gates não convergiram para a reserva")
    audit("reserve", operation_id, "succeeded", f"member={member}")
    print(f"secondary_slot_transition=pending phase=activating member={member}")


def complete_activation(member: str, operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("complete-activation", confirmation)
    pending = require_pending(operation_id, "activating", member)
    state = read_secure_state(STATE_FILE)
    if state.active_occupant != member or state.apiwpp_workloads != 0 or state.saferwpp_workloads != 0:
        fail("reserva do membro não está íntegra")
    if state.generation != pending["source_generation"] + 1:
        fail("generation da reserva diverge")
    if not admission_is_installed(kubernetes, ADMISSION_MANIFEST):
        fail("admissão do slot mudou durante a ativação")
    if not namespace_gates_match(kubernetes, state):
        fail("gates mudaram durante a ativação")
    runtime = observe_runtime(kubernetes)
    api_count, safer_count = activated_workload_counts(member, runtime)
    fingerprint = require_blindou_healthy_and_fingerprint(
        kubernetes, BLINDOU_CURRENT_RELEASE
    )
    if fingerprint != pending["blindou_fingerprint"]:
        alert(
            operation_id,
            "blindou-changed-during-transition",
            "fingerprint Blindou divergiu entre reserva e conclusão",
            severity="critical",
        )
        fail("Blindou mudou durante a transição; reconciliação explícita exigida")
    generation = state.generation + 1
    completed = next_state(generation, member, api_count, safer_count)
    write_state(completed, operation_id)
    update_generation_annotations(generation)
    if not namespace_gates_match(kubernetes, completed):
        fail("gates não convergiram após a ativação")
    PENDING_FILE.unlink()
    audit("complete-activation", operation_id, "succeeded", f"member={member}")
    resolve_transition_alerts(operation_id, f"{member} ativo e atestado")
    print(
        f"secondary_slot_transition=completed phase=activating member={member} "
        f"workloads={api_count + safer_count}"
    )


def abort_transition(member: str, operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("abort-transition", confirmation)
    pending = read_pending()
    if pending["operation_id"] != operation_id or pending["member"] != member:
        fail("a operação não corresponde à transição pendente")
    state = read_secure_state(STATE_FILE)
    if not admission_is_installed(kubernetes, ADMISSION_MANIFEST):
        fail("admissão do slot mudou; use reconcile")
    if not namespace_gates_match(kubernetes, state):
        fail("gates do slot mudaram; use reconcile")
    runtime = observe_runtime(kubernetes)
    fingerprint = require_blindou_healthy_and_fingerprint(
        kubernetes, BLINDOU_CURRENT_RELEASE
    )
    if fingerprint != pending["blindou_fingerprint"]:
        fail("Blindou mudou; use reconcile para preservar o alerta")
    if pending["phase"] == "suspending":
        if not state_matches_runtime(state, runtime):
            fail("suspensão alterou o runtime; aborto simples não é seguro")
    else:
        if not runtime_is_fully_suspended(runtime):
            fail("ativação produziu workload; aborto simples não é seguro")
        generation = state.generation + 1
        set_namespace_gates(kubernetes, "none", generation, require_safer=False)
        write_state(next_state(generation, "none", 0, 0), operation_id)
    PENDING_FILE.unlink()
    audit("abort-transition", operation_id, "succeeded", f"member={member}")
    alert(
        operation_id,
        "transition-aborted",
        f"transição {pending['phase']} abortada antes de concluir",
        status_value="resolved",
    )
    resolve_transition_alerts(operation_id, "transição abortada em estado seguro")
    print(f"secondary_slot_transition=aborted member={member}")


def reconcile(operation_id: str, confirmation: str) -> None:
    validate_operation_id(operation_id)
    require_confirmation("reconcile", confirmation)
    if not admission_is_installed(kubernetes, ADMISSION_MANIFEST):
        apply_admission(kubernetes, ADMISSION_MANIFEST)
    pending: dict[str, Any] | None = None
    if PENDING_FILE.exists() or PENDING_FILE.is_symlink():
        pending = read_pending()
    runtime = observe_runtime(kubernetes)
    occupant = runtime.unambiguous_occupant
    if occupant is None:
        alert(
            operation_id,
            "runtime-ambiguous",
            "runtime não permite escolher um ocupante com segurança",
            severity="critical",
        )
        fail("runtime ambíguo; nenhum lado foi autorizado")
    if occupant == "saferwpp":
        require_safer_namespaces(kubernetes)
    fingerprint = require_blindou_healthy_and_fingerprint(
        kubernetes, BLINDOU_CURRENT_RELEASE
    )
    if pending and fingerprint != pending["blindou_fingerprint"]:
        alert(
            str(pending["operation_id"]),
            "blindou-changed-during-transition",
            "mudança externa do Blindou detectada; estado do slot será reconciliado sem alterá-lo",
            severity="critical",
        )
    current: SlotState | None = None
    archive_invalid = False
    if STATE_FILE.exists() or STATE_FILE.is_symlink():
        require_secure_regular_file(STATE_FILE)
        try:
            current = parse_state(STATE_FILE.read_text(encoding="utf-8"))
        except ContractError:
            archive_invalid = True
    if current is not None:
        generation = current.generation + 1
    elif pending is not None:
        generation = int(pending["source_generation"]) + 2
    else:
        generation = 1
    reconciled = state_from_unambiguous_runtime(generation, runtime, utc_now())
    set_namespace_gates(kubernetes, "none", generation, require_safer=False)
    write_state(reconciled, operation_id, archive_invalid=archive_invalid)
    set_namespace_gates(
        kubernetes,
        occupant,
        generation,
        require_safer=occupant == "saferwpp",
    )
    if not namespace_gates_match(kubernetes, reconciled):
        fail("gates não convergiram durante a reconciliação")
    if pending:
        PENDING_FILE.unlink()
        resolve_transition_alerts(
            str(pending["operation_id"]), f"runtime reconciliado para {occupant}"
        )
    resolve_transition_alerts(operation_id, f"runtime reconciliado para {occupant}")
    audit("reconcile", operation_id, "succeeded", f"occupant={occupant}")
    print(f"secondary_slot_reconcile=passed occupant={occupant} generation={generation}")


def verify() -> None:
    require_no_pending()
    state, runtime = require_state_runtime_and_gates()
    require_blindou_healthy_and_fingerprint(kubernetes, BLINDOU_CURRENT_RELEASE)
    print(
        "secondary_slot_verify=passed "
