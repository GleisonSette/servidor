def dispatch(arguments: list[str]) -> None:
    if not arguments:
        fail("uso: secondary-slotctl {status|verify|metrics|transição fechada}")
    action = arguments[0]
    if action in {"status", "verify", "metrics"}:
        if len(arguments) != 1:
            fail(f"uso: secondary-slotctl {action}")
        {"status": show_status, "verify": verify, "metrics": collect_metrics}[action]()
        return
    if action == "initialize-apiwpp-active":
        if len(arguments) != 3:
            fail("uso: secondary-slotctl initialize-apiwpp-active OPERATION_ID CONFIRMAÇÃO")
        initialize_apiwpp_active(arguments[1], arguments[2])
        return
    if action in {
        "begin-suspend",
        "complete-suspend",
        "reserve",
        "complete-activation",
        "abort-transition",
    }:
        if len(arguments) != 4:
            fail(f"uso: secondary-slotctl {action} MEMBRO OPERATION_ID CONFIRMAÇÃO")
        callback = {
            "begin-suspend": begin_suspend,
            "complete-suspend": complete_suspend,
            "reserve": reserve,
            "complete-activation": complete_activation,
            "abort-transition": abort_transition,
        }[action]
        callback(arguments[1], arguments[2], arguments[3])
        return
    if action == "reconcile":
        if len(arguments) != 3:
            fail("uso: secondary-slotctl reconcile OPERATION_ID CONFIRMAÇÃO")
        reconcile(arguments[1], arguments[2])
        return
    fail("operação não permitida")


def execute_locked(action: str, operation_id: str) -> int:
    try:
        dispatch(sys.argv[1:])
        return 0
    except ContractError as error:
        if action not in {"unknown", "status", "verify", "metrics"}:
            try:
                audit(action, operation_id, "failed", str(error))
                alert(
                    operation_id,
                    "transition-needs-reconciliation",
                    f"{action}: {error}",
                    severity="critical",
                )
            except Exception:  # noqa: BLE001 - não mascara a falha operacional original
                pass
        print(f"[secondary-slotctl] ERRO: {error}", file=sys.stderr)
        return 1
    except Exception as error:  # noqa: BLE001 - fronteira operacional não vaza traceback
        detail = f"internal-error:{type(error).__name__}"
        if action not in {"unknown", "status", "verify", "metrics"}:
            try:
                audit(action, operation_id, "failed", detail)
                alert(
                    operation_id,
                    "transition-needs-reconciliation",
                    f"{action}: {detail}",
                    severity="critical",
                )
            except Exception:
                pass
        print("[secondary-slotctl] ERRO: falha operacional interna", file=sys.stderr)
        return 1


def main() -> int:
    os.umask(0o077)
    action = sys.argv[1] if len(sys.argv) > 1 else "unknown"
    operation_id = "read-only"
    for candidate in sys.argv[2:]:
        try:
            validate_operation_id(candidate)
            operation_id = candidate
            break
        except ContractError:
            continue
    try:
        require_root_host_and_runtime()
        with exclusive_slot_lock():
            return execute_locked(action, operation_id)
    except ContractError as error:
        print(f"[secondary-slotctl] ERRO: {error}", file=sys.stderr)
        return 1
    except Exception:  # noqa: BLE001 - falha anterior à fronteira auditável
        print("[secondary-slotctl] ERRO: falha operacional interna", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
