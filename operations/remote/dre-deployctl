  plan="$(load_and_verify_plan "$release_id" "$plan_sha")"
  previous="$(jq -r '.current_release' "$plan")"
  [[ "$previous" != none && "$previous" == "$(current_release_id)" ]] \
    || fail 'upgrade PostgreSQL exige uma release corrente igual à do plano'
