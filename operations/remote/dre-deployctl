      | atomic_write "${RECEIPT_ROOT}/postgres-upgrade-${operation_id}.json" 0600 \
      || true
    rm -f -- "$alert_backup"
    audit_event upgrade-postgres failed "$release_id" "$operation_id"
    exit "$code"
  }
  register_exit_trap postgres_upgrade_failed \
    "$release_id" "$operation_id" "$previous" "$backup_operation_id" \
    "$backup_receipt_sha" "$alert_backup" false
  work_started=true
  register_exit_trap postgres_upgrade_failed \
    "$release_id" "$operation_id" "$previous" "$backup_operation_id" \
    "$backup_receipt_sha" "$alert_backup" "$work_started"
  kube label namespace "$NAMESPACE" \
