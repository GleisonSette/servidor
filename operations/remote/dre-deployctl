    -o jsonpath='{.spec.template.spec.containers[0].image}')"
  [[ "$current_postgres" == "$old_image" ]] \
    || fail 'imagem PostgreSQL corrente diverge da release anterior'
  alert_backup="$(mktemp)"
  if [[ -f "$PROMETHEUS_RULES" && ! -L "$PROMETHEUS_RULES" ]]; then
