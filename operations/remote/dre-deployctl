}

main() {
  require_root
  local action="${1:-}"
  [[ -n "$action" ]] || fail 'ação obrigatória'
  shift
  mkdir -p "$RELEASE_CACHE" "$PLAN_ROOT" "$RECEIPT_ROOT"
  chmod 0700 "$STATE_ROOT" "$RELEASE_CACHE" "$PLAN_ROOT" "$RECEIPT_ROOT"
  chown root:root "$STATE_ROOT" "$RELEASE_CACHE" "$PLAN_ROOT" "$RECEIPT_ROOT"
  prune_expired_plans
  case "$action" in
    contract) contract "$@" ;;
    diagnose-production) diagnose_production "$@" ;;
    diagnose-validation) diagnose_validation "$@" ;;
    import-release) import_release "$@" ;;
    initialize-secrets) initialize_secrets "$@" ;;
    validate-release) validate_release_disposable "$@" ;;
    cleanup-validation) cleanup_validation "$@" ;;
    recover-first-deploy) recover_first_deploy "$@" ;;
    plan) create_plan "$@" ;;
    deploy) deploy_release "$@" ;;
    upgrade-postgres) upgrade_postgres "$@" ;;
    verify) verify_release "$@" ;;
    configure-edge) configure_edge "$@" ;;
    provision-accounts) provision_accounts "$@" ;;
    backup) backup_database "$@" ;;
    restore-drill) restore_drill "$@" ;;
    metrics) write_metrics "$@" ;;
    status) status "$@" ;;
    *) fail 'ação não permitida' ;;
  esac
}

main "$@"
