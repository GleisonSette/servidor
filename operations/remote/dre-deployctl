rollback_edge_connector_internal() {
  kube delete -f "$EDGE_RUNTIME" --ignore-not-found --wait=true >/dev/null
  kube -n "$EDGE_NAMESPACE" delete secret dre-cloudflare-tunnel \
    --ignore-not-found --wait=true >/dev/null
  kube label namespace "$EDGE_NAMESPACE" \
    platform.servidor.local/deployment-gate=blocked --overwrite >/dev/null
}

configure_edge() {
  [[ "$#" -eq 2 ]] || fail 'uso: configure-edge RELEASE_ID OPERATION_ID'
  local release_id="$1" operation_id="$2" protected_before receipt token
  require_cached_release "$release_id"
  require_schema_two_release "$release_id"
  require_operation_id "$operation_id"
  require_new_receipt edge "$operation_id"
  verify_cached_release_again "$release_id"
  verify_foundation
  verify_release_secret_inventory "$release_id"
  [[ "$(current_release_id)" == "$release_id" ]] \
    || fail 'release solicitada não é a corrente'
  verify_runtime_core "$release_id"
  [[ "$(kube get namespace "$EDGE_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}')" == blocked ]] \
    || fail 'configuração exige edge bloqueada e vazia'
  [[ ! -t 0 ]] || fail 'token do túnel deve chegar por stdin não interativo'
  IFS= read -r token || fail 'token do túnel não foi recebido'
  [[ ${#token} -ge 80 && ${#token} -le 4096 && "$token" =~ ^[A-Za-z0-9._~+/=-]+$ ]] \
    || { unset token; fail 'formato do token do túnel é inválido'; }
  verify_protected_projects
  acquire_controller_lock
  acquire_shared_maintenance_locks
  protected_before="$(protected_fingerprint)"
  receipt="${RECEIPT_ROOT}/edge-${operation_id}.json"
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg started_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"started",release_id:$release_id,operation_id:$operation_id,started_at_utc:$started_at_utc}' \
    | atomic_write "$receipt" 0600
  configure_edge_failed() {
    local code="$1" release_id="$2" operation_id="$3" receipt="$4"
    set +e
    rollback_edge_connector_internal || true
    jq -cn \
      --arg release_id "$release_id" \
      --arg operation_id "$operation_id" \
      --arg failed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{schema:1,status:"failed",release_id:$release_id,operation_id:$operation_id,rolled_back:true,failed_at_utc:$failed_at_utc}' \
      | atomic_write "$receipt" 0600 || true
    audit_event configure-edge failed "$release_id" "$operation_id"
    exit "$code"
  }
  register_exit_trap configure_edge_failed \
    "$release_id" "$operation_id" "$receipt"
  printf '%s' "$token" \
    | kube -n "$EDGE_NAMESPACE" create secret generic dre-cloudflare-tunnel \
        --from-file=token=/dev/stdin --dry-run=client -o yaml \
    | kube apply --server-side --field-manager=dre-deployctl -f - >/dev/null
  unset token
  kube apply --server-side --field-manager=dre-deployctl -f "$EDGE_RUNTIME" >/dev/null
  kube label namespace "$EDGE_NAMESPACE" \
    platform.servidor.local/deployment-gate=connector-only --overwrite >/dev/null
  kube -n "$EDGE_NAMESPACE" rollout status deployment/dre-cloudflared \
    --timeout=300s >/dev/null
  verify_edge_connector_runtime
  verify_runtime_core "$release_id"
  [[ "$(protected_fingerprint)" == "$protected_before" ]] \
    || fail 'recurso protegido mudou durante a configuração do edge DRE'
  release_shared_maintenance_locks
  verify_protected_projects
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg completed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"passed",release_id:$release_id,operation_id:$operation_id,namespace:"dre-edge",deployment:"dre-cloudflared",token_persisted_only_in_kubernetes:true,completed_at_utc:$completed_at_utc}' \
    | atomic_write "$receipt" 0600
  trap - EXIT
  audit_event configure-edge passed "$release_id" "$operation_id"
  pass 'conector Cloudflare DRE configurado sem persistir o token fora do Kubernetes'
}

provision_accounts() {
  [[ "$#" -eq 5 ]] \
    || fail 'uso: provision-accounts RELEASE_ID OPERATION_ID HOUSEHOLD_ID PRIMARY_USER_ID SECONDARY_USER_ID'
  local release_id="$1" operation_id="$2" household_id="$3"
  local primary_user_id="$4" secondary_user_id="$5" protected_before secrets_before
  local receipt rust_image provisioner_pod=dre-account-provisioner
  require_cached_release "$release_id"
  require_schema_two_release "$release_id"
  require_operation_id "$operation_id"
  for identifier in "$household_id" "$primary_user_id" "$secondary_user_id"; do
    [[ "$identifier" =~ $UUID_PATTERN ]] || fail 'UUID operacional inválido'
  done
  [[ "$household_id" != "$primary_user_id" \
    && "$household_id" != "$secondary_user_id" \
    && "$primary_user_id" != "$secondary_user_id" ]] \
    || fail 'UUIDs operacionais devem ser distintos'
  require_new_receipt accounts "$operation_id"
  verify_cached_release_again "$release_id"
  verify_foundation
  verify_release_secret_inventory "$release_id"
  [[ "$(current_release_id)" == "$release_id" ]] \
    || fail 'release solicitada não é a corrente'
  verify_runtime_core "$release_id"
  verify_protected_projects
  acquire_controller_lock
  acquire_shared_maintenance_locks
  protected_before="$(protected_fingerprint)"
  secrets_before="$(secret_inventory_fingerprint)"
  receipt="${RECEIPT_ROOT}/accounts-${operation_id}.json"
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg started_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"started",release_id:$release_id,operation_id:$operation_id,started_at_utc:$started_at_utc}' \
    | atomic_write "$receipt" 0600
  provision_accounts_failed() {
    local code="$1" release_id="$2" operation_id="$3" receipt="$4" pod="$5"
    local cleanup=passed
    set +e
    kube -n "$NAMESPACE" delete pod "$pod" --ignore-not-found \
      --wait=true --timeout=60s >/dev/null 2>&1 || cleanup=failed
    if [[ "$cleanup" == failed ]]; then
      kube label namespace "$NAMESPACE" \
        platform.servidor.local/deployment-gate=accounts-cleanup-failed \
        --overwrite >/dev/null 2>&1 || true
    fi
    jq -cn \
      --arg release_id "$release_id" \
      --arg operation_id "$operation_id" \
      --arg cleanup "$cleanup" \
      --arg failed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{schema:1,status:"failed",release_id:$release_id,operation_id:$operation_id,atomic:true,provisioner_cleanup:$cleanup,failed_at_utc:$failed_at_utc}' \
      | atomic_write "$receipt" 0600 || true
    audit_event provision-accounts failed "$release_id" "$operation_id"
    exit "$code"
  }
  register_exit_trap provision_accounts_failed \
    "$release_id" "$operation_id" "$receipt" "$provisioner_pod"
  if kube -n "$NAMESPACE" get pod "$provisioner_pod" >/dev/null 2>&1; then
    fail 'Pod administrativo efêmero preexistente'
  fi
  rust_image="$(release_rust_image "$release_id")"
  jq -cn --arg image "$rust_image" '{
    apiVersion:"v1",kind:"Pod",
    metadata:{
      name:"dre-account-provisioner",namespace:"dre-production",
      labels:{
        "app.kubernetes.io/name":"dre-account-provisioner",
        "app.kubernetes.io/component":"admin",
        "app.kubernetes.io/part-of":"dre-familiar",
        "app.kubernetes.io/managed-by":"dre-deployctl"
      }
    },
    spec:{
      restartPolicy:"Never",activeDeadlineSeconds:300,terminationGracePeriodSeconds:1,
      serviceAccountName:"dre-admin",automountServiceAccountToken:false,
      enableServiceLinks:false,imagePullSecrets:[{name:"dre-registry-pull"}],
      securityContext:{
        runAsNonRoot:true,runAsUser:65532,runAsGroup:65532,fsGroup:65532,
        fsGroupChangePolicy:"OnRootMismatch",seccompProfile:{type:"RuntimeDefault"}
      },
      containers:[{
        name:"provisioner",image:$image,imagePullPolicy:"IfNotPresent",
        command:["/bin/sleep"],args:["300"],
        env:[
          {name:"DRE_DATABASE_URL_FILE",value:"/var/run/secrets/dre/database-url"},
          {name:"DRE_DATABASE_MAX_CONNECTIONS",value:"2"},
          {name:"RUST_LOG",value:"info"}
        ],
        resources:{
          requests:{cpu:"50m",memory:"96Mi"},
          limits:{cpu:"500m",memory:"256Mi"}
        },
        securityContext:{
          allowPrivilegeEscalation:false,readOnlyRootFilesystem:true,
          capabilities:{drop:["ALL"]}
        },
        volumeMounts:[
          {name:"postgres-admin",mountPath:"/var/run/secrets/dre/database-url",subPath:"database-url",readOnly:true},
          {name:"temporary",mountPath:"/tmp"}
        ]
      }],
      volumes:[
        {name:"postgres-admin",secret:{secretName:"dre-postgres-admin",defaultMode:288,items:[{key:"database-url",path:"database-url"}]}},
        {name:"temporary",emptyDir:{sizeLimit:"32Mi"}}
      ]
    }
  }' | kube apply --server-side --field-manager=dre-deployctl -f - >/dev/null
  kube -n "$NAMESPACE" wait --for=condition=Ready \
    "pod/${provisioner_pod}" --timeout=120s >/dev/null
  kube -n "$NAMESPACE" get pod "$provisioner_pod" -o json \
    | jq -e --arg image "$rust_image" '
        .spec.serviceAccountName == "dre-admin"
        and .spec.automountServiceAccountToken == false
        and .spec.activeDeadlineSeconds == 300
        and (.spec.containers | length) == 1
        and .spec.containers[0].image == $image
        and .spec.containers[0].command == ["/bin/sleep"]
        and .spec.containers[0].args == ["300"]
        and (.spec.volumes[] | select(.name == "postgres-admin")
          | .secret.secretName == "dre-postgres-admin")
      ' >/dev/null || fail 'Pod administrativo efêmero divergiu do contrato'
  kube --request-timeout=120s -n "$NAMESPACE" exec -i "$provisioner_pod" \
    --container provisioner -- \
    /app/dre-admin-cli provision-private-family \
    --household-id "$household_id" \
    --household-name 'Família' \
    --primary-user-id "$primary_user_id" \
    --primary-login gleison \
    --primary-display-name Gleison \
    --secondary-user-id "$secondary_user_id" \
    --secondary-login aline \
    --secondary-display-name Aline \
    --passwords-stdin >/dev/null
  kube -n "$NAMESPACE" delete pod "$provisioner_pod" \
    --wait=true --timeout=60s >/dev/null
  if kube -n "$NAMESPACE" get pod "$provisioner_pod" >/dev/null 2>&1; then
    fail 'Pod administrativo efêmero permaneceu após o provisionamento'
  fi
  verify_runtime_core "$release_id"
  [[ "$(secret_inventory_fingerprint)" == "$secrets_before" ]] \
    || fail 'Secrets mudaram durante o provisionamento das contas DRE'
  [[ "$(protected_fingerprint)" == "$protected_before" ]] \
    || fail 'recurso protegido mudou durante o provisionamento das contas DRE'
  release_shared_maintenance_locks
  verify_protected_projects
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg household_id "$household_id" \
    --arg primary_user_id "$primary_user_id" \
    --arg secondary_user_id "$secondary_user_id" \
    --arg completed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"passed",release_id:$release_id,operation_id:$operation_id,household_id:$household_id,user_ids:[$primary_user_id,$secondary_user_id],accounts:["gleison","aline"],atomic:true,completed_at_utc:$completed_at_utc}' \
    | atomic_write "$receipt" 0600
  trap - EXIT
  audit_event provision-accounts passed "$release_id" "$operation_id"
  pass 'núcleo privado e contas Gleison/Aline provisionados atomicamente'
}

backup_database() {
  [[ "$#" -eq 2 ]] || fail 'uso: backup {full|diff} OPERATION_ID'
  local backup_type="$1" operation_id="$2" release_id info stop
  [[ "$backup_type" =~ ^(full|diff)$ ]] || fail 'tipo de backup inválido'
  require_operation_id "$operation_id"
  require_new_receipt backup "$operation_id"
  release_id="$(current_release_id)"
  [[ "$release_id" != none ]] || fail 'não existe release DRE corrente'
  verify_foundation
  verify_runtime_core "$release_id"
  acquire_controller_lock
  jq -cn \
    --arg type "$backup_type" \
    --arg operation_id "$operation_id" \
    --arg release_id "$release_id" \
    --arg started_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"started",type:$type,operation_id:$operation_id,release_id:$release_id,started_at_utc:$started_at_utc}' \
    | atomic_write "${RECEIPT_ROOT}/backup-${operation_id}.json" 0600
  backup_failed() {
    local code="$1" backup_type="$2" operation_id="$3" release_id="$4"
    set +e
    jq -cn \
      --arg type "$backup_type" \
      --arg operation_id "$operation_id" \
      --arg release_id "$release_id" \
      --arg failed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{schema:1,status:"failed",type:$type,operation_id:$operation_id,release_id:$release_id,failed_at_utc:$failed_at_utc}' \
      | atomic_write "${RECEIPT_ROOT}/backup-${operation_id}.json" 0600 || true
    audit_event backup failed "$release_id" "$operation_id"
    exit "$code"
  }
  register_exit_trap backup_failed "$backup_type" "$operation_id" "$release_id"
  kube -n "$NAMESPACE" exec dre-postgres-0 -- dre-pgbackrest "$backup_type" >/dev/null
  info="$(kube -n "$NAMESPACE" exec dre-postgres-0 -- dre-pgbackrest info)"
  jq -e 'type == "array" and length == 1 and .[0].name == "dre" and .[0].status.code == 0' \
    <<<"$info" >/dev/null || fail 'pgBackRest não confirmou o repositório saudável'
  stop="$(date -u +%s)"
  jq -cn \
    --arg type "$backup_type" \
    --arg operation_id "$operation_id" \
    --arg release_id "$release_id" \
    --argjson completed_at_epoch "$stop" \
    '{schema:1,status:"passed",type:$type,operation_id:$operation_id,release_id:$release_id,completed_at_epoch:$completed_at_epoch}' \
    | atomic_write "${RECEIPT_ROOT}/backup-${operation_id}.json" 0600
  trap - EXIT
  audit_event backup passed "$release_id" "$operation_id"
  pass "backup ${backup_type} concluído e conferido pelo pgBackRest"
}

restore_drill() {
  [[ "$#" -eq 3 ]] || fail 'uso: restore-drill RELEASE_ID OPERATION_ID {latest|YYYY-MM-DDTHH:MM:SSZ}'
  local release_id="$1" operation_id="$2" target="$3" temporary pvc_uid pv_name migration_count expected_migrations
  require_cached_release "$release_id"
  require_operation_id "$operation_id"
  require_new_receipt restore "$operation_id"
  [[ "$target" == latest || "$target" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
    || fail 'alvo de restore inválido'
  [[ "$(current_release_id)" == "$release_id" ]] || fail 'restore exige a release corrente'
  verify_foundation
  verify_runtime_core "$release_id"
  acquire_controller_lock
  if kube -n "$RESTORE_NAMESPACE" get statefulset dre-restore-postgres >/dev/null 2>&1 \
      || kube -n "$RESTORE_NAMESPACE" get pvc dre-restore-data >/dev/null 2>&1; then
    fail 'restore anterior ainda existe; reconciliação explícita é necessária'
  fi
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg target "$target" \
    --arg started_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"started",release_id:$release_id,operation_id:$operation_id,target:$target,started_at_utc:$started_at_utc}' \
    | atomic_write "${RECEIPT_ROOT}/restore-${operation_id}.json" 0600
  temporary="$(mktemp -d /run/dre-restore.XXXXXX)"
  trap 'rm -rf -- "$temporary"' RETURN
  restore_failed() {
    local code="$1" release_id="$2" operation_id="$3" target="$4" temporary="$5"
    set +e
    kube -n "$RESTORE_NAMESPACE" delete statefulset dre-restore-postgres --ignore-not-found --wait=true >/dev/null 2>&1
    kube -n "$RESTORE_NAMESPACE" delete service dre-restore-postgres --ignore-not-found >/dev/null 2>&1
    kube -n "$RESTORE_NAMESPACE" delete configmap dre-restore-postgres-config dre-restore-runtime-config --ignore-not-found >/dev/null 2>&1
    kube -n "$RESTORE_NAMESPACE" delete secret dre-registry-pull dre-backup-runtime --ignore-not-found >/dev/null 2>&1
    jq -cn \
      --arg release_id "$release_id" \
      --arg operation_id "$operation_id" \
      --arg target "$target" \
      --arg failed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{schema:1,status:"failed",release_id:$release_id,operation_id:$operation_id,target:$target,failed_at_utc:$failed_at_utc}' \
      | atomic_write "${RECEIPT_ROOT}/restore-${operation_id}.json" 0600 || true
    audit_event restore-drill failed "$release_id" "$operation_id"
    rm -rf -- "$temporary"
    exit "$code"
  }
  register_exit_trap restore_failed \
    "$release_id" "$operation_id" "$target" "$temporary"
  python3 "$RESTORE_RENDERER" \
    "$(release_file "$release_id" 00-platform.yaml)" \
    "$(release_postgres_image "$release_id")" "$operation_id" "$target" \
    "${temporary}/restore.yaml"
  for secret in dre-registry-pull dre-backup-runtime; do
    kube -n "$NAMESPACE" get secret "$secret" -o json \
      | jq --arg namespace "$RESTORE_NAMESPACE" \
        'del(.metadata.annotations,.metadata.creationTimestamp,.metadata.managedFields,.metadata.ownerReferences,.metadata.resourceVersion,.metadata.uid) | .metadata.namespace=$namespace' \
      | kube apply --server-side --field-manager=dre-deployctl -f - >/dev/null
  done
  kube apply --server-side --field-manager=dre-deployctl -f "${temporary}/restore.yaml" >/dev/null
  pvc_uid="$(kube -n "$RESTORE_NAMESPACE" get pvc dre-restore-data -o jsonpath='{.metadata.uid}')"
  kube -n "$RESTORE_NAMESPACE" rollout status statefulset/dre-restore-postgres --timeout=1200s >/dev/null
  migration_count="$(kube -n "$RESTORE_NAMESPACE" exec dre-restore-postgres-0 -- \
    psql --no-psqlrc --tuples-only --no-align -h /var/run/postgresql \
    -U dre_postgres_admin -d dre \
    --command='SELECT count(*) FROM _sqlx_migrations WHERE success')"
  expected_migrations="$(release_migration_count "$release_id")"
  [[ "${migration_count//[[:space:]]/}" == "$expected_migrations" ]] \
    || fail 'restore não confirmou as migrations declaradas pela release'
  [[ "$(kube -n "$RESTORE_NAMESPACE" exec dre-restore-postgres-0 -- \
    psql --no-psqlrc --tuples-only --no-align -h /var/run/postgresql \
    -U dre_postgres_admin -d dre \
    --command="SELECT count(*) FROM pg_index WHERE NOT indisvalid")" =~ ^[[:space:]]*0[[:space:]]*$ ]] \
    || fail 'restore contém índice inválido'
  pv_name="$(kube -n "$RESTORE_NAMESPACE" get pvc dre-restore-data -o jsonpath='{.spec.volumeName}')"
  kube -n "$RESTORE_NAMESPACE" delete statefulset dre-restore-postgres --wait=true >/dev/null
  kube -n "$RESTORE_NAMESPACE" delete service dre-restore-postgres >/dev/null
  kube -n "$RESTORE_NAMESPACE" delete configmap dre-restore-postgres-config dre-restore-runtime-config >/dev/null
  kube -n "$RESTORE_NAMESPACE" delete secret dre-registry-pull dre-backup-runtime >/dev/null
  kube -n "$RESTORE_NAMESPACE" delete pvc dre-restore-data --wait=true >/dev/null
  local deadline=$((SECONDS + 180))
  while admin_kube get pv "$pv_name" >/dev/null 2>&1; do
    ((SECONDS < deadline)) || fail 'PV descartável não foi removido pela StorageClass Delete'
    sleep 2
  done
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg target "$target" \
    --arg pvc_uid "$pvc_uid" \
    --argjson migrations "$expected_migrations" \
    --arg completed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"passed",release_id:$release_id,operation_id:$operation_id,target:$target,pvc_uid:$pvc_uid,migrations:$migrations,invalid_indexes:0,completed_at_utc:$completed_at_utc}' \
    | atomic_write "${RECEIPT_ROOT}/restore-${operation_id}.json" 0600
  trap - EXIT
  rm -rf -- "$temporary"
  trap - RETURN
  audit_event restore-drill passed "$release_id" "$operation_id"
  pass 'restore descartável validou migrations e índices e removeu o PV temporário'
}

write_metrics() {
  [[ "$#" -eq 0 ]] || fail 'uso: metrics'
  local temporary ready=0 release_expected=0 release_ready=0 edge_expected=0 edge_ready=0
  local backup_timestamp=0 restore_timestamp=0 validation_timestamp=0 cert_expiry=0 release edge_gate
  temporary="$(mktemp "${METRICS_FILE}.tmp.XXXXXX")"
  if (verify_foundation) >/dev/null 2>&1; then
    ready=1
  fi
  release="$(current_release_id 2>/dev/null || printf none)"
  if [[ "$release" != none ]]; then
    release_expected=1
    if (verify_runtime_core "$release") >/dev/null 2>&1; then
      release_ready=1
    fi
  fi
  edge_gate="$(kube get namespace "$EDGE_NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}' 2>/dev/null \
    || printf absent)"
  if [[ "$edge_gate" == connector-only ]]; then
    edge_expected=1
    if (verify_edge_connector_runtime) >/dev/null 2>&1; then
      edge_ready=1
    fi
  fi
  backup_timestamp="$(find "$RECEIPT_ROOT" -maxdepth 1 -type f -name 'backup-*.json' -print0 2>/dev/null \
    | xargs -0 -r jq -s '[.[].completed_at_epoch] | max // 0' 2>/dev/null || printf 0)"
  restore_timestamp="$(find "$RECEIPT_ROOT" -maxdepth 1 -type f -name 'restore-*.json' -print0 2>/dev/null \
    | xargs -0 -r jq -s '[.[].completed_at_utc | fromdateiso8601] | max // 0' 2>/dev/null || printf 0)"
  validation_timestamp="$(find "$RECEIPT_ROOT" -maxdepth 1 -type f -name 'validation-*.json' -print0 2>/dev/null \
    | xargs -0 -r jq -s '[.[] | select(.status == "passed") | .completed_at_utc | fromdateiso8601] | max // 0' 2>/dev/null || printf 0)"
  backup_timestamp="${backup_timestamp:-0}"
  restore_timestamp="${restore_timestamp:-0}"
  validation_timestamp="${validation_timestamp:-0}"
  if [[ -f /etc/dre-deployctl/client.crt ]]; then
    cert_expiry="$(date -u -d "$(openssl x509 -in /etc/dre-deployctl/client.crt -noout -enddate | cut -d= -f2)" +%s 2>/dev/null || printf 0)"
  fi
  local metric_value
  for metric_value in "$ready" "$release_expected" "$release_ready" "$edge_expected" "$edge_ready" \
    "$backup_timestamp" "$restore_timestamp" "$validation_timestamp" "$cert_expiry"; do
    [[ "$metric_value" =~ ^[0-9]+$ ]] || fail 'valor interno de métrica DRE inválido'
  done
  {
    printf '# HELP dre_controller_foundation_ready Fundação fechada do controlador DRE.\n'
    printf '# TYPE dre_controller_foundation_ready gauge\n'
    printf 'dre_controller_foundation_ready %s\n' "$ready"
    printf '# HELP dre_controller_release_expected Uma release DRE já foi promovida.\n'
    printf '# TYPE dre_controller_release_expected gauge\n'
    printf 'dre_controller_release_expected %s\n' "$release_expected"
    printf '# HELP dre_controller_release_ready Release corrente DRE verificada.\n'
    printf '# TYPE dre_controller_release_ready gauge\n'
    printf 'dre_controller_release_ready %s\n' "$release_ready"
    printf '# HELP dre_controller_edge_expected O conector HTTPS DRE foi configurado.\n'
    printf '# TYPE dre_controller_edge_expected gauge\n'
    printf 'dre_controller_edge_expected %s\n' "$edge_expected"
    printf '# HELP dre_controller_edge_ready O conector HTTPS DRE está disponível e íntegro.\n'
    printf '# TYPE dre_controller_edge_ready gauge\n'
    printf 'dre_controller_edge_ready %s\n' "$edge_ready"
    printf '# HELP dre_controller_backup_last_success_timestamp_seconds Último backup DRE concluído.\n'
    printf '# TYPE dre_controller_backup_last_success_timestamp_seconds gauge\n'
    printf 'dre_controller_backup_last_success_timestamp_seconds %s\n' "$backup_timestamp"
    printf '# HELP dre_controller_restore_last_success_timestamp_seconds Último restore drill DRE concluído.\n'
    printf '# TYPE dre_controller_restore_last_success_timestamp_seconds gauge\n'
    printf 'dre_controller_restore_last_success_timestamp_seconds %s\n' "$restore_timestamp"
    printf '# HELP dre_controller_validation_last_success_timestamp_seconds Última validação descartável DRE concluída.\n'
    printf '# TYPE dre_controller_validation_last_success_timestamp_seconds gauge\n'
    printf 'dre_controller_validation_last_success_timestamp_seconds %s\n' "$validation_timestamp"
    printf '# HELP dre_controller_identity_certificate_expiry_timestamp_seconds Expiração da identidade Kubernetes DRE.\n'
    printf '# TYPE dre_controller_identity_certificate_expiry_timestamp_seconds gauge\n'
    printf 'dre_controller_identity_certificate_expiry_timestamp_seconds %s\n' "$cert_expiry"
  } >"$temporary"
  chmod 0644 "$temporary"
  chown root:root "$temporary"
  mv -fT -- "$temporary" "$METRICS_FILE"
}

sanitize_diagnostic_output() {
  sed -E \
    -e 's#(postgres(ql)?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1[redacted]:[redacted]@#gI' \
    -e 's#((password|token|secret|api[_-]?key|access[_-]?key|aws_access_key_id|aws_secret_access_key|repo[0-9]+-s3-key(-secret)?)[=:])[[:graph:]]+#\1[redacted]#gI'
}

require_diagnostic_exact_names() {
  local resource="$1" expected="$2" actual
  actual="$(admin_kube -n "$NAMESPACE" get "$resource" \
    --ignore-not-found -o name | sort)"
  [[ "$actual" == "$expected" ]] \
    || fail "inventário ${resource} diverge do primeiro deploy revertido"
}

diagnose_production() {
  [[ "$#" -eq 0 ]] || fail 'uso: diagnose-production'
  local gate current pvc receipt receipt_state release_id release_manifest
  local postgres_image relation_absent namespace_project workloads events postgres_pod
  local postgres_log raw_output pgbackrest_info pgbackrest_info_code
  local check_log check_log_code archive_log archive_log_code
  require_root_file "$KUBECONFIG_FILE" '^600$'
  require_root_file "$TRUST_KEY" '^(600|644)$'
  require_root_file "$VERIFIER" '^(500|700|755)$'
  current="$(current_release_id)"
  gate="$(admin_kube get namespace "$NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}')"
  namespace_project="$(admin_kube get namespace "$NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/project}')"
  pvc="$(admin_kube -n "$NAMESPACE" get pvc dre-postgres-data \
    -o jsonpath='{.status.phase}' 2>/dev/null || printf absent)"
  [[ "$current" == none && "$gate" == secrets-only && "$pvc" == Bound ]] \
    || fail 'diagnóstico de produção exige primeiro deploy revertido com PVC preservado'
  receipt="$(find "$RECEIPT_ROOT" -maxdepth 1 -type f -name 'deploy-*.json' \
    -printf '%T@ %p\n' | sort -nr | head -n 1 | cut -d' ' -f2-)"
  [[ -n "$receipt" ]] || fail 'recibo de deploy ausente'
  require_root_file "$receipt" '^600$'
  jq -e \
    '.schema == 1 and .status == "failed" and .previous_release == "none" and .rollback == "passed" and (.release_id | test("^dre-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"))' \
    "$receipt" >/dev/null || fail 'recibo não comprova rollback do primeiro deploy'
  release_id="$(jq -r '.release_id' "$receipt")"
  release_manifest="$(release_file "$release_id" release.json)"
  [[ -f "$release_manifest" && ! -L "$release_manifest" ]] \
    || fail 'release do primeiro deploy não está no cache fechado'
  postgres_image="$(jq -r '.postgres_image' "$release_manifest")"
  [[ "$postgres_image" =~ ^[a-z0-9][a-z0-9._:/-]*@sha256:[0-9a-f]{64}$ ]] \
    || fail 'imagem PostgreSQL da release falha é inválida'
  require_diagnostic_exact_names deployments.apps ''
  require_diagnostic_exact_names statefulsets.apps 'statefulset.apps/dre-postgres'
  require_diagnostic_exact_names daemonsets.apps ''
  require_diagnostic_exact_names replicasets.apps ''
  require_diagnostic_exact_names replicationcontrollers ''
  require_diagnostic_exact_names jobs.batch ''
  require_diagnostic_exact_names cronjobs.batch ''
  require_diagnostic_exact_names pods 'pod/dre-postgres-0'
  require_diagnostic_exact_names services 'service/dre-postgres'
  require_diagnostic_exact_names persistentvolumeclaims \
    'persistentvolumeclaim/dre-postgres-data'
  [[ "$(admin_kube -n "$NAMESPACE" get statefulset dre-postgres \
      -o jsonpath='{.spec.replicas}:{.status.readyReplicas}:{.spec.template.spec.containers[0].image}')" \
      == "1:1:${postgres_image}" ]] \
    || fail 'PostgreSQL preservado diverge da release falha'
  [[ "$(admin_kube -n "$NAMESPACE" get pvc dre-postgres-data \
      -o jsonpath='{.status.phase}:{.spec.storageClassName}:{.spec.resources.requests.storage}')" \
      == 'Bound:dre-local-retain:20Gi' ]] \
    || fail 'PVC preservado diverge do volume retido aprovado'
  relation_absent="$(admin_kube -n "$NAMESPACE" exec dre-postgres-0 \
    --container postgres -- psql --no-psqlrc --tuples-only --no-align \
    -h /var/run/postgresql -U dre_postgres_admin -d dre \
    --command="SELECT to_regclass('public._sqlx_migrations') IS NULL")"
  [[ "${relation_absent//[[:space:]]/}" == t ]] \
    || fail 'diagnóstico exige falha anterior às migrations'
  receipt_state="$(jq -c \
    '{status:(.status // "unknown"),release_id:(.release_id // "unknown"),operation_id:(.operation_id // "unknown"),previous_release:(.previous_release // "unknown"),rollback:(.rollback // "unknown")}' \
    "$receipt")"
  workloads="$(admin_kube -n "$NAMESPACE" \
    get deployments.apps,statefulsets.apps,jobs.batch,persistentvolumeclaims -o json \
    | jq -c '[.items[] | {
        kind:.kind,
        name:.metadata.name,
        desired:(.spec.replicas // .spec.completions // 1),
        ready:(.status.readyReplicas // .status.succeeded // 0),
        failed:(.status.failed // 0),
        phase:(.status.phase // null),
        conditions:[.status.conditions[]? | select(.status == "False" or .type == "Failed") |
          {type:.type,reason:(.reason // "Unknown")}]
      }]')"
  events="$(admin_kube -n "$NAMESPACE" get events -o json | jq -c '
    [.items | sort_by(.metadata.creationTimestamp) | .[-25:][]? | {
      type:(.type // "Unknown"),
      reason:(.reason // "Unknown"),
      object:{kind:(.involvedObject.kind // "Unknown"),name:(.involvedObject.name // "unknown")},
      message:((.message // "") | tostring | .[0:512]),
      count:(.count // 1),
      last_seen:(.eventTime // .lastTimestamp // .metadata.creationTimestamp)
    }]')"
  postgres_pod="$(admin_kube -n "$NAMESPACE" get pods \
    -l app.kubernetes.io/name=dre-postgres,app.kubernetes.io/component=database \
    -o json | jq -er 'if (.items | length) == 1 then .items[0].metadata.name else error("pod count") end')" \
    || fail 'diagnóstico exige exatamente um Pod PostgreSQL'
  raw_output="$(admin_kube -n "$NAMESPACE" logs "$postgres_pod" \
    --container postgres --tail=120 --limit-bytes=32768 2>&1 || true)"
  postgres_log="$(printf '%s' "$raw_output" | sanitize_diagnostic_output)"
  set +e
  raw_output="$(admin_kube -n "$NAMESPACE" exec "$postgres_pod" --container postgres -- \
    dre-pgbackrest info 2>&1)"
  pgbackrest_info_code=$?
  set -e
  pgbackrest_info="$(printf '%s' "$raw_output" | sanitize_diagnostic_output)"
  set +e
  raw_output="$(admin_kube -n "$NAMESPACE" exec "$postgres_pod" --container postgres -- \
    tail -n 120 -- /tmp/pgbackrest/log/dre-check.log 2>&1)"
  check_log_code=$?
  set -e
  check_log="$(printf '%s' "$raw_output" | sanitize_diagnostic_output)"
  set +e
  raw_output="$(admin_kube -n "$NAMESPACE" exec "$postgres_pod" --container postgres -- \
    tail -n 120 -- /tmp/pgbackrest/log/dre-archive-push-async.log 2>&1)"
  archive_log_code=$?
  set -e
  archive_log="$(printf '%s' "$raw_output" | sanitize_diagnostic_output)"
  jq -cn \
    --arg gate "$gate" \
    --arg namespace_project "$namespace_project" \
    --arg current_release "$current" \
    --arg pvc "$pvc" \
    --arg pod "$postgres_pod" \
    --arg postgres_log "$postgres_log" \
    --arg pgbackrest_info "$pgbackrest_info" \
    --argjson pgbackrest_info_code "$pgbackrest_info_code" \
    --arg check_log "$check_log" \
    --argjson check_log_code "$check_log_code" \
    --arg archive_log "$archive_log" \
    --argjson archive_log_code "$archive_log_code" \
    --argjson receipt "$receipt_state" \
    --argjson workloads "$workloads" \
    --argjson events "$events" \
    '{schema:1,namespace:"dre-production",namespace_project:$namespace_project,gate:$gate,current_release:$current_release,pvc_phase:$pvc,deploy_receipt:$receipt,workloads:$workloads,events:$events,postgres:{pod:$pod,log:$postgres_log,pgbackrest_info:{exit_code:$pgbackrest_info_code,output:$pgbackrest_info},check_log:{exit_code:$check_log_code,output:$check_log},archive_log:{exit_code:$archive_log_code,output:$archive_log}}}'
}

diagnose_validation() {
  [[ "$#" -eq 0 ]] || fail 'uso: diagnose-validation'
  local gate release_id operation_id receipt receipt_state pods workloads events failed_logs
  local pod container raw_log sanitized_log postgres_pod postgres_ip postgres_logs
  local postgres_diagnostics service_state probe_host probe_output probe_code probe_status probes
  verify_foundation
  gate="$(admin_kube get namespace "$VALIDATION_NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}' 2>/dev/null \
    || printf absent)"
  [[ "$gate" == blocked ]] \
    || fail 'diagnóstico exige uma validação preservada com gate blocked'
  release_id="$(admin_kube get namespace "$VALIDATION_NAMESPACE" \
    -o jsonpath='{.metadata.labels.dre\.familiar/release-id}')"
  operation_id="$(admin_kube get namespace "$VALIDATION_NAMESPACE" \
    -o jsonpath='{.metadata.labels.dre\.familiar/operation-id}')"
  require_release_id "$release_id"
  require_operation_id "$operation_id"
  receipt="${RECEIPT_ROOT}/validation-${operation_id}.json"
  if [[ -f "$receipt" && ! -L "$receipt" ]]; then
    require_root_file "$receipt" '^600$'
    receipt_state="$(jq -c \
      '{status:(.status // "unknown"),phase:(.phase // "unknown"),preserved:(.preserved // null)}' \
      "$receipt")"
  else
    receipt_state='{"status":"absent","phase":"unknown","preserved":null}'
  fi
  pods="$(admin_kube -n "$VALIDATION_NAMESPACE" get pods -o json | jq -c '
    [.items[] | {
      name:.metadata.name,
      pod_ip:(.status.podIP // null),
      phase:(.status.phase // "Unknown"),
      ready:([.status.containerStatuses[]? | select(.ready == true)] | length),
      containers:(.spec.containers | length),
      restarts:([.status.containerStatuses[]?.restartCount] | add // 0),
      waiting:[.status.containerStatuses[]? | select(.state.waiting != null) |
        {container:.name,reason:(.state.waiting.reason // "Unknown")}],
      terminated:[.status.containerStatuses[]? | select(.state.terminated != null) |
        {container:.name,reason:(.state.terminated.reason // "Unknown"),exit_code:.state.terminated.exitCode}],
      conditions:[.status.conditions[]? | select(.status == "False") |
        {type:.type,reason:(.reason // "Unknown")}]
    }]')"
  workloads="$(admin_kube -n "$VALIDATION_NAMESPACE" \
    get deployments.apps,statefulsets.apps,jobs.batch -o json | jq -c '
      [.items[] | {
        kind:.kind,
        name:.metadata.name,
        desired:(.spec.replicas // .spec.completions // 1),
        ready:(.status.readyReplicas // .status.succeeded // 0),
        failed:(.status.failed // 0),
        conditions:[.status.conditions[]? | select(.status == "False" or .type == "Failed") |
          {type:.type,reason:(.reason // "Unknown")}]
      }]')"
  events="$(admin_kube -n "$VALIDATION_NAMESPACE" get events -o json | jq -c '
    [.items | sort_by(.metadata.creationTimestamp) | .[-25:][]? | {
      type:(.type // "Unknown"),
      reason:(.reason // "Unknown"),
      object:{kind:(.involvedObject.kind // "Unknown"),name:(.involvedObject.name // "unknown")},
      message:((.message // "") | tostring | .[0:512]),
      count:(.count // 1),
      last_seen:(.eventTime // .lastTimestamp // .metadata.creationTimestamp)
    }]')"
  service_state="$(admin_kube -n "$VALIDATION_NAMESPACE" get service dre-postgres -o json \
    | jq -c '{name:.metadata.name,cluster_ip:(.spec.clusterIP // null),selector:.spec.selector,ports:[.spec.ports[]? | {name,port,target_port:.targetPort,protocol}]}')"
  postgres_pod="$(admin_kube -n "$VALIDATION_NAMESPACE" get pods \
    -l app.kubernetes.io/name=dre-postgres,app.kubernetes.io/component=database \
    -o json | jq -r '.items | sort_by(.metadata.name) | .[0].metadata.name // empty')"
  postgres_diagnostics="$(jq -cn \
    --argjson service "$service_state" \
    '{status:"pod-absent",pod:null,pod_ip:null,service:$service,probes:[],log:""}')"
  if [[ -n "$postgres_pod" ]]; then
    postgres_ip="$(admin_kube -n "$VALIDATION_NAMESPACE" get pod "$postgres_pod" \
      -o jsonpath='{.status.podIP}')"
    raw_log="$(admin_kube -n "$VALIDATION_NAMESPACE" logs "$postgres_pod" \
      --container postgres --tail=80 --limit-bytes=16384 2>&1 || true)"
    postgres_logs="$(printf '%s' "$raw_log" | sanitize_diagnostic_output)"
    probes='[]'
    for probe_host in 127.0.0.1 "$postgres_ip"; do
      [[ -n "$probe_host" ]] || continue
      set +e
      probe_output="$(admin_kube -n "$VALIDATION_NAMESPACE" exec "$postgres_pod" \
        --container postgres -- /usr/local/bin/pg_isready \
        --host="$probe_host" --port=5432 --username=dre_postgres_admin \
        --dbname=dre --timeout=3 2>&1)"
      probe_code=$?
      set -e
      probe_output="$(printf '%s' "$probe_output" | sanitize_diagnostic_output)"
      if [[ "$probe_code" -eq 0 ]]; then
        probe_status=accepting
      else
        probe_status=failed
      fi
      probes="$(jq -cn \
        --argjson current "$probes" \
        --arg host "$probe_host" \
        --arg status "$probe_status" \
        --argjson exit_code "$probe_code" \
        --arg output "$probe_output" \
        '$current + [{host:$host,status:$status,exit_code:$exit_code,output:$output}]')"
    done
    postgres_diagnostics="$(jq -cn \
      --arg pod "$postgres_pod" \
      --arg pod_ip "$postgres_ip" \
      --argjson service "$service_state" \
      --argjson probes "$probes" \
      --arg log "$postgres_logs" \
      '{status:"observed",pod:$pod,pod_ip:$pod_ip,service:$service,probes:$probes,log:$log}')"
  fi
  failed_logs='[]'
  while IFS=$'\t' read -r pod container; do
    [[ -n "$pod" && -n "$container" ]] || continue
    raw_log="$(admin_kube -n "$VALIDATION_NAMESPACE" logs "$pod" \
      --container "$container" --tail=80 --limit-bytes=16384 2>&1 || true)"
    sanitized_log="$(printf '%s' "$raw_log" | sanitize_diagnostic_output)"
    failed_logs="$(jq -cn \
      --argjson current "$failed_logs" \
      --arg pod "$pod" \
      --arg container "$container" \
      --arg log "$sanitized_log" \
      '$current + [{pod:$pod,container:$container,log:$log}]')"
  done < <(admin_kube -n "$VALIDATION_NAMESPACE" get pods \
    -l app.kubernetes.io/part-of=dre-familiar -o json \
    | jq -r '[.items[] | select(.status.phase == "Failed")][0:5][] |
      .metadata.name as $pod | .spec.containers[] | [$pod,.name] | @tsv')
  jq -cn \
    --arg gate "$gate" \
    --arg release "$release_id" \
    --arg operation_id "$operation_id" \
    --argjson receipt "$receipt_state" \
    --argjson pods "$pods" \
    --argjson workloads "$workloads" \
    --argjson events "$events" \
    --argjson postgres "$postgres_diagnostics" \
    --argjson failed_logs "$failed_logs" \
    '{schema:1,namespace:"dre-validation",gate:$gate,release:$release,operation_id:$operation_id,receipt:$receipt,pods:$pods,workloads:$workloads,events:$events,postgres:$postgres,failed_logs:$failed_logs}'
}

status() {
  [[ "$#" -eq 0 ]] || fail 'uso: status'
  local release gate postgres_pvc api_ready worker_ready postgres_ready validation_gate validation_release edge_gate edge_ready
  release="$(current_release_id)"
  gate="$(kube get namespace "$NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}' 2>/dev/null || printf absent)"
  postgres_pvc="$(kube -n "$NAMESPACE" get pvc dre-postgres-data -o jsonpath='{.status.phase}' 2>/dev/null || printf absent)"
  api_ready="$(kube -n "$NAMESPACE" get deployment dre-api -o jsonpath='{.status.availableReplicas}' 2>/dev/null || printf 0)"
  worker_ready="$(kube -n "$NAMESPACE" get deployment dre-worker -o jsonpath='{.status.availableReplicas}' 2>/dev/null || printf 0)"
  postgres_ready="$(kube -n "$NAMESPACE" get statefulset dre-postgres -o jsonpath='{.status.readyReplicas}' 2>/dev/null || printf 0)"
  validation_gate="$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}' 2>/dev/null || printf absent)"
  validation_release="$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.dre\.familiar/release-id}' 2>/dev/null || printf none)"
  edge_gate="$(kube get namespace "$EDGE_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}' 2>/dev/null || printf absent)"
  edge_ready="$(kube -n "$EDGE_NAMESPACE" get deployment dre-cloudflared -o jsonpath='{.status.availableReplicas}' 2>/dev/null || printf 0)"
  jq -cn \
    --arg release "$release" --arg gate "$gate" --arg pvc "$postgres_pvc" \
    --arg validation_gate "$validation_gate" --arg validation_release "$validation_release" \
    --arg edge_gate "$edge_gate" \
    --argjson api_ready "${api_ready:-0}" --argjson worker_ready "${worker_ready:-0}" \
    --argjson postgres_ready "${postgres_ready:-0}" --argjson edge_ready "${edge_ready:-0}" \
    '{schema:2,namespace:"dre-production",release:$release,gate:$gate,pvc_phase:$pvc,ready:{api:$api_ready,worker:$worker_ready,postgres:$postgres_ready},edge:{namespace:"dre-edge",gate:$edge_gate,ready:$edge_ready},validation:{namespace:"dre-validation",gate:$validation_gate,release:$validation_release}}'
