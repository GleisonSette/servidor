#!/usr/bin/env bash
set -Eeuo pipefail

readonly PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
export PATH
readonly LC_ALL='C'
export LC_ALL
umask 077

readonly EXPECTED_HOSTNAME='apiwpp'
readonly K3S='/usr/local/bin/k3s'
readonly KUBECONFIG_FILE='/etc/dre-deployctl/kubeconfig'
readonly TRUST_KEY='/etc/dre-deployctl/release-signing.pub'
readonly VERIFIER='/usr/local/lib/dre-deployctl/dre-release-verify.py'
readonly SECRET_MATERIAL='/usr/local/lib/dre-deployctl/dre-secret-material.py'
readonly VALIDATION_MATERIAL='/usr/local/lib/dre-deployctl/dre-validation-material.py'
readonly VALIDATION_ACCESS='/usr/local/lib/dre-deployctl/validation-access.yaml'
readonly RESTORE_RENDERER='/usr/local/lib/dre-deployctl/dre-restore-render.py'
readonly EDGE_RUNTIME='/usr/local/lib/dre-deployctl/edge-runtime.yaml'
readonly STATE_ROOT='/var/lib/dre-deployctl'
readonly RELEASE_CACHE="${STATE_ROOT}/releases"
readonly RELEASE_INBOX='/home/apiadmin/dre-deploy-inbox'
readonly PLAN_ROOT="${STATE_ROOT}/plans"
readonly RECEIPT_ROOT="${STATE_ROOT}/receipts"
readonly CURRENT_RELEASE="${STATE_ROOT}/current-release"
readonly AUDIT_LOG="${STATE_ROOT}/audit.jsonl"
readonly METRICS_FILE='/var/lib/prometheus/node-exporter/dre-controller.prom'
readonly PROMETHEUS_RULES='/etc/prometheus/rules/dre-runtime.yml'
readonly NAMESPACE='dre-production'
readonly EDGE_NAMESPACE='dre-edge'
readonly RESTORE_NAMESPACE='dre-restore-drill'
readonly VALIDATION_NAMESPACE='dre-validation'
readonly EDGE_CONNECTOR_IMAGE='docker.io/cloudflare/cloudflared@sha256:18626b1baac4450214535cd5bc40ef44c0635244d585ebf707749c22b6f3408f'
readonly LOCK_FILE='/run/lock/dre-deployctl.lock'
readonly BLINDOU_LOCK='/run/lock/blindou-deployctl.lock'
readonly BLINDOU_DATA_LOCK='/run/lock/blindou-datactl.lock'
readonly SECONDARY_SLOT_LOCK='/run/lock/servidor-local-secondary-slot.lock'
readonly MIN_AVAILABLE_MEMORY_KIB=$((5 * 1024 * 1024))
readonly MIN_AVAILABLE_DISK_KIB=$((45 * 1024 * 1024))
readonly PLAN_TTL_SECONDS=1800
readonly PLAN_RETENTION_DAYS=7
readonly RELEASE_ID_PATTERN='^dre-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$'
readonly SHA256_PATTERN='^[0-9a-f]{64}$'
readonly OPERATION_ID_PATTERN='^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$'
readonly UUID_PATTERN='^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
readonly -a REQUIRED_SECRETS=(
  dre-registry-pull
  dre-postgres-admin
  dre-database-access
  dre-api-runtime
  dre-backup-runtime
)

fail() {
  printf '[dre-deployctl] ERRO: %s\n' "$*" >&2
  exit 1
}

pass() {
  printf '[dre-deployctl] OK: %s\n' "$*"
}

require_root() {
  [[ "${EUID}" -eq 0 ]] || fail 'execute como root pelo sudoers fechado'
}

require_release_id() {
  [[ "${1:-}" =~ $RELEASE_ID_PATTERN ]] || fail 'release ID inválido'
}

require_sha256() {
  [[ "${1:-}" =~ $SHA256_PATTERN ]] || fail 'SHA-256 inválido'
}

require_operation_id() {
  [[ "${1:-}" =~ $OPERATION_ID_PATTERN ]] || fail 'operation ID inválido'
}

require_new_receipt() {
  local kind="$1" operation_id="$2" receipt existing
  receipt="${RECEIPT_ROOT}/${kind}-${operation_id}.json"
  [[ ! -e "$receipt" && ! -L "$receipt" ]] \
    || fail "operation ID já utilizado em ${kind}"
  existing="$(find "$RECEIPT_ROOT" -mindepth 1 -maxdepth 1 \
    \( -type f -o -type l \) -name "*-${operation_id}.json" -print -quit)"
  [[ -z "$existing" ]] || fail 'operation ID já utilizado por outra operação DRE'
}

kube() {
  KUBECONFIG="$KUBECONFIG_FILE" "$K3S" kubectl "$@"
}

admin_kube() {
  "$K3S" kubectl "$@"
}

file_mode() {
  stat -c '%a' -- "$1"
}

file_owner() {
  stat -c '%U:%G' -- "$1"
}

require_root_file() {
  local path="$1" allowed_mode="$2"
  [[ -f "$path" && ! -L "$path" ]] || fail "arquivo ausente ou simbólico: ${path}"
  [[ "$(file_owner "$path")" == 'root:root' ]] || fail "ownership inválido: ${path}"
  [[ "$(file_mode "$path")" =~ $allowed_mode ]] || fail "modo inseguro: ${path}"
}

atomic_write() {
  local destination="$1" mode="$2" temporary
  temporary="$(mktemp "${destination}.tmp.XXXXXX")"
  cat >"$temporary"
  chmod "$mode" "$temporary"
  chown root:root "$temporary"
  mv -fT -- "$temporary" "$destination"
}

register_exit_trap() {
  local handler="$1" command argument
  shift
  printf -v command '%q "$?"' "$handler"
  for argument in "$@"; do
    printf -v command '%s %q' "$command" "$argument"
  done
  # A string foi construída com %q; "$?" precisa ser avaliado apenas no EXIT.
  # shellcheck disable=SC2064
  trap "$command" EXIT
}

audit_event() {
  local action="$1" result="$2" release_id="${3:-none}" operation_id="${4:-none}"
  local now
  now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  jq -cn \
    --arg timestamp "$now" \
    --arg action "$action" \
    --arg result "$result" \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    '{schema:1,timestamp_utc:$timestamp,action:$action,result:$result,release_id:$release_id,operation_id:$operation_id}' \
    >>"$AUDIT_LOG"
  chmod 0600 "$AUDIT_LOG"
  chown root:root "$AUDIT_LOG"
}

prune_expired_plans() {
  [[ -d "$PLAN_ROOT" && ! -L "$PLAN_ROOT" ]] \
    || fail 'diretório de planos ausente ou simbólico'
  [[ "$(file_owner "$PLAN_ROOT")" == 'root:root' ]] \
    || fail 'ownership inválido no diretório de planos'
  find "$PLAN_ROOT" -mindepth 1 -maxdepth 1 -type f -name '*.json' \
    -mtime "+${PLAN_RETENTION_DAYS}" -delete
}

acquire_controller_lock() {
  exec 7>"$LOCK_FILE"
  flock --nonblock 7 || fail 'outra operação DRE está em andamento'
}

acquire_shared_maintenance_locks() {
  exec 8>"$BLINDOU_LOCK"
  flock --nonblock 8 || fail 'operação Blindou em andamento'
  [[ -f "$SECONDARY_SLOT_LOCK" && ! -L "$SECONDARY_SLOT_LOCK" ]] \
    || fail 'lock do slot secundário ausente ou inseguro'
  exec 9<>"$SECONDARY_SLOT_LOCK"
  flock --nonblock 9 || fail 'transição APIWPP/SaferWPP em andamento'
  if admin_kube get namespace blindou-data >/dev/null 2>&1; then
    [[ -f "$BLINDOU_DATA_LOCK" && ! -L "$BLINDOU_DATA_LOCK" ]] \
      || fail 'lock do PostgreSQL Blindou ausente ou inseguro'
    exec 10<>"$BLINDOU_DATA_LOCK"
    flock --nonblock 10 || fail 'operação PostgreSQL Blindou em andamento'
  fi
}

release_shared_maintenance_locks() {
  if [[ -e /proc/$$/fd/10 ]]; then
    flock --unlock 10 || fail 'não foi possível liberar o lock do PostgreSQL Blindou'
    exec 10>&-
  fi
  if [[ -e /proc/$$/fd/9 ]]; then
    flock --unlock 9 || fail 'não foi possível liberar o lock do slot secundário'
    exec 9>&-
  fi
  if [[ -e /proc/$$/fd/8 ]]; then
    flock --unlock 8 || fail 'não foi possível liberar o lock Blindou'
    exec 8>&-
  fi
}

release_directory() {
  printf '%s/%s' "$RELEASE_CACHE" "$1"
}

release_file() {
  printf '%s/%s/extracted/%s' "$RELEASE_CACHE" "$1" "$2"
}

require_cached_release() {
  local release_id="$1" directory
  require_release_id "$release_id"
  directory="$(release_directory "$release_id")"
  [[ -d "$directory" && ! -L "$directory" ]] || fail 'release não está no cache fechado'
  require_root_file "${directory}/release.tar.gz" '^600$'
  require_root_file "${directory}/release.tar.gz.sig" '^600$'
  require_root_file "${directory}/receipt.json" '^600$'
  [[ -d "${directory}/extracted" && ! -L "${directory}/extracted" ]] \
    || fail 'conteúdo extraído da release ausente'
  jq -e --arg release "$release_id" \
    '.schema == 1 and .release_id == $release and (.archive_sha256 | test("^[0-9a-f]{64}$"))' \
    "${directory}/receipt.json" >/dev/null || fail 'recibo da release inválido'
}

release_archive_sha() {
  jq -r '.archive_sha256' "$(release_directory "$1")/receipt.json"
}

release_rust_image() {
  jq -r '.rust_image' "$(release_file "$1" release.json)"
}

release_postgres_image() {
  jq -r '.postgres_image' "$(release_file "$1" release.json)"
}

release_validation_image() {
  jq -r '.validation_image // empty' "$(release_file "$1" release.json)"
}

release_schema() {
  jq -r '.schema' "$(release_file "$1" release.json)"
}

release_migration_count() {
  jq -r 'if .schema == 1 then 7 else .migration_count end' \
    "$(release_file "$1" release.json)"
}

normalized_postgres_stage_sha() {
  local release_id="$1" stage="$2" postgres_image="$3" expected_count="$4"
  python3 - "$(release_file "$release_id" "$stage")" \
    "$postgres_image" "$expected_count" <<'PY'
import hashlib
import pathlib
import sys

manifest = pathlib.Path(sys.argv[1]).read_bytes()
image = sys.argv[2].encode("ascii")
expected_count = int(sys.argv[3])
if manifest.count(image) != expected_count:
    raise SystemExit("manifesto não contém a quantidade esperada da imagem PostgreSQL")
normalized = manifest.replace(image, b"DRE_POSTGRES_IMAGE_BY_DIGEST")
print(hashlib.sha256(normalized).hexdigest())
PY
}

require_postgres_upgrade_compatibility() {
  local previous="$1" release_id="$2" old_image new_image stage
  old_image="$(release_postgres_image "$previous")"
  new_image="$(release_postgres_image "$release_id")"
  [[ "$old_image" != "$new_image" ]] \
    || fail 'upgrade PostgreSQL exige digest novo'
  [[ "$(release_rust_image "$previous")" == "$(release_rust_image "$release_id")" ]] \
    || fail 'upgrade PostgreSQL não pode alterar a imagem Rust'
  [[ "$(release_migration_count "$previous")" == "$(release_migration_count "$release_id")" ]] \
    || fail 'upgrade PostgreSQL não pode alterar o conjunto de migrations'
  for stage in 10-migrations.yaml 30-runtime.yaml; do
    [[ "$(sha256sum "$(release_file "$previous" "$stage")" | cut -d' ' -f1)" \
      == "$(sha256sum "$(release_file "$release_id" "$stage")" | cut -d' ' -f1)" ]] \
      || fail "upgrade PostgreSQL alterou estágio não permitido: ${stage}"
  done
  [[ "$(normalized_postgres_stage_sha \
      "$previous" 20-database-access.yaml "$old_image" 2)" \
    == "$(normalized_postgres_stage_sha \
      "$release_id" 20-database-access.yaml "$new_image" 2)" ]] \
    || fail 'upgrade PostgreSQL alterou o acesso ao banco além do digest da imagem'
  [[ "$(normalized_postgres_stage_sha \
      "$previous" 00-platform.yaml "$old_image" 1)" \
    == "$(normalized_postgres_stage_sha \
      "$release_id" 00-platform.yaml "$new_image" 1)" ]] \
    || fail 'upgrade PostgreSQL alterou a plataforma além do digest do banco'
}

require_postgres_upgrade_backup() {
  local release_id="$1" backup_operation_id="$2" plan="$3" receipt completed generated now
  require_operation_id "$backup_operation_id"
  receipt="${RECEIPT_ROOT}/backup-${backup_operation_id}.json"
  require_root_file "$receipt" '^600$'
  jq -e --arg release_id "$release_id" \
    '.schema == 1 and .status == "passed" and .release_id == $release_id and (.type == "full" or .type == "diff") and (.completed_at_epoch | type == "number")' \
    "$receipt" >/dev/null || fail 'recibo de backup não autoriza o upgrade PostgreSQL'
  completed="$(jq -r '.completed_at_epoch' "$receipt")"
  generated="$(jq -r '.generated_at_epoch' "$plan")"
  now="$(date -u +%s)"
  [[ "$completed" -ge "$generated" && "$completed" -le "$now" ]] \
    || fail 'backup do upgrade PostgreSQL deve ser posterior ao plano vigente'
  sha256sum "$receipt" | cut -d' ' -f1
}

require_schema_two_release() {
  local release_id="$1"
  [[ "$(release_schema "$release_id")" == 2 ]] \
    || fail 'operação exige release schema 2; schema 1 permanece apenas para rollback'
  [[ "$(release_migration_count "$release_id")" == 9 ]] \
    || fail 'release schema 2 não declara nove migrations'
}

current_release_id() {
  if [[ -f "$CURRENT_RELEASE" && ! -L "$CURRENT_RELEASE" ]]; then
    local value
    value="$(<"$CURRENT_RELEASE")"
    require_release_id "$value"
    printf '%s' "$value"
  else
    printf 'none'
  fi
}

run_protected_command_with_retry() {
  local busy_message="$1"
  shift
  local output attempt code
  for ((attempt = 1; attempt <= 12; attempt++)); do
    set +e
    output="$("$@" 2>&1)"
    code="$?"
    set -e
    if [[ "$code" -eq 0 ]]; then
      printf '%s\n' "$output"
      return 0
    fi
    if [[ "$code" -ne 2 || "$output" != "$busy_message" ]]; then
      printf '%s\n' "$output" >&2
      return "$code"
    fi
    if [[ "$attempt" -lt 12 ]]; then
      sleep 5
    fi
  done
  printf '%s\n' "$output" >&2
  return "$code"
}

verify_protected_projects() {
  local controller slot_output occupant apiwpp_workloads saferwpp_workloads
  for controller in \
    /usr/local/sbin/apiwpp-deployctl \
    /usr/local/sbin/blindou-deployctl \
    /usr/local/sbin/secondary-slotctl; do
    [[ -x "$controller" && ! -L "$controller" ]] \
      || fail "controlador de proteção ausente: ${controller}"
  done
  run_protected_command_with_retry \
    '[blindou-deployctl] ERRO: outra operação Blindou está em andamento' \
    /usr/local/sbin/blindou-deployctl status >/dev/null \
    || fail 'Blindou não está íntegro'
  slot_output="$(run_protected_command_with_retry \
    '[secondary-slotctl] ERRO: outra operação do slot está em andamento' \
    /usr/local/sbin/secondary-slotctl verify)" \
    || fail 'slot APIWPP/SaferWPP não está íntegro'
  if [[ "$slot_output" =~ ^secondary_slot_verify=passed[[:space:]]occupant=(none|apiwpp|saferwpp)[[:space:]]generation=([0-9]+)[[:space:]]apiwpp_workloads=([0-9]+)[[:space:]]saferwpp_workloads=([0-9]+)$ ]]; then
    occupant="${BASH_REMATCH[1]}"
    apiwpp_workloads="${BASH_REMATCH[3]}"
    saferwpp_workloads="${BASH_REMATCH[4]}"
  else
    fail 'atestado do slot secundário possui formato inesperado'
  fi
  case "$occupant" in
    none)
      [[ "$apiwpp_workloads" == 0 && "$saferwpp_workloads" == 0 ]] \
        || fail 'slot none possui workload ativo'
      ;;
    apiwpp)
      [[ "$saferwpp_workloads" == 0 ]] || fail 'slot APIWPP possui workload SaferWPP'
      if [[ "$apiwpp_workloads" != 0 ]]; then
        run_protected_command_with_retry \
          'another apiwpp deployment is already running' \
          /usr/local/sbin/apiwpp-deployctl verify >/dev/null \
          || fail 'APIWPP ocupante não está íntegro'
      fi
      ;;
    saferwpp)
      [[ "$apiwpp_workloads" == 0 && "$saferwpp_workloads" != 0 ]] \
        || fail 'slot SaferWPP possui contagem incompatível'
      [[ -x /usr/local/sbin/saferwpp-deployctl \
        && ! -L /usr/local/sbin/saferwpp-deployctl ]] \
        || fail 'SaferWPP ocupante não possui controlador fechado'
      /usr/local/sbin/saferwpp-deployctl verify >/dev/null \
        || fail 'SaferWPP ocupante não está íntegro'
      ;;
  esac
  if admin_kube get namespace blindou-data >/dev/null 2>&1; then
    [[ -x /usr/local/sbin/blindou-datactl && ! -L /usr/local/sbin/blindou-datactl ]] \
      || fail 'namespace blindou-data existe sem controlador próprio'
  fi
}

protected_fingerprint() {
  local temporary namespace
  local -a namespaces=(apiwpp blindou-production blindou-edge)
  temporary="$(mktemp)"
  trap 'rm -f -- "$temporary"' RETURN
  if admin_kube get namespace blindou-data >/dev/null 2>&1; then
    namespaces+=(blindou-data)
  fi
  for namespace in saferwpp-lab saferdock-identity saferdock-platform; do
    if admin_kube get namespace "$namespace" >/dev/null 2>&1; then
      namespaces+=("$namespace")
    fi
  done
  for namespace in "${namespaces[@]}"; do
    admin_kube get namespace "$namespace" -o json \
      | jq -cS '{kind,metadata:{name:.metadata.name,uid:.metadata.uid,labels:.metadata.labels}}' \
      >>"$temporary"
    admin_kube -n "$namespace" get deployment,statefulset,service,pvc -o json \
      | jq -cS '[.items[]|{apiVersion,kind,metadata:{name:.metadata.name,uid:.metadata.uid},spec}]|sort_by(.kind,.metadata.name)' \
      >>"$temporary"
  done
  sha256sum "$temporary" | cut -d' ' -f1
  rm -f -- "$temporary"
  trap - RETURN
}

require_production_recovery_exact_names() {
  local resource="$1" expected="$2" actual
  actual="$(admin_kube -n "$NAMESPACE" get "$resource" \
    --ignore-not-found -o name | sort)"
  [[ "$actual" == "$expected" ]] \
    || fail "inventário ${resource} diverge da recuperação do primeiro deploy"
}

failed_first_deploy_release_id() {
  local receipt
  receipt="$(find "$RECEIPT_ROOT" -maxdepth 1 -type f -name 'deploy-*.json' \
    -printf '%T@ %p\n' | sort -nr | head -n 1 | cut -d' ' -f2-)"
  [[ -n "$receipt" ]] || fail 'recibo do primeiro deploy falho está ausente'
  require_root_file "$receipt" '^600$'
  jq -e \
    '.schema == 1 and .status == "failed" and .previous_release == "none" and .rollback == "passed" and (.release_id | test("^dre-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}$"))' \
    "$receipt" >/dev/null || fail 'recibo não comprova rollback do primeiro deploy'
  jq -r '.release_id' "$receipt"
}

production_migrations_absent() {
  local relation_absent
  relation_absent="$(admin_kube -n "$NAMESPACE" exec dre-postgres-0 \
    --container postgres -- psql --no-psqlrc --tuples-only --no-align \
    -h /var/run/postgresql -U dre_postgres_admin -d dre \
    --command="SELECT to_regclass('public._sqlx_migrations') IS NULL")"
  [[ "${relation_absent//[[:space:]]/}" == t ]]
}

require_failed_first_deploy_recovery_state() {
  local expected_project="$1" project gate pvc failed_release postgres_image secret_names
  [[ "$expected_project" == missing || "$expected_project" == dre ]] \
    || fail 'estado esperado do rótulo de recuperação é inválido'
  [[ "$(current_release_id)" == none ]] \
    || fail 'recuperação do primeiro deploy exige release corrente ausente'
  project="$(admin_kube get namespace "$NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/project}')"
  if [[ "$expected_project" == missing ]]; then
    [[ -z "$project" ]] || fail 'recuperação exige rótulo de projeto ausente'
  else
    [[ "$project" == dre ]] || fail 'recuperação não restaurou o rótulo do projeto DRE'
  fi
  gate="$(admin_kube get namespace "$NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}')"
  pvc="$(admin_kube -n "$NAMESPACE" get pvc dre-postgres-data \
    -o jsonpath='{.status.phase}' 2>/dev/null || printf absent)"
  [[ "$gate" == secrets-only && "$pvc" == Bound ]] \
    || fail 'recuperação exige gate secrets-only e PVC Bound'
  failed_release="$(failed_first_deploy_release_id)"
  require_cached_release "$failed_release"
  postgres_image="$(release_postgres_image "$failed_release")"
  require_production_recovery_exact_names deployments.apps ''
  require_production_recovery_exact_names statefulsets.apps 'statefulset.apps/dre-postgres'
  require_production_recovery_exact_names daemonsets.apps ''
  require_production_recovery_exact_names replicasets.apps ''
  require_production_recovery_exact_names replicationcontrollers ''
  require_production_recovery_exact_names jobs.batch ''
  require_production_recovery_exact_names cronjobs.batch ''
  require_production_recovery_exact_names pods 'pod/dre-postgres-0'
  require_production_recovery_exact_names services 'service/dre-postgres'
  require_production_recovery_exact_names persistentvolumeclaims \
    'persistentvolumeclaim/dre-postgres-data'
  [[ "$(admin_kube -n "$NAMESPACE" get statefulset dre-postgres \
      -o jsonpath='{.spec.replicas}:{.status.readyReplicas}:{.spec.template.spec.containers[0].image}')" \
      == "1:1:${postgres_image}" ]] \
    || fail 'PostgreSQL preservado diverge da release do primeiro deploy'
  [[ "$(admin_kube -n "$NAMESPACE" get pvc dre-postgres-data \
      -o jsonpath='{.status.phase}:{.spec.storageClassName}:{.spec.resources.requests.storage}')" \
      == 'Bound:dre-local-retain:20Gi' ]] \
    || fail 'PVC preservado diverge do volume retido aprovado'
  secret_names="$(admin_kube -n "$NAMESPACE" get secrets -o json \
    | jq -r '.items[].metadata.name' | sort)"
  [[ "$secret_names" == $'dre-api-runtime\ndre-backup-runtime\ndre-database-access\ndre-postgres-admin\ndre-registry-pull' ]] \
    || fail 'Secrets divergem do inventário fechado da recuperação'
  production_migrations_absent \
    || fail 'recuperação exige falha anterior às migrations'
}

production_recovery_immutable_fingerprint() {
  {
    admin_kube get namespace "$NAMESPACE" -o json | jq -cS '
      del(
        .metadata.labels["platform.servidor.local/project"],
        .metadata.creationTimestamp,
        .metadata.generation,
        .metadata.managedFields,
        .metadata.resourceVersion,
        .status
      )'
    admin_kube -n "$NAMESPACE" get statefulsets.apps -o json | jq -cS '
      [.items[] |
        del(
          .metadata.creationTimestamp,
          .metadata.generation,
          .metadata.managedFields,
          .metadata.resourceVersion,
          .status
        ) |
        .spec.template.spec.containers |= map(del(.image))
      ] | sort_by(.kind,.metadata.name)'
    admin_kube -n "$NAMESPACE" \
      get services,persistentvolumeclaims,configmaps,secrets,serviceaccounts,limitranges,resourcequotas,networkpolicies.networking.k8s.io,poddisruptionbudgets.policy \
      -o json | jq -cS '
        [.items[] |
          del(
            .metadata.creationTimestamp,
            .metadata.generation,
            .metadata.managedFields,
            .metadata.resourceVersion,
            .status
          )
        ] | sort_by(.kind,.metadata.name)'
  } | sha256sum | cut -d' ' -f1
}

secrets_encryption_enabled() {
  "$K3S" secrets-encrypt status 2>/dev/null \
    | grep -Eq 'Encryption Status:[[:space:]]+Enabled|Encryption Status:[[:space:]]+enabled'
}

verify_foundation() {
  local mode="${1:-strict}" production_project
  [[ "$#" -le 1 && ("$mode" == strict || "$mode" == allow-failed-first-deploy) ]] \
    || fail 'modo de verificação da fundação inválido'
  [[ "$(hostname)" == "$EXPECTED_HOSTNAME" ]] || fail 'hostname inesperado'
  [[ "$(uname -m)" == 'x86_64' ]] || fail 'nó não é x86_64'
  [[ "$($K3S --version | head -n 1)" == 'k3s version v1.36.2+k3s1 '* ]] \
    || fail 'versão K3s diferente de v1.36.2+k3s1'
  require_root_file "$KUBECONFIG_FILE" '^600$'
  require_root_file "$TRUST_KEY" '^(600|644)$'
  require_root_file "$VERIFIER" '^(500|700|755)$'
  require_root_file "$SECRET_MATERIAL" '^(500|700|755)$'
  require_root_file "$VALIDATION_MATERIAL" '^(500|700|755)$'
  require_root_file "$VALIDATION_ACCESS" '^(600|644)$'
  require_root_file "$RESTORE_RENDERER" '^(500|700|755)$'
  require_root_file "$EDGE_RUNTIME" '^(600|644)$'
  kube auth whoami -o json \
    | jq -e '.status.userInfo.username == "dre-deployctl"' >/dev/null \
    || fail 'kubeconfig não usa a identidade dre-deployctl'
  production_project="$(kube get namespace "$NAMESPACE" \
    -o jsonpath='{.metadata.labels.platform\.servidor\.local/project}')"
  if [[ "$production_project" != dre ]]; then
    [[ "$mode" == allow-failed-first-deploy && -z "$production_project" ]] \
      || fail 'namespace de produção fora do projeto DRE'
    require_failed_first_deploy_recovery_state missing
  fi
  [[ "$(kube get namespace "$EDGE_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/project}')" == dre ]] \
    || fail 'namespace de edge fora do projeto DRE'
  [[ "$(kube get namespace "$EDGE_NAMESPACE" -o jsonpath='{.metadata.labels.dre\.familiar/api-access}')" == true ]] \
    || fail 'namespace de edge não possui acesso explícito à API DRE'
  [[ "$(kube get namespace "$RESTORE_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}')" == restore-only ]] \
    || fail 'namespace de restore não está fechado'
  if admin_kube get namespace "$VALIDATION_NAMESPACE" >/dev/null 2>&1; then
    [[ "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/project}')" == dre \
      && "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.dre\.familiar/lifecycle}')" == disposable ]] \
      || fail 'namespace de validação existente está fora do escopo descartável DRE'
  fi
  [[ "$(kube get storageclass dre-local-retain -o jsonpath='{.reclaimPolicy}')" == Retain ]] \
    || fail 'StorageClass de produção não usa Retain'
  [[ "$(kube get storageclass dre-local-delete-drill -o jsonpath='{.reclaimPolicy}')" == Delete ]] \
    || fail 'StorageClass de restore não usa Delete'
  admin_kube get validatingadmissionpolicy dre-controller-only -o name >/dev/null \
    || fail 'admissão exclusiva do DRE ausente'
  admin_kube get validatingadmissionpolicybinding dre-controller-only -o name >/dev/null \
    || fail 'binding da admissão exclusiva do DRE ausente'
  secrets_encryption_enabled || fail 'criptografia de Secrets do K3s não está habilitada'
  verify_edge_baseline
  case "$(kube get namespace "$EDGE_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}')" in
    blocked)
      [[ "$(admin_kube -n "$EDGE_NAMESPACE" get deployment,secret -o json \
        | jq '[.items[]] | length')" == 0 ]] \
        || fail 'edge bloqueada contém Deployment ou Secret'
      ;;
    connector-only)
      verify_edge_connector_runtime
      ;;
    *) fail 'gate do namespace de edge é inválido' ;;
  esac
}

verify_edge_baseline() {
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get serviceaccount dre-cloudflared \
    -o jsonpath='{.automountServiceAccountToken}')" == false ]] \
    || fail 'ServiceAccount do cloudflared permite token automático'
  admin_kube -n "$EDGE_NAMESPACE" get limitrange dre-edge-defaults >/dev/null \
    || fail 'LimitRange do edge ausente'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get resourcequota dre-edge-quota \
    -o jsonpath='{.spec.hard.pods}')" == 1 ]] \
    || fail 'quota do edge não limita a um Pod'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get resourcequota dre-edge-quota \
    -o jsonpath='{.spec.hard.services}')" == 0 ]] \
    || fail 'quota do edge permite Service'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get resourcequota dre-edge-quota \
    -o jsonpath='{.spec.hard.secrets}')" == 1 ]] \
    || fail 'quota do edge não limita a um Secret'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get networkpolicy -o json | jq -r \
    '[.items[].metadata.name] | sort | join(",")')" == \
    'allow-cloudflare-edge,allow-cluster-dns,allow-dre-api-origin,default-deny' ]] \
    || fail 'NetworkPolicies do edge divergem'
  admin_kube -n "$EDGE_NAMESPACE" get configmap -o json | jq -e '
    (.items | length) <= 1 and
    all(.items[];
      .metadata.name == "kube-root-ca.crt" and
      ((.data // {}) | keys) == ["ca.crt"] and
      ((.data["ca.crt"] // "") | startswith("-----BEGIN CERTIFICATE-----")) and
      ((.binaryData // {}) | length) == 0 and
      (.immutable // false) == false
    )' >/dev/null \
    || fail 'edge contém ConfigMap diferente da CA sistêmica do Kubernetes'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get statefulset,daemonset,job,cronjob,service,pvc \
    -o json | jq '[.items[]] | length')" == 0 ]] \
    || fail 'edge contém objeto proibido'
}

verify_edge_connector_runtime() {
  kube -n "$EDGE_NAMESPACE" get deployment dre-cloudflared -o name >/dev/null \
    || fail 'Deployment do cloudflared ausente'
  kube -n "$EDGE_NAMESPACE" get secret dre-cloudflare-tunnel -o name >/dev/null \
    || fail 'Secret do túnel ausente'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get resourcequota dre-edge-quota \
    -o jsonpath='{.status.used.count/deployments\.apps}')" == 1 ]] \
    || fail 'quantidade viva de Deployments do edge diverge'
  [[ "$(admin_kube -n "$EDGE_NAMESPACE" get resourcequota dre-edge-quota \
    -o jsonpath='{.status.used.secrets}')" == 1 ]] \
    || fail 'quantidade viva de Secrets do edge diverge'
  [[ "$(namespaced_secret_key_set "$EDGE_NAMESPACE" dre-cloudflare-tunnel)" == token ]] \
    || fail 'Secret do túnel não contém somente token'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment dre-cloudflared \
    -o jsonpath='{.spec.template.spec.containers[0].image}')" == "$EDGE_CONNECTOR_IMAGE" ]] \
    || fail 'imagem imutável do cloudflared diverge'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment dre-cloudflared -o json | jq -c \
    '.spec.template.spec.containers[0].args')" == \
    '["tunnel","--no-autoupdate","--protocol","http2","--metrics","0.0.0.0:20241","run","--token-file","/etc/cloudflared/token"]' ]] \
    || fail 'argumentos do cloudflared divergem'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment dre-cloudflared \
    -o jsonpath='{.spec.template.spec.automountServiceAccountToken}')" == false ]] \
    || fail 'cloudflared permite token automático da ServiceAccount'
  [[ "$(kube -n "$EDGE_NAMESPACE" get deployment dre-cloudflared \
    -o jsonpath='{.status.availableReplicas}')" == 1 ]] \
    || fail 'cloudflared não possui uma réplica disponível'
  [[ "$(kube -n "$EDGE_NAMESPACE" get pod \
    -l app.kubernetes.io/name=dre-cloudflared -o json | jq '[.items[]] | length')" == 1 ]] \
    || fail 'edge não possui exatamente um Pod cloudflared'
}

verify_edge_connector() {
  verify_foundation
  [[ "$(kube get namespace "$EDGE_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/deployment-gate}')" == connector-only ]] \
    || fail 'gate do edge não está connector-only'
  pass 'conector Cloudflare DRE está isolado e disponível'
}

namespaced_secret_key_set() {
  local namespace="$1" secret="$2"
  kube -n "$namespace" get secret "$secret" -o json \
    | jq -r '.data | keys | sort | join(",")'
}

secret_key_set() {
  namespaced_secret_key_set "$NAMESPACE" "$1"
}

verify_secret_inventory() {
  local secret
  for secret in "${REQUIRED_SECRETS[@]}"; do
    kube -n "$NAMESPACE" get secret "$secret" -o name >/dev/null \
      || fail "Secret obrigatório ausente: ${secret}"
  done
  [[ "$(secret_key_set dre-registry-pull)" == '.dockerconfigjson' ]] \
    || fail 'chaves do pull secret divergem'
  [[ "$(secret_key_set dre-postgres-admin)" == 'database-url,password' ]] \
    || fail 'chaves do Secret administrativo divergem'
  [[ "$(secret_key_set dre-database-access)" == 'api-password,api-url,backup-password,worker-password,worker-url' ]] \
    || fail 'chaves de acesso ao banco divergem'
  [[ "$(secret_key_set dre-api-runtime)" == 'web-bridge-token' ]] \
    || fail 'chaves do runtime API divergem'
  [[ "$(secret_key_set dre-backup-runtime)" == 'cipher-pass,s3-key,s3-key-secret' ]] \
    || fail 'chaves do backup divergem'
}

verify_release_secret_inventory() {
  local release_id="$1" fcm_expected
  verify_secret_inventory
  fcm_expected="$(jq -r '.fcm_enabled' "$(release_file "$release_id" release.json)")"
  if [[ "$fcm_expected" == true ]]; then
    kube -n "$NAMESPACE" get secret dre-fcm-runtime -o name >/dev/null \
      || fail 'release exige Secret FCM'
    [[ "$(secret_key_set dre-fcm-runtime)" == 'service-account.json' ]] \
      || fail 'chaves do Secret FCM divergem'
  elif [[ "$fcm_expected" == false ]]; then
    if kube -n "$NAMESPACE" get secret dre-fcm-runtime -o name >/dev/null 2>&1; then
      fail 'Secret FCM existe para release com FCM desabilitado'
    fi
  else
    fail 'contrato FCM inválido na release'
  fi
}

secret_inventory_fingerprint() {
  local secret temporary
  temporary="$(mktemp)"
  trap 'rm -f -- "$temporary"' RETURN
  for secret in "${REQUIRED_SECRETS[@]}" dre-fcm-runtime; do
    if kube -n "$NAMESPACE" get secret "$secret" -o json >"${temporary}.json" 2>/dev/null; then
      jq -cS '{name:.metadata.name,uid:.metadata.uid,resourceVersion:.metadata.resourceVersion,type,keys:(.data|keys|sort)}' \
        "${temporary}.json" >>"$temporary"
    fi
  done
  sha256sum "$temporary" | cut -d' ' -f1
  rm -f -- "$temporary" "${temporary}.json"
  trap - RETURN
}

capacity_values() {
  local memory_available disk_available cpu_count node_ready
  memory_available="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
  disk_available="$(df -Pk /var/lib/rancher/k3s/storage | awk 'NR == 2 {print $4}')"
  cpu_count="$(nproc)"
  node_ready="$(kube get nodes -o json | jq '[.items[]|select(any(.status.conditions[]; .type == "Ready" and .status == "True"))]|length')"
  [[ "$memory_available" =~ ^[0-9]+$ ]] || fail 'MemAvailable inválido'
  [[ "$disk_available" =~ ^[0-9]+$ ]] || fail 'capacidade de disco inválida'
  [[ "$cpu_count" =~ ^[0-9]+$ ]] || fail 'contagem de CPU inválida'
  [[ "$node_ready" == 1 ]] || fail 'cluster deve possuir exatamente um nó Ready'
  ((memory_available >= MIN_AVAILABLE_MEMORY_KIB)) \
    || fail 'menos de 5 GiB de memória disponível; capacidade DRE recusada'
  ((disk_available >= MIN_AVAILABLE_DISK_KIB)) \
    || fail 'menos de 45 GiB livres no armazenamento K3s; capacidade DRE recusada'
  ((cpu_count >= 4)) || fail 'nó possui menos de quatro CPUs lógicas'
  printf '%s %s %s\n' "$memory_available" "$disk_available" "$cpu_count"
}

verify_cached_release_again() {
  local release_id="$1" directory archive_sha temporary
  directory="$(release_directory "$release_id")"
  archive_sha="$(release_archive_sha "$release_id")"
  [[ "$(sha256sum "${directory}/release.tar.gz" | cut -d' ' -f1)" == "$archive_sha" ]] \
    || fail 'archive no cache divergiu do recibo'
  openssl pkeyutl -verify -pubin -inkey "$TRUST_KEY" -rawin \
    -in "${directory}/release.tar.gz" -sigfile "${directory}/release.tar.gz.sig" \
    >/dev/null 2>&1 || fail 'assinatura da release no cache divergiu'
  temporary="$(mktemp -d "${STATE_ROOT}/.verify.${release_id}.XXXXXX")"
  if ! python3 "$VERIFIER" "${directory}/release.tar.gz" "$temporary" \
    "$release_id" "$archive_sha" >/dev/null; then
    rm -rf -- "$temporary"
    fail 'release no cache não passou na reverificação'
  fi
  diff -qr -- "$temporary" "${directory}/extracted" >/dev/null \
    || { rm -rf -- "$temporary"; fail 'conteúdo extraído no cache divergiu'; }
  rm -rf -- "$temporary"
}

import_release() {
  [[ "$#" -eq 3 ]] || fail 'uso: import-release RELEASE_ID ARCHIVE_SHA256 SIGNATURE_SHA256'
  local release_id="$1" archive_sha="$2" signature_sha="$3"
  local inbox archive signature temporary cache receipt
  require_release_id "$release_id"
  require_sha256 "$archive_sha"
  require_sha256 "$signature_sha"
  verify_foundation allow-failed-first-deploy
  acquire_controller_lock
  inbox="${RELEASE_INBOX}/${release_id}"
  archive="${inbox}/release.tar.gz"
  signature="${inbox}/release.tar.gz.sig"
  [[ -d "$inbox" && ! -L "$inbox" ]] || fail 'inbox da release ausente'
  [[ "$(file_owner "$inbox")" == 'apiadmin:apiadmin' && "$(file_mode "$inbox")" == 700 ]] \
    || fail 'inbox deve pertencer a apiadmin:apiadmin e usar 0700'
  for source in "$archive" "$signature"; do
    [[ -f "$source" && ! -L "$source" ]] || fail 'artefato do inbox ausente ou simbólico'
    [[ "$(file_owner "$source")" == 'apiadmin:apiadmin' ]] \
      || fail 'artefato do inbox não pertence a apiadmin'
    [[ "$(file_mode "$source")" =~ ^(400|600)$ ]] || fail 'modo inseguro no inbox'
  done
  [[ "$(sha256sum "$archive" | cut -d' ' -f1)" == "$archive_sha" ]] \
    || fail 'SHA-256 do archive no inbox diverge'
  [[ "$(sha256sum "$signature" | cut -d' ' -f1)" == "$signature_sha" ]] \
    || fail 'SHA-256 da assinatura no inbox diverge'
  temporary="$(mktemp -d "${STATE_ROOT}/.import.${release_id}.XXXXXX")"
  trap 'rm -rf -- "$temporary"' RETURN
  install -m 0600 -o root -g root "$archive" "${temporary}/release.tar.gz"
  install -m 0600 -o root -g root "$signature" "${temporary}/release.tar.gz.sig"
  [[ "$(sha256sum "${temporary}/release.tar.gz" | cut -d' ' -f1)" == "$archive_sha" ]] \
    || fail 'cópia root-owned do archive diverge'
  [[ "$(sha256sum "$archive" | cut -d' ' -f1)" == "$archive_sha" ]] \
    || fail 'archive mudou durante a importação'
  openssl pkeyutl -verify -pubin -inkey "$TRUST_KEY" -rawin \
    -in "${temporary}/release.tar.gz" -sigfile "${temporary}/release.tar.gz.sig" \
    >/dev/null 2>&1 || fail 'assinatura Ed25519 da release foi recusada'
  mkdir -m 0700 "${temporary}/extracted"
  python3 "$VERIFIER" "${temporary}/release.tar.gz" "${temporary}/extracted" \
    "$release_id" "$archive_sha" >/dev/null
  promtool check rules "${temporary}/extracted/monitoring/alerts-k3s.yml" >/dev/null
  cache="$(release_directory "$release_id")"
  if [[ -e "$cache" ]]; then
    require_cached_release "$release_id"
    [[ "$(release_archive_sha "$release_id")" == "$archive_sha" ]] \
      || fail 'release ID já existe com outro archive'
    rm -rf -- "$temporary"
    trap - RETURN
    pass "release ${release_id} já estava importada com o mesmo digest"
    return
  fi
  receipt="${temporary}/receipt.json"
  jq -cn \
    --arg release_id "$release_id" \
    --arg archive_sha256 "$archive_sha" \
    --arg signature_sha256 "$signature_sha" \
    --arg imported_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,release_id:$release_id,archive_sha256:$archive_sha256,signature_sha256:$signature_sha256,imported_at_utc:$imported_at_utc}' \
    | atomic_write "$receipt" 0600
  chmod -R go-rwx "$temporary"
  chown -R root:root "$temporary"
  mv -T -- "$temporary" "$cache"
  trap - RETURN
  audit_event import-release passed "$release_id"
  pass "release ${release_id} assinada, verificada e armazenada no cache fechado"
}

create_secret() {
  local namespace="$1" name="$2" type="$3" directory="$4"
  local -a arguments=(create secret generic "$name" --namespace "$namespace")
  local file
  if [[ "$type" != opaque ]]; then
    arguments+=(--type "$type")
  fi
  while IFS= read -r -d '' file; do
    arguments+=(--from-file="$(basename "$file")=${file}")
  done < <(find "$directory" -maxdepth 1 -type f -print0 | sort -z)
  (umask 077; kube "${arguments[@]}" --dry-run=client -o yaml \
    | kube apply --server-side --field-manager=dre-deployctl -f - >/dev/null)
  kube -n "$namespace" label secret "$name" \
    app.kubernetes.io/part-of=dre-familiar \
    app.kubernetes.io/managed-by=dre-deployctl --overwrite >/dev/null
}

initialize_secrets() {
  [[ "$#" -eq 1 ]] || fail 'uso: initialize-secrets RELEASE_ID (JSON protegido por stdin)'
  local release_id="$1" temporary rust_image postgres_image fcm_expected fcm_project_id created=false
  require_cached_release "$release_id"
  verify_foundation
  acquire_controller_lock
  for secret in "${REQUIRED_SECRETS[@]}" dre-fcm-runtime; do
    if kube -n "$NAMESPACE" get secret "$secret" >/dev/null 2>&1; then
      fail 'inicialização recusada: já existe Secret DRE; rotação exige operação futura própria'
    fi
  done
  rust_image="$(release_rust_image "$release_id")"
  postgres_image="$(release_postgres_image "$release_id")"
  fcm_expected="$(jq -r '.fcm_enabled' "$(release_file "$release_id" release.json)")"
  fcm_project_id="$(jq -r '.fcm_project_id' "$(release_file "$release_id" release.json)")"
  temporary="$(mktemp -d /run/dre-secrets.XXXXXX)"
  trap 'rm -rf -- "$temporary"' RETURN
  python3 "$SECRET_MATERIAL" "$temporary" "$rust_image" "$postgres_image" "$fcm_project_id"
  if [[ "$fcm_expected" == true && ! -f "${temporary}/fcm-runtime/service-account.json" ]]; then
    fail 'release exige FCM, mas a credencial não foi fornecida'
  fi
  if [[ "$fcm_expected" == false && -d "${temporary}/fcm-runtime" ]]; then
    fail 'credencial FCM fornecida para release com FCM desabilitado'
  fi
  rollback_secret_creation() {
    local code="$1" release_id="$2" temporary="$3" created="$4"
    set +e
    if [[ "$created" == true ]]; then
      kube -n "$NAMESPACE" delete secret \
        "${REQUIRED_SECRETS[@]}" dre-fcm-runtime --ignore-not-found >/dev/null 2>&1 || true
    fi
    rm -rf -- "$temporary"
    audit_event initialize-secrets failed "$release_id"
    exit "$code"
  }
  register_exit_trap rollback_secret_creation "$release_id" "$temporary" false
  created=true
  register_exit_trap rollback_secret_creation "$release_id" "$temporary" "$created"
  create_secret "$NAMESPACE" dre-registry-pull kubernetes.io/dockerconfigjson "${temporary}/registry"
  create_secret "$NAMESPACE" dre-postgres-admin opaque "${temporary}/postgres-admin"
  create_secret "$NAMESPACE" dre-database-access opaque "${temporary}/database-access"
  create_secret "$NAMESPACE" dre-api-runtime opaque "${temporary}/api-runtime"
  create_secret "$NAMESPACE" dre-backup-runtime opaque "${temporary}/backup-runtime"
  if [[ -d "${temporary}/fcm-runtime" ]]; then
    create_secret "$NAMESPACE" dre-fcm-runtime opaque "${temporary}/fcm-runtime"
  fi
  verify_release_secret_inventory "$release_id"
  kube label namespace "$NAMESPACE" \
    platform.servidor.local/deployment-gate=secrets-only --overwrite >/dev/null
  trap - EXIT
  rm -rf -- "$temporary"
  trap - RETURN
  audit_event initialize-secrets passed "$release_id"
  pass 'Secrets DRE criados sem exibir valores; rotação automática permaneceu proibida'
}

latest_validation_receipt() {
  local release_id="$1" archive_sha receipt
  archive_sha="$(release_archive_sha "$release_id")"
  while IFS= read -r receipt; do
    if jq -e --arg release "$release_id" --arg archive "$archive_sha" \
      '.schema == 2 and .status == "passed" and .release_id == $release and .archive_sha256 == $archive and .namespace == "dre-validation" and .cleaned == true and .migrations == 9 and .restarts == ["api","worker","postgres"]' \
      "$receipt" >/dev/null 2>&1; then
      printf '%s\n' "$receipt"
    fi
  done < <(find "$RECEIPT_ROOT" -mindepth 1 -maxdepth 1 -type f \
    -name 'validation-*.json' -print | sort)
}

require_validation_receipt() {
  local release_id="$1" receipt
  receipt="$(latest_validation_receipt "$release_id" | tail -n 1)"
  [[ -n "$receipt" ]] || fail 'release ainda não possui validação descartável aprovada'
  require_root_file "$receipt" '^600$'
  printf '%s' "$receipt"
}

create_validation_namespace() {
  local release_id="$1" operation_id="$2"
  [[ -z "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o name 2>/dev/null)" ]] \
    || fail 'namespace dre-validation já existe; limpeza explícita é obrigatória'
  admin_kube create namespace "$VALIDATION_NAMESPACE" >/dev/null
  admin_kube label namespace "$VALIDATION_NAMESPACE" \
    app.kubernetes.io/name=dre-familiar-validation \
    app.kubernetes.io/part-of=dre-familiar \
    platform.servidor.local/project=dre \
    platform.servidor.local/deployment-gate=running \
    dre.familiar/lifecycle=disposable \
    dre.familiar/release-id="$release_id" \
    dre.familiar/operation-id="$operation_id" \
    pod-security.kubernetes.io/audit=restricted \
    pod-security.kubernetes.io/audit-version=v1.36 \
    pod-security.kubernetes.io/enforce=restricted \
    pod-security.kubernetes.io/enforce-version=v1.36 \
    pod-security.kubernetes.io/warn=restricted \
    pod-security.kubernetes.io/warn-version=v1.36 \
    --overwrite >/dev/null
  admin_kube apply --server-side --field-manager=dre-controller-bootstrap \
    -f "$VALIDATION_ACCESS" >/dev/null
  kube auth can-i create jobs.batch --namespace "$VALIDATION_NAMESPACE" \
    | grep -Fx yes >/dev/null || fail 'identidade DRE não recebeu o RBAC de validação'
}

create_validation_secrets() {
  local release_id="$1" temporary docker_config
  temporary="$(mktemp -d /run/dre-validation-secrets.XXXXXX)"
  trap 'rm -rf -- "$temporary"' RETURN
  docker_config="${temporary}/registry-source.json"
  kube -n "$NAMESPACE" get secret dre-registry-pull \
    -o jsonpath='{.data.\.dockerconfigjson}' \
    | base64 --decode >"$docker_config"
  chmod 0600 "$docker_config"
  mkdir -m 0700 "${temporary}/material"
  python3 "$VALIDATION_MATERIAL" "${temporary}/material" "$docker_config" \
    "$(release_rust_image "$release_id")" \
    "$(release_postgres_image "$release_id")" \
    "$(release_validation_image "$release_id")" >/dev/null
  create_secret "$VALIDATION_NAMESPACE" dre-registry-pull \
    kubernetes.io/dockerconfigjson "${temporary}/material/registry"
  create_secret "$VALIDATION_NAMESPACE" dre-postgres-admin opaque \
    "${temporary}/material/postgres-admin"
  create_secret "$VALIDATION_NAMESPACE" dre-database-access opaque \
    "${temporary}/material/database-access"
  create_secret "$VALIDATION_NAMESPACE" dre-api-runtime opaque \
    "${temporary}/material/api-runtime"
  create_secret "$VALIDATION_NAMESPACE" dre-backup-runtime opaque \
    "${temporary}/material/backup-runtime"
  create_secret "$VALIDATION_NAMESPACE" dre-validation-accounts opaque \
    "${temporary}/material/validation-accounts"
  [[ "$(namespaced_secret_key_set "$VALIDATION_NAMESPACE" dre-registry-pull)" == '.dockerconfigjson' \
    && "$(namespaced_secret_key_set "$VALIDATION_NAMESPACE" dre-postgres-admin)" == 'database-url,password' \
    && "$(namespaced_secret_key_set "$VALIDATION_NAMESPACE" dre-database-access)" == 'api-password,api-url,backup-password,worker-password,worker-url' \
    && "$(namespaced_secret_key_set "$VALIDATION_NAMESPACE" dre-api-runtime)" == 'web-bridge-token' \
    && "$(namespaced_secret_key_set "$VALIDATION_NAMESPACE" dre-backup-runtime)" == 'cipher-pass,s3-key,s3-key-secret' \
    && "$(namespaced_secret_key_set "$VALIDATION_NAMESPACE" dre-validation-accounts)" == 'primary-password,secondary-password' ]] \
    || fail 'inventário de Secrets sintéticos diverge'
  rm -rf -- "$temporary"
  trap - RETURN
}

validation_cleanup_internal() {
  local release_id="$1" pv_name='' deadline
  if ! admin_kube get namespace "$VALIDATION_NAMESPACE" >/dev/null 2>&1; then
    return 0
  fi
  [[ "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.platform\.servidor\.local/project}')" == dre \
    && "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.dre\.familiar/lifecycle}')" == disposable \
    && "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o jsonpath='{.metadata.labels.dre\.familiar/release-id}')" == "$release_id" ]] \
    || fail 'limpeza recusada: namespace não pertence à validação descartável DRE'
  pv_name="$(admin_kube -n "$VALIDATION_NAMESPACE" get pvc dre-postgres-data \
    -o jsonpath='{.spec.volumeName}' 2>/dev/null || true)"
  admin_kube delete namespace "$VALIDATION_NAMESPACE" --wait=true --timeout=300s >/dev/null
  if [[ -n "$pv_name" ]]; then
    deadline=$((SECONDS + 180))
    while admin_kube get pv "$pv_name" >/dev/null 2>&1; do
      ((SECONDS < deadline)) || fail 'PV da validação descartável não foi removido'
      sleep 2
    done
  fi
}

validation_migration_count() {
  kube -n "$VALIDATION_NAMESPACE" exec dre-postgres-0 -- \
    psql --no-psqlrc --tuples-only --no-align -h /var/run/postgresql \
    -U dre_postgres_admin -d dre \
    --command='SELECT count(*) FROM _sqlx_migrations WHERE success'
}

verify_validation_runtime() {
  local release_id="$1" migration_count containers
  kube -n "$VALIDATION_NAMESPACE" rollout status statefulset/dre-postgres \
    --timeout=300s >/dev/null
  kube -n "$VALIDATION_NAMESPACE" rollout status deployment/dre-api \
    --timeout=240s >/dev/null
  kube -n "$VALIDATION_NAMESPACE" rollout status deployment/dre-worker \
    --timeout=240s >/dev/null
  [[ "$(kube -n "$VALIDATION_NAMESPACE" get statefulset dre-postgres -o jsonpath='{.spec.template.spec.containers[0].image}')" == "$(release_postgres_image "$release_id")" \
    && "$(kube -n "$VALIDATION_NAMESPACE" get deployment dre-api -o jsonpath='{.spec.template.spec.containers[0].image}')" == "$(release_rust_image "$release_id")" \
    && "$(kube -n "$VALIDATION_NAMESPACE" get deployment dre-worker -o jsonpath='{.spec.template.spec.containers[0].image}')" == "$(release_rust_image "$release_id")" ]] \
    || fail 'digests do runtime de validação divergem'
  containers="$({
    kube -n "$VALIDATION_NAMESPACE" get deployment dre-api -o jsonpath='{range .spec.template.spec.containers[*]}{.name}{"\n"}{end}'
    kube -n "$VALIDATION_NAMESPACE" get deployment dre-worker -o jsonpath='{range .spec.template.spec.containers[*]}{.name}{"\n"}{end}'
    kube -n "$VALIDATION_NAMESPACE" get statefulset dre-postgres -o jsonpath='{range .spec.template.spec.containers[*]}{.name}{"\n"}{end}'
  } | sort)"
  [[ "$containers" == $'api\npostgres\nworker' ]] \
    || fail 'runtime da validação não possui exatamente api, postgres e worker'
  kube -n "$VALIDATION_NAMESPACE" get service -o json \
    | jq -e 'all(.items[]; (.spec.type // "ClusterIP") == "ClusterIP" and ((.spec.externalIPs // []) | length == 0) and all(.spec.ports[]; has("nodePort") | not))' \
    >/dev/null || fail 'Service da validação possui exposição proibida'
  [[ "$(kube -n "$VALIDATION_NAMESPACE" get pvc dre-postgres-data -o jsonpath='{.status.phase}')" == Bound ]] \
    || fail 'PVC da validação não está Bound'
  migration_count="$(validation_migration_count)"
  [[ "${migration_count//[[:space:]]/}" == "$(release_migration_count "$release_id")" ]] \
    || fail 'PostgreSQL descartável não confirmou nove migrations'
  kube get --raw "/api/v1/namespaces/${VALIDATION_NAMESPACE}/services/http:dre-api:8080/proxy/health/ready" \
    >/dev/null || fail 'readiness da API descartável falhou'
}

restart_validation_component() {
  local component="$1" selector pod_name before_uid after_uid
  case "$component" in
    api) selector='app.kubernetes.io/name=dre-api';;
    worker) selector='app.kubernetes.io/name=dre-worker';;
    postgres) selector='app.kubernetes.io/name=dre-postgres';;
    *) fail 'componente de restart inválido';;
  esac
  pod_name="$(kube -n "$VALIDATION_NAMESPACE" get pods -l "$selector" -o json \
    | jq -er 'if (.items | length) == 1 then .items[0].metadata.name else error("pod count") end')" \
    || fail "quantidade de pods inválida antes do restart de ${component}"
  before_uid="$(kube -n "$VALIDATION_NAMESPACE" get pod "$pod_name" -o jsonpath='{.metadata.uid}')"
  kube -n "$VALIDATION_NAMESPACE" delete pod "$pod_name" --wait=true --timeout=180s >/dev/null
  if [[ "$component" == postgres ]]; then
    kube -n "$VALIDATION_NAMESPACE" rollout status statefulset/dre-postgres --timeout=300s >/dev/null
  else
    kube -n "$VALIDATION_NAMESPACE" rollout status "deployment/dre-${component}" --timeout=240s >/dev/null
  fi
  after_uid="$(kube -n "$VALIDATION_NAMESPACE" get pods -l "$selector" -o json \
    | jq -er 'if (.items | length) == 1 then .items[0].metadata.uid else error("pod count") end')" \
    || fail "quantidade de pods inválida depois do restart de ${component}"
  [[ "$before_uid" != "$after_uid" ]] || fail "pod de ${component} não foi substituído"
}

wait_for_job_completion() {
  local namespace="$1" job="$2" timeout_seconds="$3" deadline state reason
  [[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || fail 'timeout interno de Job inválido'
  deadline=$((SECONDS + timeout_seconds))
  while true; do
    state="$(kube -n "$namespace" get job "$job" -o json)"
    if jq -e 'any(.status.conditions[]?; .type == "Complete" and .status == "True")' \
        <<<"$state" >/dev/null; then
      return
    fi
    if jq -e 'any(.status.conditions[]?; .type == "Failed" and .status == "True")' \
        <<<"$state" >/dev/null; then
      reason="$(jq -r \
        '[.status.conditions[]? | select(.type == "Failed" and .status == "True") | .reason] | first // "Unknown"' \
        <<<"$state")"
      fail "Job ${job} falhou: ${reason}"
    fi
    ((SECONDS < deadline)) || fail "Job ${job} excedeu ${timeout_seconds}s"
    sleep 2
  done
}

validate_release_disposable() {
  [[ "$#" -eq 2 ]] || fail 'uso: validate-release RELEASE_ID OPERATION_ID'
  local release_id="$1" operation_id="$2" protected_before phase=preflight
  local receipt migration_count
  require_cached_release "$release_id"
  require_schema_two_release "$release_id"
  require_operation_id "$operation_id"
  require_new_receipt validation "$operation_id"
  verify_cached_release_again "$release_id"
  verify_foundation allow-failed-first-deploy
  verify_release_secret_inventory "$release_id"
  verify_protected_projects
  acquire_controller_lock
  acquire_shared_maintenance_locks
  capacity_values >/dev/null
  [[ -z "$(admin_kube get namespace "$VALIDATION_NAMESPACE" -o name 2>/dev/null)" ]] \
    || fail 'validação anterior ainda existe; use cleanup-validation após o diagnóstico'
  protected_before="$(protected_fingerprint)"
  receipt="${RECEIPT_ROOT}/validation-${operation_id}.json"
  jq -cn \
    --arg release_id "$release_id" \
    --arg archive_sha256 "$(release_archive_sha "$release_id")" \
    --arg operation_id "$operation_id" \
    --arg started_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:2,status:"started",release_id:$release_id,archive_sha256:$archive_sha256,operation_id:$operation_id,namespace:"dre-validation",started_at_utc:$started_at_utc}' \
    | atomic_write "$receipt" 0600
  validation_failed() {
    local code="$1" release_id="$2" operation_id="$3" receipt="$4" phase="$5"
    local preserved=false
    set +e
    if admin_kube get namespace "$VALIDATION_NAMESPACE" >/dev/null 2>&1; then
      preserved=true
      admin_kube label namespace "$VALIDATION_NAMESPACE" \
        platform.servidor.local/deployment-gate=blocked --overwrite >/dev/null 2>&1 || true
    fi
    jq -cn \
      --arg release_id "$release_id" \
      --arg archive_sha256 "$(release_archive_sha "$release_id")" \
      --arg operation_id "$operation_id" \
      --arg phase "$phase" \
      --argjson preserved "$preserved" \
      --arg failed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      '{schema:2,status:"failed",release_id:$release_id,archive_sha256:$archive_sha256,operation_id:$operation_id,namespace:"dre-validation",phase:$phase,preserved:$preserved,failed_at_utc:$failed_at_utc}' \
      | atomic_write "$receipt" 0600 || true
    audit_event validate-release failed "$release_id" "$operation_id"
    exit "$code"
  }
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"

  phase=namespace
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  create_validation_namespace "$release_id" "$operation_id"
  create_validation_secrets "$release_id"
  phase=platform
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  kube apply --server-side --field-manager=dre-deployctl \
    -f "$(release_file "$release_id" 40-validation-platform.yaml)" >/dev/null
  kube -n "$VALIDATION_NAMESPACE" rollout status statefulset/dre-postgres \
    --timeout=300s >/dev/null

  phase=migrations
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  kube -n "$VALIDATION_NAMESPACE" delete job dre-database-migrate \
    --ignore-not-found --wait=true >/dev/null
  kube apply --server-side --field-manager=dre-deployctl \
    -f "$(release_file "$release_id" 41-validation-migrations.yaml)" >/dev/null
  wait_for_job_completion "$VALIDATION_NAMESPACE" dre-database-migrate 660
  migration_count="$(validation_migration_count)"
  [[ "${migration_count//[[:space:]]/}" == 9 ]] \
    || fail 'Job de migration descartável não confirmou nove migrations'

  phase=database-access
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  kube -n "$VALIDATION_NAMESPACE" delete job dre-database-access \
    --ignore-not-found --wait=true >/dev/null
  kube apply --server-side --field-manager=dre-deployctl \
    -f "$(release_file "$release_id" 42-validation-database-access.yaml)" >/dev/null
  wait_for_job_completion "$VALIDATION_NAMESPACE" dre-database-access 360

  phase=runtime
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  kube apply --server-side --field-manager=dre-deployctl \
    -f "$(release_file "$release_id" 43-validation-runtime.yaml)" >/dev/null
  verify_validation_runtime "$release_id"

  phase=bootstrap
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  kube -n "$VALIDATION_NAMESPACE" delete job dre-validation-bootstrap \
    --ignore-not-found --wait=true >/dev/null
  kube apply --server-side --field-manager=dre-deployctl \
    -f "$(release_file "$release_id" 44-validation-bootstrap.yaml)" >/dev/null
  wait_for_job_completion "$VALIDATION_NAMESPACE" dre-validation-bootstrap 660

  phase=e2e
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  kube -n "$VALIDATION_NAMESPACE" delete job dre-validation-e2e \
    --ignore-not-found --wait=true >/dev/null
  kube apply --server-side --field-manager=dre-deployctl \
    -f "$(release_file "$release_id" 45-validation-e2e.yaml)" >/dev/null
  [[ "$(kube -n "$VALIDATION_NAMESPACE" get job dre-validation-e2e -o jsonpath='{.spec.template.spec.containers[0].image}')" == "$(release_validation_image "$release_id")" ]] \
    || fail 'Job E2E não usa a imagem de validação assinada'
  wait_for_job_completion "$VALIDATION_NAMESPACE" dre-validation-e2e 960

  phase=restarts
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  restart_validation_component api
  verify_validation_runtime "$release_id"
  restart_validation_component worker
  verify_validation_runtime "$release_id"
  restart_validation_component postgres
  verify_validation_runtime "$release_id"
  [[ "$(protected_fingerprint)" == "$protected_before" ]] \
    || fail 'recurso protegido mudou durante a validação DRE'
  release_shared_maintenance_locks
  verify_protected_projects

  phase=cleanup
  register_exit_trap validation_failed "$release_id" "$operation_id" "$receipt" "$phase"
  admin_kube label namespace "$VALIDATION_NAMESPACE" \
    platform.servidor.local/deployment-gate=passed --overwrite >/dev/null
  validation_cleanup_internal "$release_id"
  jq -cn \
    --arg release_id "$release_id" \
    --arg archive_sha256 "$(release_archive_sha "$release_id")" \
    --arg operation_id "$operation_id" \
    --arg rust_image "$(release_rust_image "$release_id")" \
    --arg postgres_image "$(release_postgres_image "$release_id")" \
    --arg validation_image "$(release_validation_image "$release_id")" \
    --arg completed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:2,status:"passed",release_id:$release_id,archive_sha256:$archive_sha256,operation_id:$operation_id,namespace:"dre-validation",migrations:9,jobs:["migration","database-access","bootstrap","e2e"],restarts:["api","worker","postgres"],images:{rust:$rust_image,postgres:$postgres_image,validation:$validation_image},cleaned:true,completed_at_utc:$completed_at_utc}' \
    | atomic_write "$receipt" 0600
  trap - EXIT
  audit_event validate-release passed "$release_id" "$operation_id"
  pass "release ${release_id} validada em dre-validation e removida com seu PVC/PV"
}

