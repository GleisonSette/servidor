  printf '%s\n' "$release_id" | atomic_write "$CURRENT_RELEASE" 0600
  jq -cn \
    --arg release_id "$release_id" \
    --arg operation_id "$operation_id" \
    --arg previous_release "$previous" \
    --arg backup_operation_id "$backup_operation_id" \
    --arg backup_receipt_sha256 "$backup_receipt_sha" \
    --arg old_postgres_image "$old_image" \
    --arg new_postgres_image "$new_image" \
    --arg completed_at_utc "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema:1,status:"passed",release_id:$release_id,operation_id:$operation_id,previous_release:$previous_release,backup_operation_id:$backup_operation_id,backup_receipt_sha256:$backup_receipt_sha256,old_postgres_image:$old_postgres_image,new_postgres_image:$new_postgres_image,rollback:"not-required",completed_at_utc:$completed_at_utc}' \
    | atomic_write "${RECEIPT_ROOT}/postgres-upgrade-${operation_id}.json" 0600
  trap - EXIT
  rm -f -- "$alert_backup"
  audit_event upgrade-postgres passed "$release_id" "$operation_id"
  pass "release ${release_id} ativada após upgrade PostgreSQL com backup vinculado"
}

