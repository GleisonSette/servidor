Defaults!/usr/local/sbin/blindou-hostctl env_reset
Cmnd_Alias BLINDOU_HOST_AUTOMATION = /usr/local/sbin/blindou-hostctl status, /usr/local/sbin/blindou-hostctl verify, /usr/local/sbin/blindou-hostctl apply-firewall blindou-temporary-host-containment
apiadmin ALL=(root) NOPASSWD: BLINDOU_HOST_AUTOMATION
