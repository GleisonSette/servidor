[Unit]
Description=Coleta de saúde da plataforma Blindou para Node Exporter
After=k3s.service postgresql@18-main.service
Requires=k3s.service postgresql@18-main.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/blindou-platform-metrics
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/prometheus/node-exporter /run/lock
UMask=0027
